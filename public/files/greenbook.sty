%% ----------------------------------------------------------------------
%%  9. Grid table of contents  (toc = grid; the design of artbook.sty)
%%
%%    PART TITLE (large, accent) ......................... TABLE OF CONTENTS
%%    ------------------------------------------------------------------------
%%                   | 1  CHAPTER TITLE | SECTION 1A                    |  2
%%                   |                  | Title of the section          |
%%    ------------------------------------------------------------------------
%%  Three vertical lines: the chapter column, the main divider (between
%%  chapters and sections) and the page column.  Only the main divider
%%  breaks the horizontal rules.  The grid spans the text and the margin
%%  (key `tocwidth').  A chapter without sections gets a row of its own.
%%  Subsections are not listed.
%% ----------------------------------------------------------------------
\newlength\gb@tocw     \newlength\gb@split    \newlength\gb@subsplit  \newlength\gb@pagew
\newlength\gb@pad      \newlength\gb@chpad     \newlength\gb@rule
\newlength\gb@toppad   \newlength\gb@botpad    \newlength\gb@plainpad
\newlength\gb@titlew   \newlength\gb@gap       \newlength\gb@pdx
\newdimen\gb@pos  \newdimen\gb@cur  \newdimen\gb@cutl  \newdimen\gb@cutr
\newdimen\gb@ruleleft
\newif\ifgb@sub        % the current part has chapters: draw the chapter column
\newif\ifgb@first      % first row of the contents: print the label
\newif\ifgb@hasnum     % the current row has a number line
\newif\ifgb@keep       % previous row opened a part: no page break after it
\newif\ifgb@chappend   % a chapter whose row has not been printed yet
\newbox\gb@titlebox \newbox\gb@pagebox
\newbox\gb@partbox \newbox\gb@rowbox
\newdimen\gb@sincepart % height of the rows since the last part title
\newdimen\gb@partbelow % how far that title reaches below its rule
\newif\ifgb@lastsub    % the last row drew the chapter column
\newcount\gb@partno    % parts met in the contents
\let\gb@part\@empty \let\gb@chap\@empty \let\gb@chappage\@empty

% the title of the document, for the foot of the contents (expandable)
\providecommand*\thetitle{}
\let\gb@titletext\@empty
\AtBeginDocument{\begingroup
  \let\thanks\@gobble \def\\{ }\let\newline\\%
  \protected@xdef\gb@titletext{\thetitle}\endgroup}
\newcommand*\gb@doctitle{\ifx\gb@titletext\@empty\jobname\else\gb@titletext\fi}

\newcommand*\gb@toclabelfont{\gb@font@toclabel}
\newcommand*\gb@tocpartfont{\gb@font@tocpart}
\newcommand*\gb@toctitlefont{\gb@font@toctitle}
\newcommand*\gb@tocpagefont{\gb@font@tocpage\color{gbaccent}}
\newcommand*\gb@toclabel[1]{{\gb@toclabelfont\MakeUppercase{#1}}}

\newcommand*\gb@tocsetlengths{%
  \global\gb@tocw     =\dimexpr\gb@opt@tocwidth\relax
  \global\gb@split    =\gb@opt@split\relax
  \global\gb@subsplit =\gb@opt@subsplit\relax
  \global\gb@pagew    =\gb@opt@pagewidth\relax
  \global\gb@pad      =\gb@opt@pad\relax
  \global\gb@chpad    =\gb@opt@chpad\relax
  \global\gb@rule     =\gb@opt@rule\relax
  \global\gb@toppad   =\gb@opt@toppad\relax
  \global\gb@botpad   =\gb@opt@botpad\relax
  \global\gb@plainpad =\gb@opt@plainpad\relax
  \global\gb@gap      =\gb@opt@rulegap\relax
  \global\gb@titlew   =\dimexpr\gb@tocw-\gb@split-3\gb@pad-\gb@rule-\gb@pagew\relax
  \global\gb@pdx      =\dimexpr\gb@split+2\gb@pad+\gb@titlew\relax}

\newcommand*\gb@hbar[1]{\vrule width#1 height\gb@rule depth\z@}
\newcommand*\gb@vbar{\vrule width\gb@rule}
\newcommand*\gb@strut[2]{\vrule width\z@ height#1 depth#2\relax}

% A rule from x=#2 to x=#3 in an \hbox of width #1, with a white gap on both
% sides of each vertical line in the list #4 (each \gb@rule wide).
\def\gb@dseg#1#2{%
  \ifdim#2>#1\relax
    \hskip\dimexpr#1-\gb@pos\relax
    \gb@hbar{\dimexpr#2-#1\relax}%
    \gb@pos=#2\relax
  \fi}
\newcommand*\gb@gaprule[4]{%
  \hbox to#1{%
    \gb@pos=\z@ \gb@cur=#2\relax
    \@for\gb@v:=#4\do{%
      \gb@cutl=\dimexpr\gb@v-\gb@gap\relax
      \gb@cutr=\dimexpr\gb@v+\gb@rule+\gb@gap\relax
      \ifdim\gb@cutr>\gb@cur\relax
        \ifdim\gb@cutl>#3\relax \gb@dseg{\gb@cur}{#3}%
        \else \gb@dseg{\gb@cur}{\gb@cutl}\fi
        \gb@cur=\gb@cutr\relax
      \fi}%
    \gb@dseg{\gb@cur}{#3}%
    \hfil}}

\newcommand*\gb@nolinks{\let\hyper@linkstart\@gobbletwo \let\hyper@linkend\@empty}
\newcommand*\gb@numlabel[1]{#1\hskip 1mm\relax}

% what the lines of the .toc do inside the grid
\newcommand*\gb@tocentries{%
  \def\l@book##1##2{}%
  \def\l@part##1##2{%
    \gb@flushchap
    \gdef\gb@part{##1}\global\let\gb@chap\@empty \global\let\gb@curchap\@empty
    \global\gb@subfalse
    \global\advance\gb@partno\@ne
    \expandafter\gdef\csname gb@mini@\the\gb@partno\endcsname{}}%
  \def\l@chapter##1##2{%
    \gb@flushchap
    \gdef\gb@chap{##1}\gdef\gb@curchap{##1}\xdef\gb@chappage{\gb@savepage{##2}}%
    \global\gb@chappendtrue \global\gb@subtrue
    \xdef\gb@tmp{\noexpand\gb@miniitem{\unexpanded{##1}}{\gb@savepage{##2}}}%
    \expandafter\g@addto@macro\csname gb@mini@\the\gb@partno\expandafter\endcsname
      \expandafter{\gb@tmp}}%
  \let\l@appendix\l@chapter
  \def\l@section##1##2{\global\gb@chappendfalse \gb@row{##1}{##2}}%
  \def\l@subsection##1##2{}%
  \def\l@subsubsection##1##2{}%
  \def\l@paragraph##1##2{}%
  \def\l@subparagraph##1##2{}}

% A page number from the .toc, kept for later: hyperref's link in it names
% its target by \Hy@tocdestname, which is only set while the line is read.
\def\gb@savepage#1{%
  \ifdefined\Hy@tocdestname
    \noexpand\def\noexpand\Hy@tocdestname{\Hy@tocdestname}\fi
  \unexpanded{#1}}

% A chapter without sections gets a row of its own, as artbook's: its label
% in the chapter column, its title in the title cell, and the chapter
% column runs on below it like that of any other chapter.  Before the first
% part (the front matter) the row has no chapter column: the title of the
% first part hangs in that space.
\newcommand*\gb@flushchap{%
  \ifgb@chappend
    \global\gb@chappendfalse
    \let\gb@tmptitle\gb@chap
    \ifnum\gb@partno=\z@ \global\let\gb@chap\@empty \global\gb@subfalse \fi
    \expandafter\gb@row\expandafter{\gb@tmptitle}{\gb@chappage}%
  \fi}

% the part title hangs above the first row of the part; the first row of
% the contents carries the label on the right
% the title of a part, set in \gb@partbox (its baseline is its last line)
% The title ends before the labels at the right of the space it hangs in:
% the label of the contents above the first rule, and the label of the
% chapter below the rule.  A title that does not fit breaks into lines that
% stack upwards (and \gb@partspace makes room for them).
\RequirePackage{varwidth}
\newcommand*\gb@partreserve{%
  \@tempdima=\z@
  \ifgb@first
    \setbox\z@\hbox{\gb@toclabel{\gb@opt@toclabel}}%
    \@tempdima=\wd\z@
  \fi
  \ifgb@sub\ifx\gb@chap\@empty\else
    % (the label as it is set in its column, broken into lines: as wide as
    % its longest line)
    \@tempdimb=\dimexpr\gb@split-\gb@subsplit-\gb@rule-2\gb@chpad\relax
    \setbox\z@\hbox{\begin{varwidth}{\@tempdimb}%
      \gb@toclabelfont \raggedleft \parindent=\z@
      \let\chapternumberline\gb@numlabel \let\numberline\gb@numlabel \gb@nolinks
      \MakeUppercase{\gb@chap}\end{varwidth}}%
    \@tempdimb=\wd\z@
    % The title stands a little below the rule, the label of the chapter
    % further below it.  The space for the title ends before the label only
    % when the title, set on one line, would touch the label: when it is too
    % long for the line, or when a word over the label reaches down to it.
    \gb@labelclash
    \ifgb@clash
      % (the chapter label ends \gb@chpad before the divider, the contents
      % label \gb@pad before it)
      \advance\@tempdimb\dimexpr\gb@chpad-\gb@pad\relax
      \ifdim\@tempdimb>\@tempdima \@tempdima=\@tempdimb \fi
    \fi
  \fi\fi}
% Does the title of the part, on one line, touch the label of the chapter
% (as wide as \@tempdimb)?  \@tempdima is the space taken by the label of the
% contents, if any.
\newif\ifgb@clash
\ExplSyntaxOn
\seq_new:N \l__gb_partwords_seq
\box_new:N \l__gb_partword_box
\dim_new:N \l__gb_partx_dim
\dim_new:N \l__gb_labelx_dim
\dim_new:N \l__gb_labeltop_dim
\cs_new_protected:Npn \gb@labelclash
  {
    \gb@clashfalse
    \group_begin:
      \gb@tocpartfont
      \cs_set_eq:NN \partnumberline \use_none:n
      \cs_set_eq:NN \numberline \use_none:n
      \gb@nolinks
      % x of the label, from the left end of the title
      \dim_set:Nn \l__gb_labelx_dim
        { \gb@split - \gb@chpad - \@tempdimb + \gb@opt@partextend - \gb@opt@partgap }
      % how far below the rule the capitals of the label begin
      \hbox_set:Nn \l__gb_partword_box { \gb@toclabelfont H }
      \dim_set:Nn \l__gb_labeltop_dim
        { \gb@opt@toppad + \gb@opt@chapshift - \box_ht:N \l__gb_partword_box - 0.5pt }
      % the whole title on one line
      \hbox_set:Nn \l__gb_partword_box { \gb@part }
      \dim_compare:nNnTF
        { \box_wd:N \l__gb_partword_box } >
        { \gb@split - 2\gb@pad - \@tempdima - \gb@opt@partgap + \gb@opt@partextend }
        { \group_insert_after:N \gb@clashtrue }
        {
          \exp_args:NNnV \seq_set_split:Nnn \l__gb_partwords_seq { ~ } \gb@part
          \hbox_set:Nn \l__gb_partword_box { ~ }
          \dim_set:Nn \l__gb_partx_dim { - \box_wd:N \l__gb_partword_box }
          \seq_map_inline:Nn \l__gb_partwords_seq
            {
              \hbox_set:Nn \l__gb_partword_box { ~ }
              \dim_add:Nn \l__gb_partx_dim { \box_wd:N \l__gb_partword_box }
              \hbox_set:Nn \l__gb_partword_box { ##1 }
              \dim_add:Nn \l__gb_partx_dim { \box_wd:N \l__gb_partword_box }
              \bool_lazy_and:nnT
                { \dim_compare_p:nNn { \l__gb_partx_dim } > { \l__gb_labelx_dim } }
                { \dim_compare_p:nNn
                    { \box_dp:N \l__gb_partword_box - \gb@opt@partshift }
                    > { \l__gb_labeltop_dim } }
                { \group_insert_after:N \gb@clashtrue }
            }
        }
    \group_end:
  }
\ExplSyntaxOff
\newdimen\gb@partw
\newcommand*\gb@setpartbox{%
  \gb@partreserve
  \gb@partw=\dimexpr\gb@split-2\gb@pad-\@tempdima-\gb@opt@partgap+\gb@opt@partextend\relax
  \setbox\gb@partbox\hbox{%
    \parbox[b]{\gb@partw}{\raggedright \hyphenpenalty\@M \exhyphenpenalty\@M
      \color{\gb@opt@tocpartcolor}\gb@tocpartfont
      \let\partnumberline\@gobble \let\numberline\@gobble \gb@nolinks
      \gb@part\par}}}

% The title of a part hangs over the rows of the part before it.  When
% those rows are lower than the title (a part with one or two rows), the
% chapter column is lengthened above the first row of the new part until
% the title fits, with a gap of `partgap' under the title above it.  The
% space is a leader, so it is dropped when the part starts a new page.
\newcommand*\gb@partspace{%
  \ifgb@first
    % the first title hangs into the space above the first rule
    \gb@cur=\dimexpr\ht\gb@partbox+\gb@opt@partshift-\gb@opt@topspace+1mm\relax
    \ifdim\gb@cur>\z@ \vskip\gb@cur \nointerlineskip \fi
  \else
    \gb@cur=\dimexpr\ht\gb@partbox+\gb@opt@partshift+\gb@partbelow
      +\gb@opt@partgap+\gb@opt@partskip-\gb@sincepart\relax
    \ifdim\gb@cur>\z@
      % (the chapter column and the page column, as in \gb@textbottom)
      % (one box of exactly that height, so the lines meet the rows)
      \cleaders\hbox to\gb@tocw{%
        \ifgb@lastsub
          \hskip\gb@subsplit \vrule width\gb@rule height\gb@cur depth\z@
          \hskip\dimexpr\gb@pdx-\gb@subsplit-\gb@rule\relax
        \else \hskip\gb@pdx \fi
        \vrule width\gb@rule height\gb@cur depth\z@ \hfil}\vskip\gb@cur
      \nointerlineskip
    \fi
  \fi
  \global\gb@sincepart=\z@
  \global\gb@partbelow=\dimexpr\dp\gb@partbox-\gb@opt@partshift\relax
  \ifdim\gb@partbelow<\z@ \global\gb@partbelow=\z@ \fi}

% the part title hangs above the first row of the part; the first row of
% the contents carries the label on the right
\newcommand*\gb@hanging{%
  \hbox to\gb@tocw{%
    \ifx\gb@part\@empty\else
      % (a long title breaks into lines that stack upwards, left of the
      % main divider)
      \hskip-\dimexpr\gb@opt@partextend\relax
      \raisebox{\gb@opt@partshift}[0pt][0pt]{\copy\gb@partbox}%
      \hskip-\wd\gb@partbox \hskip\dimexpr\gb@opt@partextend\relax
    \fi
    \hfil
    \ifgb@first
      \raisebox{\gb@opt@toclabelraise}[0pt][0pt]{\gb@toclabel{\gb@opt@toclabel}}%
      \hskip\dimexpr\gb@tocw-\gb@split+\gb@pad\relax
    \fi}}

% (the rule under a part title starts `partextend' left of the grid, in the
% margin, where the title starts too)
\newcommand*\gb@toprule{%
  \ifx\gb@part\@empty
    \gb@gaprule{\gb@tocw}{\gb@ruleleft}{\gb@tocw}{\gb@split}%
  \else
    \moveleft\dimexpr\gb@opt@partextend\relax
    \gb@gaprule{\dimexpr\gb@tocw+\gb@opt@partextend\relax}{\z@}%
      {\dimexpr\gb@tocw+\gb@opt@partextend\relax}{\the\dimexpr\gb@split+\gb@opt@partextend\relax}%
  \fi}

% left of the main divider: the chapter column and its label
\newcommand*\gb@leftzone{%
  \ifgb@sub
    \hskip\gb@subsplit \gb@vbar
    \ifx\gb@chap\@empty
      \hskip\dimexpr\gb@split-\gb@subsplit-\gb@rule\relax
    \else
      \hskip\gb@chpad
      % The label stands `tocchaptershift' below the SECTION label of the
      % row, in every chapter, clear of a part title hanging above the row.
      % (An empty first line keeps the box aligned with the title cell.)
      % Its first line is empty and as high as the first line of the title
      % cell (whose height depends on whether the row has a SECTION label),
      % so the label is measured from the rule above the row in every row.
      \vtop{\hsize=\dimexpr\gb@split-\gb@subsplit-\gb@rule-2\gb@chpad\relax
        \hbox{\gb@strut{\gb@rowbase}{\z@}}%
        \nointerlineskip
        \vskip\dimexpr\gb@toppad+\gb@opt@chapshift-\gb@rowbase-5pt\relax
        \gb@toclabelfont \raggedleft \parindent=\z@ \noindent
        \let\chapternumberline\gb@numlabel \let\numberline\gb@numlabel \gb@nolinks
        \gb@strut{5pt}{\z@}\MakeUppercase{\gb@chap}\par}%
      \hskip\gb@chpad
    \fi
  \else
    \hskip\gb@split
  \fi}

% the number line above a title: SECTION 1A, CHAPTER 4
\newcommand*\gb@numline[2]{%
  \global\gb@hasnumtrue
  {\gb@font@tocnumber
   \ifx\relax#1\relax\else\MakeUppercase{#1}\nobreakspace\fi #2}\newline}
\newcommand*\gb@titlebody[1]{%
  \vtop{\hsize=\gb@titlew \gb@toctitlefont \raggedright
    \parindent=\z@ \noindent
    \setbox\z@\hbox{H}%
    \ifgb@hasnum \gb@strut{\gb@toppad}{\z@}%
    \else \gb@strut{\dimexpr\ht\z@+\gb@plainpad\relax}{\z@}\fi
    \def\numberline{\gb@numline{\gb@opt@secword}}%
    \def\chapternumberline{\gb@numline{\gb@opt@chapword}}%
    #1%
    \ifgb@hasnum \gb@strut{\z@}{\gb@botpad}%
    \else \gb@strut{\z@}{\gb@plainpad}\fi
    \par}}
\newlength\gb@rowbase % first baseline of the title cell, from the rule above
\newcommand*\gb@buildtitle[1]{%
  \global\gb@hasnumfalse
  \setbox\gb@titlebox\gb@titlebody{#1}% finds out whether there is a number
  \setbox\gb@titlebox\gb@titlebody{#1}%
  \ifgb@hasnum \global\gb@rowbase=\gb@toppad
  \else
    \setbox\z@\hbox{\gb@toctitlefont H}%
    \global\gb@rowbase=\dimexpr\ht\z@+\gb@plainpad\relax
  \fi}

\newcommand*\gb@pagecell[1]{%
  \setbox\gb@pagebox\hbox{{\gb@tocpagefont #1}}% (inner group: the colour ends in the box)
  \raise\dimexpr(\ht\gb@titlebox-\dp\gb@titlebox-\ht\gb@pagebox+\dp\gb@pagebox)/2\relax
  \hbox to\gb@pagew{\box\gb@pagebox\hfil}}

% Rows are numbered, and the page each one fell on is written to the .aux
% file.  A row that starts a new page inside a chapter repeats the
% chapter's label, so the chapter column does not start without a name.
\newcount\gb@rowno
\def\gb@setrowpage#1#2{\expandafter\xdef\csname gb@pg@#1\endcsname{#2}}
\def\gb@writerow#1{\protected@write\@auxout{}{\string\gb@setrowpage{#1}{\thepage}}}
\let\gb@curchap\@empty
\newcommand*\gb@repeatlabel{%
  \ifgb@sub\ifx\gb@chap\@empty
    \@ifundefined{gb@pg@\the\gb@rowno}{}{%
      \@ifundefined{gb@pg@\the\numexpr\gb@rowno-1\relax}{}{%
        \edef\gb@a{\csname gb@pg@\the\gb@rowno\endcsname}%
        \edef\gb@b{\csname gb@pg@\the\numexpr\gb@rowno-1\relax\endcsname}%
        \ifx\gb@a\gb@b\else \global\let\gb@chap\gb@curchap \fi}}%
  \fi\fi}
\newcommand*\gb@row[2]{%
  \par
  \global\advance\gb@rowno\@ne
  \gb@repeatlabel
  \ifgb@first\else \ifgb@keep\penalty\@M\else\penalty\z@\fi \fi
  \expandafter\gb@writerow\expandafter{\the\gb@rowno}% (after the break point)
  \gb@mark
  \nointerlineskip
  \ifx\gb@part\@empty
    \ifx\gb@chap\@empty \gb@ruleleft=\gb@split \else \gb@ruleleft=\gb@subsplit \fi
  \else \gb@ruleleft=\z@ \fi
  \gb@buildtitle{#1}%
  \ifx\gb@part\@empty\else \gb@setpartbox \gb@partspace \fi
  \gb@hanging \nointerlineskip
  \gb@toprule \nointerlineskip
  \setbox\gb@rowbox\hbox to\gb@tocw{%
    \gb@leftzone
    \hskip\gb@pad \copy\gb@titlebox
    \hskip\gb@pad \gb@vbar \hskip\gb@pad
    \gb@pagecell{#2}\hfil}%
  \global\advance\gb@sincepart\dimexpr\ht\gb@rowbox+\dp\gb@rowbox+\gb@rule\relax
  \ifgb@sub \global\gb@lastsubtrue \else \global\gb@lastsubfalse \fi
  \box\gb@rowbox
  \ifx\gb@part\@empty \global\gb@keepfalse \else \global\gb@keeptrue \fi
  \global\let\gb@part\@empty \global\let\gb@chap\@empty
  \global\gb@firstfalse}

% Each row leaves a mark "AS" for the page builder: A = 1 when the chapter
% column already runs above it, S = 1 when it runs below.  The header uses
% A of the first row on the page, the filler at the foot S of the last one.
\newcommand*\gb@mark{%
  \ifgb@sub
    \ifx\gb@part\@empty
      \ifgb@first \def\gb@mk{01}\else \def\gb@mk{11}\fi
    \else \def\gb@mk{01}\fi
  \else \def\gb@mk{00}\fi
  \expandafter\mark\expandafter{\gb@mk}}
\def\gb@parsemark#1#2#3\relax{\def\gb@mkA{#1}\def\gb@mkS{#2}}

% the vertical lines run on to the foot of the page
\newcommand*\gb@textbottom{%
  \expandafter\gb@parsemark\botmark 00\relax
  \cleaders\hbox to\gb@tocw{%
    \if 1\gb@mkS
      \hskip\gb@subsplit \vrule width\gb@rule height 2pt depth\z@
      \hskip\dimexpr\gb@pdx-\gb@subsplit-\gb@rule\relax
    \else \hskip\gb@pdx \fi
    \vrule width\gb@rule height 2pt depth\z@ \hfil}\vfill}

% page style of the contents, drawn from the header: the dividers, the rule
% at the foot of the text and, under it, the footer text and page number
\newcommand*\gb@tocheader{%
  % the main divider, from the top of the paper to just below the footer text
  \rlap{\smash{\hbox{\hskip\gb@split
    \vrule width\gb@rule height\dimexpr1in+\voffset+\topmargin+\headheight\relax
           depth\dimexpr\headsep+\textheight+\gb@opt@footgap+1.5mm\relax}}}%
  \rlap{\smash{\lower\dimexpr\headsep+\textheight\relax
    \gb@gaprule{\gb@tocw}{\z@}{\gb@tocw}{\gb@split}}}%
  \rlap{\smash{\lower\dimexpr\headsep+\textheight+\gb@opt@footgap\relax
    \hbox to\gb@tocw{%
      \hbox to\gb@split{\hss\gb@toclabel{\gb@opt@tocfooter}\hskip\gb@pad}%
      \hskip\gb@pad{\gb@toctitlefont\thepage}\hfil}}}%
  \hfil}% (everything above has no width: fill the head box)
\newcommand*\ps@gbtoc{%
  \let\@mkboth\@gobbletwo
  \def\@oddhead{\gb@tocheader}\let\@evenhead\@oddhead
  \def\@oddfoot{}\let\@evenfoot\@oddfoot}

\newcommand*\gb@gridtoc{%
  \clearpage
  \gb@tocsetlengths
  \let\gb@tocsavedstyle\gb@curpagestyle
  \gb@pagestyle{gbtoc}%
  \@ifundefined{pdfbookmark}{}{\pdfbookmark[0]{\contentsname}{gb@contents}}%
  \let\gb@oldtextbottom\@textbottom
  \let\@textbottom\gb@textbottom
  \begingroup
    \parindent\z@ \parskip\z@ \topskip\z@
    \hypersetup{hidelinks}%
    \gb@tocentries
    \global\gb@firsttrue \global\gb@subfalse \global\gb@keepfalse
    \global\gb@chappendfalse
    \global\let\gb@part\@empty \global\let\gb@chap\@empty
    \global\gb@partno\z@ \global\gb@rowno\z@ \global\let\gb@curchap\@empty
    \global\gb@sincepart\z@ \global\gb@partbelow\z@ \global\gb@lastsubfalse
    \expandafter\gdef\csname gb@mini@0\endcsname{}%
    \vspace*{\gb@opt@topspace}%
    \@starttoc{toc}%
    \gb@flushchap
    % a rule under the last row, as between the rows; it closes the chapter
    % column too when the last row has one.  The vertical lines run on
    % below it to the foot of the page
    \par\nointerlineskip
    \ifgb@lastsub \gb@ruleleft=\gb@subsplit \else \gb@ruleleft=\gb@split \fi
    \gb@gaprule{\gb@tocw}{\gb@ruleleft}{\gb@tocw}{\gb@split}%
  \endgroup
  \clearpage
  \let\@textbottom\gb@oldtextbottom
  \mark{{}{}}%
  \expandafter\pagestyle\expandafter{\gb@tocsavedstyle}}

%% ----------------------------------------------------------------------
%%  10. Classic table of contents  (toc = classic; greenbook 1.x)
%% ----------------------------------------------------------------------
\RequirePackage{multicol}
\newcommand*\gb@classictoc{%
  \renewcommand{\partnumberline}[1]{\mbox{\centering\normalfont\itshape\rmfamily
    Part~##1}\par\noindent\large}%
  \renewcommand\cftpartafterpnum{\vskip1ex}%
  \renewcommand{\printtoctitle}[1]{\hfill\huge\itshape\rmfamily ##1}%
  \renewcommand{\cftdot}{}%
  \renewcommand{\cftpartfont}{\bfseries\sffamily}%
  \renewcommand{\cftchaptername}{\normalfont\sffamily Chapter }%
  \renewcommand{\cftchapterfont}{\bfseries\sffamily}%
  \renewcommand\cftsectionfont{\rmfamily}%
  \renewcommand\cftsectionpagefont{\rmfamily\itshape\color{gbaccent}}%
  \renewcommand{\cftsectionname}{\normalfont\sffamily}%
  \cftsetindents{section}{2.82em}{2.5em}%
  \setlength\columnsep{2em}%
  \begin{multicols}{2}[\section*{\printtoctitle{\contentsname}}]%
    \@starttoc{toc}%
  \end{multicols}}

\ExplSyntaxOn
\str_if_eq:VnTF \l__gb_toc_tl {grid}
  { \RenewDocumentCommand \tableofcontents { s } { \gb@gridtoc } }
  { \RenewDocumentCommand \tableofcontents { s } { \begingroup\gb@classictoc\endgroup } }
\ExplSyntaxOff

%% ----------------------------------------------------------------------
%%  11. Part pages: the chapters of the part  (parttoc = true)
%%  The list is read from the .toc while the table of contents is typeset,
%%  so it needs \tableofcontents before the first \part, and every \part
%%  numbered.
%% ----------------------------------------------------------------------
% The list is a small version of the grid: hairlines between the rows, the
% chapter label in the small label font on the left, the title, and the
% page in a column on the right.
\newlength\gb@miniw
\newcommand*\gb@miniitem[2]{%
  \begingroup
    \def\gb@mininum{}%
    \setbox\z@\hbox{\def\chapternumberline##1{\gdef\gb@mininum{##1}}%
      \let\numberline\chapternumberline #1}%
    \let\chapternumberline\@gobble \let\numberline\@gobble \gb@nolinks
    \nointerlineskip
    \hbox to\gb@miniw{\vrule width\gb@miniw height\dimexpr\gb@opt@rule\relax depth\z@}%
    \nointerlineskip
    \hbox to\gb@miniw{%
      \gb@strut{\dimexpr\gb@opt@toppad+2mm\relax}{\dimexpr\gb@opt@botpad\relax}%
      \hbox to 22mm{{\gb@toclabelfont
        \ifx\gb@mininum\@empty\else
          \MakeUppercase{\gb@opt@chapword}\nobreakspace\gb@mininum\fi}\hss}%
      {\gb@toctitlefont #1}\hfil
      \hbox to\dimexpr\gb@opt@pagewidth\relax{\hss{\gb@tocpagefont #2}}}%
  \endgroup}
\newcommand*\gb@partminitoc{%
  \gb@ifparttoc{%
    \@ifundefined{gb@mini@\the\c@part}{}{%
      \expandafter\ifx\csname gb@mini@\the\c@part\endcsname\@empty\else
        \par\vspace*{12mm}%
        \begingroup
          \setlength\gb@miniw{0.75\linewidth}%
          \normalfont\normalsize\color{black}%
          \hbox to\linewidth{\hss\vbox{\hsize\gb@miniw \parindent\z@
            \csname gb@mini@\the\c@part\endcsname
            \nointerlineskip
            \hbox to\gb@miniw{\vrule width\gb@miniw height\dimexpr\gb@opt@rule\relax depth\z@}}%
          \hss}\par
        \endgroup
      \fi}}{}}

%% ----------------------------------------------------------------------
%%  12. Exercises  (option `exercises'; xsim)
%% ----------------------------------------------------------------------
% exc: a group of exercises.  A hairline across the text that thickens over
% its last 4 cm, "Exercises" under the thick part, a hairline at the end.
% The heading and the start of the first exercise stay on one page.
\newenvironment{exc}
  {\par\addvspace{\bigskipamount}\Needspace*{9\baselineskip}%
   \noindent\hbox to\linewidth{%
     \vrule width\dimexpr\linewidth-4cm\relax height .3pt depth\z@
     \vrule width 4cm height 1.2mm depth\z@}\par\nobreak
   \vskip 4pt
   \noindent\hbox to\linewidth{\hfil
     \hbox to 3.8cm{\Large\bfseries Exercises\hss}}\par\nobreak
   \vskip\medskipamount}
  {\par\bigskip\hrule\par\addvspace{2\bigskipamount}}

\ExplSyntaxOn
\bool_if:NT \l__gb_exercises_bool { \RequirePackage{xsim} }
\ExplSyntaxOff
\@ifpackageloaded{xsim}{%
  \DeclareExerciseEnvironmentTemplate{custom}{%
    \par\vspace{3.25ex plus 1ex minus .2ex}%
    \Needspace*{3\baselineskip}%
    \noindent\normalsize
    \textbf{\XSIMmixedcase{\GetExerciseName}\nobreakspace\GetExerciseProperty{counter}}%
    \IfInsideSolutionF{%
      \GetExercisePropertyT{subtitle}{ {\normalfont\itshape\PropertyValue}}}%
    \IfInsideSolutionF{%
      \GetExercisePropertyT{points}{%
        \hfill[{\color{teal}\printgoal{\PropertyValue}}%
          \GetExercisePropertyT{bonus-points}{~[+\printgoal{\PropertyValue}]}]}}%
    \;%
    \@afterindentfalse\@afterheading}
  {}
  \xsimsetup{
    exercise/the-counter = \thesection.\arabic{exercise}. ,
    exercise/template = custom ,
    exercise/name = ,
    solution/template = custom ,
  }
  % all solutions, headed chapter by chapter and section by section
  % One section of the solutions for each chapter: the heading names the
  % chapter, and the contents list it as a row of the solutions chapter,
  % labelled CHAPTER <n> and titled with the title of that chapter.
  \newcommand*\gb@solchapter[2]{%
    \edef\gb@tmp{#2}%
    \ifcsname gb@chaptitle@\gb@tmp\endcsname
      \edef\gb@tmp{\expandafter\noexpand\csname gb@chaptitle@\gb@tmp\endcsname}%
      \section*{\chaptername~#1\quad\gb@tmp}%
      \@ifundefined{phantomsection}{}{\phantomsection}%
      \addcontentsline{toc}{section}{\protect\chapternumberline{#1}\gb@tmp}%
    \else
      \section*{\chaptername~#1}%
      \@ifundefined{phantomsection}{}{\phantomsection}%
      \addcontentsline{toc}{section}{\protect\chapternumberline{#1}\chaptername~#1}%
    \fi}
  \newcommand{\printsolutionsbysection}{%
    \def\gb@lastchapter{}\def\gb@lastsection{}%
    \ForEachUsedExerciseByType{%
      \edef\gb@thischapter{\ExercisePropertyGet{##1}{##2}{chapter-value}}%
      \edef\gb@thissection{\ExercisePropertyGet{##1}{##2}{section-value}}%
      \ifx\gb@lastchapter\gb@thischapter\else
        \gb@solchapter{\ExercisePropertyGet{##1}{##2}{chapter}}%
          {\ExercisePropertyGet{##1}{##2}{chapter-value}}%
      \fi
      \ifx\gb@lastsection\gb@thissection\else
        \subsection*{\S\ExercisePropertyGet{##1}{##2}{section}}%
      \fi
      \XSIMprint{solution}{##1}{##2}%
      \let\gb@lastchapter\gb@thischapter
      \let\gb@lastsection\gb@thissection}}
}{}

%% ----------------------------------------------------------------------
%%  13. Small environments
%% ----------------------------------------------------------------------
% fullwidth: text, a diagram or a table over the text and the margin
\newlength{\fullwidthlen}% (greenbook 1.x; set when the environment starts)
\newenvironment{fullwidth}
  {\setlength\fullwidthlen{\dimexpr\marginparsep+\marginparwidth\relax}%
   \begin{adjustwidth}{}{-\fullwidthlen}}
  {\end{adjustwidth}}

% widefigure: a figure over the text and the margin.
%   \begin{widefigure}[<placement>] ... \caption{...} \end{widefigure}
% floats like a figure; its caption stands below it, in the margin column.
%   \begin{widefigure*} ... \caption{...} \end{widefigure*}
% does not float: it is set where it stands, and its caption goes into the
% margin beside the text that follows.  (With captions = below, both put
% the caption under the figure, as wide as it.)
% With [H] the figure stays where it is, so its caption goes beside the text
% that follows (as in widefigure*) instead of taking its own height below it.
\def\gb@H{H}
\newenvironment{widefigure}[1][tbp]
  {\begin{figure}[#1]\def\gb@tmp{#1}%
   \ifx\gb@tmp\gb@H \gb@capmode\tw@ \else \gb@capmode\@ne \fi
   \begin{fullwidth}}
  {\end{fullwidth}\end{figure}}
\newenvironment{widefigure*}
  {\par\addvspace{\intextsep}\begingroup
   \def\@captype{figure}\gb@capmode\tw@
   \begin{fullwidth}\centering}
  {\end{fullwidth}\endgroup\par\addvspace{\intextsep}}

% \sidenote: the old name of \marginpar
\providecommand{\sidenote}{\marginpar}

% \prototype{...}: the prototypical example of a section, a tinted strip
% with "Prototype" in the margin
\newcommand{\prototype}[1]{\par
  \begin{tcolorbox}[enhanced, unbreakable, parbox=false, boxsep=0pt,
    colback=lightslategreen!40, frame hidden, arc=2pt,
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    before skip=8pt plus 2pt, after skip=12pt plus 2pt,
    overlay={\gb@marginlabel{12.5pt}{\gb@labelfont Prototype}}]#1\end{tcolorbox}}

% caution: a trap, a rule on the left in gbcaution with "Caution" in the
% margin; an optional note (e.g. a short label) is printed before the body
\newenvironment{caution}[1][]
  {\par\begin{tcolorbox}[enhanced, breakable, parbox=false, boxsep=0pt,
     colback=gbcautionpaper, frame hidden, arc=0pt,
     left=12pt, right=10pt, top=7pt, bottom=7pt,
     before skip=12pt plus 2pt, after skip=12pt plus 2pt,
     overlay unbroken and first={%
       \fill[gbcaution] (frame.north west) rectangle ([xshift=2.4pt]frame.south west);
       \gb@marginlabel{14pt}{\gb@labelfont\color{gbcaution}Caution}},
     overlay middle and last={%
       \fill[gbcaution] (frame.north west) rectangle ([xshift=2.4pt]frame.south west);}]%
   \if\relax\detokenize{#1}\relax\else{\gb@font@thmnote #1}\par\fi}
  {\end{tcolorbox}}

