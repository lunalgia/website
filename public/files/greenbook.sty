% The running head, the same on every page, at the left of the text:
%     6  |  2.1. The Physical Quantities
% It shows the section, or the chapter before the first section.
\newcommand*\gb@headmark{%
  \protected@edef\gb@tmpmark{\rightmark}%
  \ifx\gb@tmpmark\@empty\leftmark\else\rightmark\fi}
\newcommand*\gb@runninghead{%
  \gb@marginbar
  \gb@ifmarginbar{}{{\gb@font@headerpage\thepage}\quad{\color{gray}|}\quad}%
  {\gb@font@header\gb@headmark}}

% The margin bar (marginbar = true), after artbook.sty: a strip of the
% accent colour down the right edge of the paper, `marginbarwidth' wide,
% with the page number at its top and the title of the chapter running
% down it.  It is drawn from the running head, so it is on every page with
% the fullwidth page style (not on chapter, part and contents pages).
\gdef\gb@chaptertitle{}
\let\gb@memchaptermark\chaptermark
\renewcommand*\chaptermark[1]{\gdef\gb@chaptertitle{#1}%
  % the title of each numbered chapter, for the headings of the solutions
  % (a \chapter* with a short title also calls \chaptermark: it does not
  % replace the title of the chapter before it)
  \ifcsname gb@chaptitle@\arabic{chapter}\endcsname\else
    % (memoir passes \f@rhdr, which changes with the next chapter: expand it)
    \expandafter\protected@xdef\csname gb@chaptitle@\arabic{chapter}\endcsname{#1}%
  \fi
  \gb@memchaptermark{#1}}
\newbox\gb@barbox
\newcommand*\gb@marginbar{%
  \gb@ifmarginbar{%
    \begingroup
    \dimen@=\dimexpr1in+\voffset+\topmargin+\headheight\relax % paper top
    \dimen@ii=\dimexpr\stockwidth-1in-\hoffset-\oddsidemargin
                     -\gb@opt@barwidth\relax                     % bar left
    % the bar: it runs a paper height past the top and the foot of the page
    % and 5mm past its right edge, so that it covers the page to its edges
    % whatever the trims and the rounding (the viewer clips it to the page)
    \rlap{\hskip\dimen@ii\smash{\raise\dimen@\hbox{{\color{gbaccent}%
      \vrule width\dimexpr\gb@opt@barwidth+5mm\relax
        height\stockheight depth2\stockheight}}}}%
    % the page number, level with the running head
    \setbox\gb@barbox\hbox{{\gb@font@marginbar\color{gbbarink}\thepage}}%
    \rlap{\hskip\dimexpr\dimen@ii+(\gb@opt@barwidth-\wd\gb@barbox)/2\relax
      \box\gb@barbox}%
    % the title of the chapter (or of the document), reading downwards
    \setbox\gb@barbox\hbox{{\gb@font@marginbar\color{gbbarink}%
      \ifx\gb@chaptertitle\@empty\MakeUppercase{\gb@doctitle}%
      \else\MakeUppercase{\gb@chaptertitle}\fi}}%
    \setbox\gb@barbox\hbox{\rotatebox[origin=c]{-90}{\box\gb@barbox}}%
    \rlap{\hskip\dimexpr\dimen@ii+(\gb@opt@barwidth-\wd\gb@barbox)/2\relax
      \smash{\lower\dimexpr6mm+\ht\gb@barbox\relax\box\gb@barbox}}%
    \endgroup}{}}
\makepagestyle{fullwidth}
\makeevenhead{fullwidth}{\gb@runninghead}{}{}
\makeoddhead{fullwidth}{\gb@runninghead}{}{}
\pagestyle{fullwidth}

% remember the page style, so that the table of contents can restore it
