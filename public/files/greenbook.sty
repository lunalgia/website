      { \PackageInfo{greenbook}{#1:~none~of~the~fonts~is~installed;~default~kept} }
  }
\cs_new_protected:Npn \__gb_pick_try:nNnn #1#2#3#4
  {
    \IfFontExistsTF {#3}
      {
        #2 {#3} {#4}
        \bool_set_true:N \l__gb_found_bool
        \PackageInfo{greenbook}{#1:~#3}
      }
      { \PackageInfo{greenbook}{#1:~#3~is~not~installed} }
  }
