% [H]: a float set where it stands (before hyperref, as float asks).
% float replaces memoir's \newfloat with its own; memoir's is put back, and
% float's stays available as \floatnewfloat
\let\gb@memnewfloat\newfloat
\RequirePackage{float}
\let\floatnewfloat\newfloat
\let\newfloat\gb@memnewfloat
\RequirePackage[linktoc=page,hyperfootnotes=false]{hyperref}
\hypersetup{colorlinks=true, linkcolor=hkgreen, citecolor=hkgreen, urlcolor=hkgreen}
\renewcommand{\UrlFont}{\ttfamily\small}

% ---- notes in the margin
% \marginpar, \marginnote and the footnotes share one style: `notefont',
% ragged right (with hyphenation), no indent.
\newcommand*\gb@notestyle{%
  \gb@font@note \RaggedRight \parindent\z@ \parskip\z@ \color{black}}
\renewcommand*{\marginfont}{\gb@notestyle}% of the marginnote package
\g@addto@macro\@marginparreset{\gb@notestyle}

% footnotes = margin: \footnote[offset]{text} is a numbered margin note; the
% number is a superscript in the text and at the start of the note
% true in a paragraph of the main text (where \marginpar works)
\newif\ifgb@inbox
\newcommand\gb@ifouterpar[2]{%
  \ifgb@inbox #2\else\if@minipage #2\else\ifinner #2\else
    \ifhmode #1\else #2\fi\fi\fi\fi}
\newif\ifgb@marginfoot
\ExplSyntaxOn
\str_if_eq:VnT \l__gb_footnotes_tl {margin} { \gb@marginfoottrue }
\ExplSyntaxOff
\ifgb@marginfoot
  % In running text the note is a \marginpar, so notes on the same line are
  % stacked; inside boxes, or with an offset, it is a \marginnote.
  \RenewDocumentCommand\footnote{o+m}{%
    \refstepcounter{footnote}%
    \textsuperscript{\thefootnote}%
    \IfNoValueTF{#1}
      {\gb@ifouterpar{\marginpar{\gb@fntext{#2}}}{\marginnote{\gb@fntext{#2}}}}%
      {\marginnote{\gb@fntext{#2}}[#1]}}
  \newcommand\gb@fntext[1]{\textsuperscript{\thefootnote}\,#1}
\fi

% ---- margin floats hang from the line they are given at
% memoir's marginfigure and margintable are a minipage centred on the line
% they are given at, so their upper half rose above it (into a box label
% or a note above).  Here their top stands at that line.
\renewenvironment{mem@margin@float}[2][-1.2ex]%
  {\FloatBlock
  \begin{lrbox}{\mem@margin@floatbox}%
  \begin{minipage}[t]{\marginparwidth}%
    \def\@captype{#2}%
    \hbox{}\vspace*{#1}%
    \@nameuse{margin#2adjustment}%
    \@nameuse{margin#2captionadjustment}%
    \noindent}
  {\end{minipage}%
  \end{lrbox}%
  \marginfloatmarginmacro{\usebox{\mem@margin@floatbox}}}

% ---- the margin is shared: labels of boxes, notes, margin floats
% Things in the margin: \marginpar (and so the footnotes of the running
% text and the margin floats), \marginnote (the footnotes in boxes), and
% the labels of the framed boxes, which the boxes draw.  LaTeX stacks the
% \marginpar's, but knows nothing of the other two, so:
%  * each of them is numbered in the order of the text, and its place on
%    the page is written to the .aux file;
%  * on the next run, each one is moved down until it is clear of all the
%    earlier ones on its page: a \marginnote by its offset, a \marginpar by
%    space at its top, and a label by space before its box (the box moves
%    with it).  The places are taken as they were without that move, so a
%    move does not undo itself; since nothing depends on later things, a
%    few runs settle every page (latexmk runs them);
%  * before a box with a label an empty \marginpar as high as the label is
%    set, so LaTeX moves a later \marginpar below the label at once.
\RequirePackage{zref-savepos,zref-abspage,etoolbox}
\newcount\gb@mino   % the things in the margin, in the order of the text
\newdimen\gb@mishift
\def\gb@miclear{5pt}% the least space between two of them
% from the .aux file: #1 = number, #2 = kind (p, n, l), #3 = page,
% #4 = the move it had
\def\gb@mi#1#2#3#4{%
  \expandafter\gdef\csname gb@mi@k@#1\endcsname{#2}%
  \expandafter\gdef\csname gb@mi@s@#1\endcsname{#4}%
  \@ifundefined{gb@pg@items@#3}{\expandafter\gdef\csname gb@pg@items@#3\endcsname{}}{}%
  \expandafter\g@addto@macro\csname gb@pg@items@#3\endcsname{\do{#1}}%
  \expandafter\gdef\csname gb@mi@p@#1\endcsname{#3}}
\newcommand*\gb@zy[1]{\zref@extractdefault{#1}{posy}{0}sp}
% top and bottom of thing #1 as placed on the last run, into \@tempdima,
% \@tempdimb.  A note: a line above its first baseline, and its end.  A
% label: the place where its box was opened, less the skip above the box
% and the first line.
\def\gb@labelhead{\dimexpr15pt+\gb@labelbase\relax}
\newcommand*\gb@miextent[1]{%
  \if l\csname gb@mi@k@#1\endcsname
    \@tempdima=\dimexpr\gb@zy{gbmit#1}-\gb@labelhead+8pt\relax
    \@tempdimb=\dimexpr\@tempdima-12pt\relax
  \else
    \@tempdima=\dimexpr\gb@zy{gbmit#1}+\gb@miht{#1}\relax
    \@tempdimb=\dimexpr\gb@zy{gbmit#1}-\gb@midp{#1}\relax
  \fi}
% height and depth of a note (from its first baseline), from the .aux file
\def\gb@miext#1#2#3{%
  \expandafter\gdef\csname gb@mi@h@#1\endcsname{#2}%
  \expandafter\gdef\csname gb@mi@d@#1\endcsname{#3}}
\def\gb@miht#1{\ifcsname gb@mi@h@#1\endcsname\csname gb@mi@h@#1\endcsname\else 9pt\fi}
\def\gb@midp#1{\ifcsname gb@mi@d@#1\endcsname\csname gb@mi@d@#1\endcsname\else 0pt\fi}
% the move that thing \gb@mino needs: \gb@mishift
\newcommand*\gb@findshift{%
  \global\gb@mishift\z@
  \edef\gb@minow{\the\gb@mino}%
  \@ifundefined{gb@mi@p@\gb@minow}{}{%
    \edef\gb@mipage{\csname gb@mi@p@\gb@minow\endcsname}%
    % this one, without its last move
    \gb@miextent{\gb@minow}%
    \dimen@=\csname gb@mi@s@\gb@minow\endcsname\relax
    \advance\@tempdima\dimen@ \advance\@tempdimb\dimen@
    \edef\gb@mytop{\the\@tempdima}\edef\gb@mybot{\the\@tempdimb}%
    % (a few passes: a move can bring it onto a thing further down)
    \@tempcnta\z@
    % (a \marginpar is kept clear of earlier \marginpar's and labels by
    % LaTeX itself: only the notes count for it)
    \edef\gb@mykind{\csname gb@mi@k@\gb@minow\endcsname}%
    \def\do##1{\ifnum##1<\gb@minow\relax
      \if p\gb@mykind
        \if n\csname gb@mi@k@##1\endcsname \@tempswatrue \else \@tempswafalse \fi
      \else \@tempswatrue \fi
      \if@tempswa
        \gb@miextent{##1}%
        \ifdim\dimexpr\@tempdima+\gb@miclear\relax>\dimexpr\gb@mybot-\gb@mishift\relax
          \ifdim\dimexpr\@tempdimb-\gb@miclear\relax<\dimexpr\gb@mytop-\gb@mishift\relax
            \global\gb@mishift\dimexpr\gb@mytop-\@tempdimb+\gb@miclear\relax
            \let\gb@moved\relax
          \fi
        \fi
      \fi\fi}%
    \loop
      \let\gb@moved\@empty
      \csname gb@pg@items@\gb@mipage\endcsname
      \advance\@tempcnta\@ne
    \ifnum\ifx\gb@moved\relax\@tempcnta\else 99\fi<6 \repeat
    % A note or a float that would run below the text is moved up instead,
    % as far as the earlier things on the page let it.
    \if l\gb@mykind\else
      \ifdim\dimexpr\gb@mybot-\gb@mishift\relax<\gb@textfoot
        \dimen@=\dimexpr\gb@mybot-\gb@textfoot\relax % the most it may move
        \@tempdimc=\maxdimen % the lowest bottom of the earlier things
        \def\do##1{\ifnum##1<\gb@minow\relax
          \gb@miextent{##1}%
          \ifdim\@tempdimb<\@tempdimc \@tempdimc=\@tempdimb \fi\fi}%
        \csname gb@pg@items@\gb@mipage\endcsname
        \ifdim\@tempdimc<\maxdimen
          \advance\@tempdimc-\gb@miclear
          % (it must stay below them)
          \ifdim\dimen@<\dimexpr\gb@mytop-\@tempdimc\relax
            \dimen@=\dimexpr\gb@mytop-\@tempdimc\relax \fi
        \fi
        \ifdim\dimen@<\gb@mishift \global\gb@mishift\dimen@ \fi
      \fi
    \fi
  }}
% the foot of the text block, as \zposy measures it (from the foot of the
% stock)
\def\gb@textfoot{\dimexpr\stockheight-1in-\voffset-\topmargin-\headheight
  -\headsep-\textheight\relax}
% number the next thing, find its move, write it out
\newcommand*\gb@minext[1]{% #1 = kind
  \global\advance\gb@mino\@ne
  \gb@findshift
  % A move changes how full the page is, and so (through the glue) the
  % places of the things above it, a little: a move that would be up to 3pt
  % smaller than the last one keeps the last one, so the runs settle.
  \@ifundefined{gb@mi@s@\the\gb@mino}{}{%
    \dimen@=\csname gb@mi@s@\the\gb@mino\endcsname\relax
    \ifdim\gb@mishift<\dimen@
      \ifdim\dimexpr\dimen@-\gb@mishift\relax<3pt \global\gb@mishift\dimen@ \fi
    \fi}%
  \edef\gb@mithis{\the\gb@mino}%
  \protected@write\@auxout{}{\string\gb@mi{\gb@mithis}{#1}{\noexpand\the\noexpand\c@abspage}{\the\gb@mishift}}}
% A note is set in a box first, so that its height and depth are known;
% its place is that of its first baseline.
\newbox\gb@mibx
\newcommand\gb@mibox[1]{%
  \setbox\gb@mibx\vtop{\hsize\marginparwidth \@parboxrestore \@marginparreset
    #1\par}%
  \protected@write\@auxout{}{\string\gb@miext{\gb@mithis}{\the\ht\gb@mibx}{\the\dp\gb@mibx}}%
  \leavevmode\expandafter\zsavepos\expandafter{gbmit\gb@mithis}\box\gb@mibx}

% \marginpar: its move is added where LaTeX places it on the page (in
% \@addmarginpar, which takes the marginpars in the order of the text, so
% the moves wait in a queue)
% (an l3 sequence: a list of braced items lost the braces of its last item
% when the first one was taken off, so a third \marginpar on a page read a
% shift without its unit)
\ExplSyntaxOn
\seq_new:N \g__gb_mpqueue_seq
\tl_new:N \l__gb_mpitem_tl
\cs_new_protected:Npn \gb@mpenqueue #1 { \seq_gput_right:Nx \g__gb_mpqueue_seq {#1} }
\cs_new_protected:Npn \gb@mpnextshift
  {
    \seq_gpop_left:NNTF \g__gb_mpqueue_seq \l__gb_mpitem_tl
      { \@tempdimb = \l__gb_mpitem_tl \relax }
      { \@tempdimb = \c_zero_dim }
  }
\ExplSyntaxOff
\patchcmd\@addmarginpar
  {\global\@mparbottom\@pageht}
  {\gb@mpnextshift \advance\@tempdima\@tempdimb
   \global\@mparbottom\@pageht}
  {}{\PackageWarning{greenbook}{Could not patch \string\@addmarginpar}}
\NewCommandCopy\gb@latexmarginpar\marginpar
\RenewDocumentCommand\marginpar{o +m}{%
  \gb@minext{p}%
  \gb@mpenqueue{\the\gb@mishift}%
  \IfNoValueTF{#1}
    {\gb@latexmarginpar{\gb@mpwrap{#2}}}
    {\gb@latexmarginpar[\gb@mpwrap{#1}]{\gb@mpwrap{#2}}}}
\newcommand\gb@mpwrap[1]{\gb@mibox{#1}}
% \marginnote: moved down by its offset
\let\gb@mnorig\@mn@@@marginnote
\long\def\@mn@@@marginnote[#1]#2[#3]{%
  \gb@minext{n}%
  \gb@mnorig[{#1}]{\gb@mibox{#2}}[{\dimexpr#3+\gb@mishift\relax}]}
% a label: moved down by space before its box
\newcommand*\gb@marginguard{%
  \ifgb@inbox\else\if@minipage\else\ifinner\else\ifvmode
    \gb@minext{l}%
    \ifdim\gb@mishift>\z@ \vspace*{\gb@mishift}\fi
    \expandafter\zsavepos\expandafter{gbmit\gb@mithis}%
    \gb@mpenqueue{0pt}%
    \gb@latexmarginpar{\vrule width\z@ height\z@
      depth\dimexpr\gb@labelhead+4pt\relax}%
  \fi\fi\fi\fi}
\def\gb@kindtheorem{theorem}\def\gb@kindquestion{question}

% ---- captions
% captions = margin: the caption of a figure or table stands in the margin,
% its last line level with the foot of the float (a caption given before
% the content stands level with its top).  captions = below: memoir's.
\captionnamefont{\gb@font@captionlabel}
\captiontitlefont{\gb@font@caption}
\captiondelim{.\ }
\newcount\gb@capmode % 0 = in a float, 1 = wide float, 2 = wide, in the text
\newcommand*\gb@capbox[2]{%
  \setbox\@tempboxa\vbox{{\hsize\marginparwidth \gb@notestyle
    {\gb@font@captionlabel #1.}\ {\gb@font@caption #2}\par}}}
\newcommand*\gb@capshift{\hskip\dimexpr\textwidth+\marginparsep-\@totalleftmargin\relax}
% (the caption package replaces this mechanism; greenbook-macros no longer
% loads subcaption for that reason; use memoir's \subbottom for subfigures.
% float is loaded for [H]; its \restylefloat would replace it too)
\let\gb@memmakecaption\@makecaption
\long\def\@makecaption#1#2{%
  \gb@ifmargincaptions
    \gb@capbox{#1}{#2}%
    \par
    \ifdim\prevdepth>-99\p@ \@tempswatrue \else \@tempswafalse \fi
    \nointerlineskip
    \ifcase\gb@capmode
      \if@tempswa               % after the content: hang upwards
        \hbox to\linewidth{\gb@capshift\vbox to\z@{\vss\box\@tempboxa}\hss}%
      \else                     % before the content: hang downwards
        \hbox to\linewidth{\gb@capshift\vbox to\z@{\box\@tempboxa\vss}\hss}%
      \fi
    \or                         % wide float: below, taking its height
      \vskip\abovecaptionskip
      \hbox to\linewidth{\gb@capshift\box\@tempboxa\hss}%
    \else                       % wide figure in the text: beside what follows
      % (a box of no height or depth: the text after the figure is not moved)
      \hbox to\linewidth{\gb@capshift
        \vbox to\z@{\vskip\abovecaptionskip\box\@tempboxa\vss}\hss}%
    \fi
    \nointerlineskip
  \else
    \gb@memmakecaption{#1}{#2}%
  \fi}
\ExplSyntaxOn
\cs_new:Npn \gb@ifmargincaptions { \str_if_eq:VnTF \gb@opt@captions {margin} {\iftrue} {\iffalse} }
\ExplSyntaxOff

% \captionof{figure}[short]{text}: a numbered caption outside a float, under
% what precedes it (as the caption package has it); \captionof*{figure}{text}
% the same without a number (memoir's \legend).  Both stay in place, so they
% work in minipages and boxes.  Defined only if no other package did.
\AtBeginDocument{%
  \ProvideDocumentCommand\captionof{s m o +m}{%
    \par\begingroup
      \def\@captype{#2}\let\@makecaption\gb@memmakecaption
      \IfBooleanTF{#1}{\legend{#4}}%
        {\IfNoValueTF{#3}{\caption{#4}}{\caption[#3]{#4}}}%
    \endgroup}}

% side captions (memoir's sidecaption environment), ragged right
\setsidecappos{t}
\sidecapmargin{right}
\setsidecaps{\marginparsep}{\marginparwidth}
\renewcommand*{\sidecapstyle}{\captionstyle{\RaggedRight}}
\AddToHook{env/sidecaption/begin}{\let\@makecaption\gb@memmakecaption}
% margin floats (memoir's marginfigure and margintable) are already in the
% margin: their captions go under them, as wide as the margin, in the
% style of the notes
\newcommand*\gb@marginfloatcaptions{%
  \let\@makecaption\gb@memmakecaption
  \captionstyle{\RaggedRight}%
  \@ifundefined{subcaptionstyle}{}{\subcaptionstyle{\RaggedRight}}}
\AddToHook{env/marginfigure/begin}{\gb@marginfloatcaptions}
\AddToHook{env/margintable/begin}{\gb@marginfloatcaptions}

%% ----------------------------------------------------------------------
%%  8. Theorem boxes
%%
%%  The boxes are tcolorboxes, opened by the theorem styles of thmtools
%%  (key `gbbox' of \declaretheoremstyle / \declaretheorem):
%%     hangingtheo   framed box, name and number in the margin
%%     hangingques   the same, italic body
%%     thmexample    tinted box, rule on the left and on top, a tab
%%     thmremark     tinted box, rule on top and at the bottom, small text
%%  Breaking:
%%     \greenbooksetup{breakable=false}   no box breaks (from here on)
%%     \greenbooksetup{split=closed}      every part a closed box
%%     \greenbooksetup{split=open}        open edges where it breaks
%%     \greenbooksetup{split=marked}      open, a dashed edge, and the name
%%                                        in the margin again: "... cont."
%%     \gbkeep \begin{theorem} ...        this box does not break
%%     \gbbreak \begin{theorem} ...       this box may break
%%  A breakable box only starts on a page with room for `needspace' lines.
%% ----------------------------------------------------------------------
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,hooks}
\RequirePackage{needspace}
\RequirePackage{amsthm}
\RequirePackage{thmtools}
% thmtools replaces \@addtoreset with a version that leaves \theH<counter>
% alone, so a counter reset by the chapter has link targets such as
% definition.1 in every chapter and links land in the wrong chapter.  Put the
% parent back, as the kernel's \@addtoreset does.
\let\gb@thmt@addtoreset\@addtoreset
\renewcommand*\@addtoreset[2]{%
  \gb@thmt@addtoreset{#1}{#2}%
  \@ifundefined{theH#2}{}{%
    \expandafter\xdef\csname theH#1\endcsname{%
      \expandafter\noexpand\csname theH#2\endcsname.%
      \noexpand\the\noexpand\value{#1}}}}

% thmtools reads a note as (#3), up to its first ")": a note such as
% $\mathcal{P}_m(\mathbb{F})$ was cut after the "F".  In \NOTE the note is
% followed by \egroup: read up to the ")" just before it.
\def\thmt@embrace#1#2(#3)\egroup{#1#3#2\egroup}

% the box of the next theorem: 0 = as set, 1 = keep, 2 = may break
\newcount\gb@nextbreak
\newcommand*\gbkeep{\global\gb@nextbreak\@ne}
\newcommand*\gbbreak{\global\gb@nextbreak\tw@}
\newif\ifgb@thisbreak

% name and number of the box being typeset (for the margin label)
\gdef\gb@curlabel{}
\newcommand*\gb@setlabel[2]{\protected@xdef\gb@curlabel{#1\ifx\relax#2\relax\else\ #2\fi}}

\newcommand*\gb@labelfont{\gb@font@thmlabel\color{black}}
\newcommand*\gb@contfont{\normalfont\rmfamily\itshape\footnotesize\color{gray!70!black}}

% #1 = kind (theorem, question, example, remark)
\newcommand*\gb@openbox[1]{%
  \ifcase\gb@nextbreak
    \gb@ifbreakable{\gb@thisbreaktrue}{\gb@thisbreakfalse}%
  \or \gb@thisbreakfalse
  \else \gb@thisbreaktrue
  \fi
  \global\gb@nextbreak\z@
  \par
  \ifgb@thisbreak \Needspace*{\gb@needlines\baselineskip}\fi
  \def\gb@tmpa{#1}%
  \ifx\gb@tmpa\gb@kindtheorem \gb@marginguard
  \else\ifx\gb@tmpa\gb@kindquestion \gb@marginguard \fi\fi
  \let\gb@savedlabel\gb@curlabel
  \gb@inboxtrue
  \begin{tcolorbox}[gb/#1,gb/@split]}
\newcommand*\gb@closebox{%
  \end{tcolorbox}%
  \global\let\gb@curlabel\gb@savedlabel}

% the key of thmtools
\define@key{thmdef}{gbbox}{%
  \thmt@trytwice{}{%
    \addtotheorempreheadhook[\thmt@envname]{\gb@openbox{#1}}%
    \addtotheorempostfoothook[\thmt@envname]{\gb@closebox}}}

% A label in the margin.  #1 = its baseline, below the top of the frame.
\newcommand*\gb@marginlabel[2]{%
  \node[anchor=base west,inner sep=0pt,outer sep=0pt,align=left]
    at ([xshift=\gb@labelsep,yshift=-#1]frame.north east) {#2};}
\def\gb@labelbase{16.3pt}% first line of a box
\def\gb@contbase{13.5pt}%  first line after a break
\tcbset{
  gb/base/.style={enhanced, parbox=false, boxsep=0pt,
    gb/@closed/.style={}},
  % the frame of a theorem: name in the margin, level with the first line
  gb/theorem/.style={gb/base,
    colback=white, colframe=black, boxrule=0.8pt, arc=4pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    before skip=15pt plus 3pt minus 2pt, after skip=12pt plus 3pt minus 2pt,
    overlay unbroken and first app={%
      \gb@marginlabel{\gb@labelbase}{\gb@labelfont\gb@curlabel}}},
  gb/question/.style={gb/theorem},
  % example: tinted, rules on the left and on top, a tab on the top rule
  % example: tinted, slightly rounded, rules of the accent colour along the
  % top and the left side (the frame, with only these two sides) and the tab
  % in the top left corner
  gb/example/.style={gb/base,
    colback=gbpaper, colframe=gbaccent, arc=1.5pt,
    boxrule=0pt, toprule=1.2pt, leftrule=1.2pt,
    left=10pt, right=10pt, top=2.4pt, bottom=11pt,
    before skip=16pt plus 2pt minus 1pt, after skip=14pt plus 2pt minus 1pt,
    % paragraphs and displays in an example get a little more air
    before upper={\setlength\parskip{.4\baselineskip plus 1pt}%
      \setlength\abovedisplayskip{8pt plus 2pt minus 2pt}%
      \setlength\belowdisplayskip{8pt plus 2pt minus 2pt}%
      \setlength\lineskiplimit{1.5pt}\setlength\lineskip{3pt plus 1pt}},
    overlay unbroken and first app={\gb@drawtab}},
  % remark: tinted, rules on top and at the bottom
  gb/remark/.style={gb/base,
    colback=gbpaper, frame hidden, arc=0pt,
    left=12pt, right=12pt, top=7pt, bottom=9pt,
    before skip=12pt plus 2pt minus 1pt, after skip=12pt plus 2pt minus 1pt,
    fontupper=\small,
    overlay unbroken and first app={\gb@hline{north}{black}{.8pt}},
    overlay unbroken and last app={\gb@hline{south}{black}{.8pt}},
    gb/@closed/.style={overlay middle and last app={\gb@hline{north}{black}{.8pt}},
      overlay first and middle app={\gb@hline{south}{black}{.8pt}}}},
  gb/@split/.code={\ifgb@thisbreak \pgfkeysalso{gb/split/\gb@splitstyle}%
    \else \pgfkeysalso{unbreakable}\fi},
  % the ways a box can break
  gb/split/closed/.style={breakable, pad at break*=6pt,
    skin first=enhanced, skin middle=enhanced, skin last=enhanced, gb/@closed},
  gb/split/open/.style={breakable, skin=enhanced jigsaw, pad at break*=6pt},
  gb/split/marked/.style={gb/split/open,
    overlay first app={\gb@cutline{south}},
    overlay middle app={\gb@cutline{south}\gb@cutline{north}\gb@contlabel},
    overlay last app={\gb@cutline{north}\gb@contlabel}},
}
% a rule along the top (north) or bottom (south) edge, inside the box:
% #2 = colour, #3 = width
\newcommand*\gb@hline[3]{%
  \draw[#2,line width=#3]
    ([yshift=\csname gb@sign@#1\endcsname.5*#3]frame.#1 west)--
    ([yshift=\csname gb@sign@#1\endcsname.5*#3]frame.#1 east);}
\def\gb@sign@north{-}
\def\gb@sign@south{}
% the dashed edge of a broken box, and the label on its later parts
\newcommand*\gb@cutline[1]{%
  \draw[gray!60,line width=.4pt,dash pattern=on 2pt off 2pt]
    (frame.#1 west)--(frame.#1 east);}
\newcommand*\gb@contlabel{%
  \gb@marginlabel{\gb@contbase}%
    {\gb@labelfont\color{gray}\gb@curlabel\\[1pt]\gb@contfont continued}}

% the heads: the label goes to the margin (drawn by the box), the note
% stays in the box, on a line of its own
\newlength{\spaceblength}
\settowidth{\spaceblength}{\bfseries\ }
\declaretheoremstyle[
  spaceabove=0pt, spacebelow=0pt,
  headindent=0pt,
  headfont=\gb@font@thmlabel,
  notefont=\gb@font@thmnote,
  notebraces={}{\\[\parskip]},
  bodyfont=\normalfont,
  headpunct={},
  postheadspace=0pt,
  headformat={\gb@setlabel{\NAME}{\NUMBER}\hskip-\spaceblength\NOTE},
  gbbox=theorem,
]{hangingtheo}
\declaretheoremstyle[
  spaceabove=0pt, spacebelow=0pt,
  headindent=0pt,
  headfont=\gb@font@thmlabel,
  notefont=\gb@font@thmnote,
  notebraces={}{\\[\parskip]},
  bodyfont=\normalfont\itshape,
  headpunct={},
  postheadspace=0pt,
  headformat={\gb@setlabel{\NAME}{\NUMBER}\hskip-\spaceblength\NOTE},
  gbbox=question,
]{hangingques}

% The tab of an example is part of the frame: a block of the accent colour in
% the corner where the top and the left rule meet, with the name and number
% in it.  The box draws it; the head only leaves room for it on the first
% line, where the title follows.
\newlength\gb@tabw
\newcommand*\gb@tabfont{\gb@font@tab}
% the tab text starts where the text of the box starts (left padding 8pt)
\def\gb@tabxsep{8pt}\def\gb@tabheight{17pt}\def\gb@tabbase{12pt}
\newcommand*\gb@tabspace{%
  \settowidth\gb@tabw{\gb@tabfont\gb@curlabel}\global\gb@tabw=\gb@tabw
  \hspace*{\dimexpr\gb@tabw+\gb@tabxsep+7pt\relax}}
% \gb@drawtabin{<colour>}: the tab in a given fill colour.  \gb@drawtab is
% the accent-coloured tab of gbbox=example, kept as it was for compatibility.
\newcommand*\gb@drawtabin[1]{%
  % the top left corner follows the rounded corner of the box
  \fill[#1] ([yshift=-\gb@tabheight]frame.north west)
    -- ([yshift=-1.5pt]frame.north west)
    arc[start angle=180,end angle=90,radius=1.5pt]
    -- ([xshift=\gb@tabw+2*\gb@tabxsep]frame.north west)
    -- ++(0pt,-\gb@tabheight+1.5pt) arc[start angle=0,end angle=-90,radius=1.5pt]
    -- cycle;
  \node[anchor=base west,inner sep=0pt,text=gbpaper]
    at ([xshift=\gb@tabxsep,yshift=-\gb@tabbase]frame.north west)
    {\gb@tabfont\gb@curlabel};}
\newcommand*\gb@drawtab{\gb@drawtabin{gbaccent}}
% a long title wraps beside the tab instead of colliding with the first line
% of the body; \gb@startbody puts the body on a line of its own after the
% head, for a box whose headpunct is empty (gbbox=example does not use this
% by default, so that old documents keep headpunct={\\[12pt]} unchanged)
\newcommand*\gb@exnote[1]{%
  \parbox[t]{\dimexpr\linewidth-\gb@tabw-2\dimexpr\gb@tabxsep\relax-7pt\relax}%
    {\raggedright#1\strut}}
\newcommand*\gb@startbody{\leavevmode\par\vspace{1pt}\@afterindentfalse\@afterheading}
\declaretheoremstyle[
  spaceabove=0pt, spacebelow=0pt,
  headindent=0pt,
  headfont=\gb@font@tab,
  notefont=\gb@font@examplenote\color{black},
  notebraces={}{},
  headpunct={\\[12pt]},
  postheadspace=0pt,
