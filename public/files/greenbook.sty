% #1 = what (for the log), #2 = function {name}{options}, #3 = user font,
% #4 = list from the preset, #5 = last resort (empty: none, keep the default)
\cs_new_protected:Npn \__gb_pick:nNnnn #1#2#3#4#5
  {
    \bool_set_false:N \l__gb_found_bool
    \tl_set:Nn \l__gb_list_tl {#4 #5}
    \tl_if_empty:nF {#3} { \tl_put_left:Nn \l__gb_list_tl { {{#3}{}} } }
    \tl_map_inline:Nn \l__gb_list_tl
      { \bool_if:NF \l__gb_found_bool { \__gb_pick_try:nNnn {#1} #2 ##1 } }
