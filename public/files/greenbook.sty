\renewcommand*{\partnumfont}{\gb@font@partname}
\renewcommand*{\printpartname}{\partnamefont Part}
\renewcommand*{\partnamenum}{~}
\renewcommand*{\printpartnum}{\partnumfont\thepart}
\renewcommand*{\parttitlefont}{\gb@font@parttitle}
% the ornament, centred on the text block (wider than it)
\newcommand*\gb@ornament{%
  \hbox to\linewidth{\hss\pgfornament[color=gbaccent,width=15cm]{87}\hss}}
\renewcommand{\midpartskip}{\par\vskip 4mm\noindent\gb@ornament\par\vskip 12mm}
\renewcommand{\beforepartskip}{\vspace*{\fill}}
\renewcommand{\afterpartskip}{\vspace*{\fill}}
\renewcommand*{\printparttitle}[1]{{\parttitlefont #1\par}\gb@partminitoc}

% Part pages are centred on the paper: \part (and \part*, \part[short])
% sets its page with margins of equal weight, then goes back to the layout
% of the book.  \spart{title} is kept from greenbook 1.x, as \part{title}.
\NewCommandCopy\gb@mempart\part
\RenewDocumentCommand\part{s o m}{%
  \newgeometry{right=2cm,left=3.7cm}%
  \IfBooleanTF{#1}{\gb@mempart*{#3}}%
    {\IfNoValueTF{#2}{\gb@mempart{#3}}{\gb@mempart[#2]{#3}}}%
  \restoregeometry}
\newcommand{\spart}[1]{\part{#1}}

% ---- the cover (\maketitle), after the part pages of artbook.sty: a page in
% the accent colour, a small logo, the title large, and author and date at
% the foot between two rules.  \subtitle{...} adds a line under the title.
% cover=false keeps memoir's \maketitle.
\colorlet{gbcoverink}{gbpaper}
\providecommand*\subtitle[1]{\gdef\gb@subtitle{#1}}
\let\gb@subtitle\@empty
\newcommand*\gb@logo{%
  \begingroup
    \@tempdima=13mm \@tempdimb=1.7mm \@tempdimc=3.8mm
    \hbox to\@tempdima{%
      \rlap{\color{gbcoverink}\vrule width\@tempdima height\@tempdima depth\z@}%
      \rlap{\hskip\@tempdimb\raise\@tempdimb\hbox{\color{gbaccent}%
        \vrule width\dimexpr\@tempdima-2\@tempdimb\relax
               height\dimexpr\@tempdima-2\@tempdimb\relax depth\z@}}%
      \rlap{\hskip\@tempdimc\raise\@tempdimc\hbox{\color{gbcoverink}%
        \vrule width\dimexpr\@tempdima-2\@tempdimc\relax
               height\dimexpr\@tempdima-2\@tempdimc\relax depth\z@}}%
      \hss}%
  \endgroup}
\newcommand*\gb@cover{%
  \clearpage
  \thispagestyle{empty}%
  \pagecolor{gbaccent}%
  \begingroup
    \let\thanks\@gobble \def\and{\\}%
    \parindent\z@ \parskip\z@ \raggedright \color{gbcoverink}%
    \vbox to\textheight{%
      \gb@logo\par
      \vskip 10mm
      {\gb@font@cover \thetitle\par}%
      \ifx\gb@subtitle\@empty\else
        \vskip 5mm {\normalfont\itshape\fontsize{17pt}{21pt}\selectfont\gb@subtitle\par}%
      \fi
      \vfill
      \hbox{\vbox{\hsize=.5\textwidth
        \hrule height 1.5pt \vskip 5mm
        {\normalfont\sffamily\fontsize{15pt}{19pt}\selectfont \theauthor\par}%
        \ifx\thedate\@empty\else
          \vskip 2mm {\normalfont\rmfamily\itshape\large \thedate\par}\fi
        \vskip 5mm \hrule height 1.5pt}}}%
  \endgroup
  % inside titlingpage the environment ends the page (with its own page
  % style); the colour is switched off once the page is out
  \ifx\@currenvir\gb@titlingenv
    \AddToHookNext{shipout/after}{\nopagecolor}%
  \else
    \clearpage\nopagecolor
  \fi}
\def\gb@titlingenv{mem@titlingpage}
\ExplSyntaxOn
\bool_if:NT \l__gb_cover_bool { \cs_set_eq:NN \maketitle \gb@cover }
\ExplSyntaxOff

