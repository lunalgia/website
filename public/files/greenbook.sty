\definecolor{goodpurple}{HTML}{420024}
\colorlet{gbaccent}{\gb@opt@accent}% key `accent'
\colorlet{gbbarink}{gbpaper}% text on the margin bar

% definition, nonexample, caution (section 8, 13): kept close to the hue of
% the hand-picked colours they replace, but brought down to the saturation
% of slategreen/hkgreen/lightslategreen (roughly 20%), so that a warm box
% reads as part of the same family instead of jumping out of it
\colorlet{gbdefpaper}{lightslategreen!28}
\definecolor{gbcaution}{HTML}{7C6850}
\definecolor{gbcautionpaper}{HTML}{F1EDE9}
\definecolor{gbplum}{HTML}{764C63}
