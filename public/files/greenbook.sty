  before skip=7pt, after skip=7pt, #1}

% indentafterbox = false: the paragraph after a box (a theorem, an example,
% a remark, the overview, a solution, the exercises) starts flush left, as
% after a heading, whether or not a blank line follows the box.  (The hook
% runs after the group of the environment, so \everypar holds.)
