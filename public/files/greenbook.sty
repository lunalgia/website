%% ======================================================================
%%  greenbook.sty  v2.0  (2026/10/19)
%%
%%  A book style for the memoir class: hanging section numbers, chapter
%%  heads under a band of colour, boxed theorems with their names in the
%%  margin, notes and footnotes in the margin, a coloured cover, and a grid
%%  table of contents (the one of artbook.sty, in the colours of this
%%  package).
%%
%%      \documentclass[a4paper,10pt,openany]{memoir}
%%      \usepackage[<options>]{greenbook}
%%
%%  Needs LuaLaTeX (or XeLaTeX) and the memoir class.  The package does not
%%  load memoir; it stops with an error when the class is something else.
%%  The full manual is greenbook-doc.pdf; the keys are listed in section 1
%%  below.
%%
%%  Sections of this file
%%     0. Checks                     8. Theorem boxes (tcolorbox)
%%     1. Options and keys           9. Grid table of contents
%%     2. Math and text fonts       10. Classic table of contents
%%     3. Page layout               11. Part pages: mini contents
%%     4. Sections and chapters     12. Exercises (option `exercises')
%%     5. Parts and the cover       13. Small environments
%%     6. Page styles               14. Other packages, \ell
%%     7. Links, notes, captions
%% ======================================================================
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{greenbook}[2026/10/19 v2.0 greenbook book style for memoir]

%% ----------------------------------------------------------------------
%%  0. Checks
%% ----------------------------------------------------------------------
\@ifclassloaded{memoir}{}{%
  \PackageError{greenbook}{greenbook needs the memoir class}%
    {Load it with \string\documentclass[a4paper,10pt,openany]{memoir}\MessageBreak
     before \string\usepackage{greenbook}.  Nothing of greenbook is loaded.}%
  \expandafter\endinput}

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{greenbook}{greenbook needs LuaLaTeX or XeLaTeX}%
    {It sets its fonts with fontspec, which pdfLaTeX cannot use.}%
\fi

%% ----------------------------------------------------------------------
%%  1. Options and keys
%%
%%  Load-time keys (in \usepackage[...]{greenbook} only):
%%     fonts      = original | garamond | libertinus | pagella | lm
%%     math       = auto | mtpro2 | newtx | unicode | cm
%%     mainfont, sansfont, monofont, chapterfont, chapnumfont, mathfont
%%                = a font name, tried before the fonts of the preset
%%     layout     = true | false     the page layout of greenbook
%%     cover      = true | false     \maketitle makes the coloured cover
%%     toc        = grid | classic   which table of contents
%%     footnotes  = margin | normal
%%     exercises  (true | false)     xsim exercises and solutions
%%     macros     (true | false)     load greenbook-macros.sty
%%     ell        (true | false)     an l in math prints \ell
%%  Keys for \greenbooksetup{...} (also allowed as package options):
%%     breakable  = true | false     may theorem boxes break across pages
%%     split      = closed | open | marked    how a broken box looks
%%     needspace  = <number>         lines that must fit before a box starts
%%     labelsep   = <length>         frame to margin label
%%     parttoc    = true | false     chapter list on part pages
%%     partextend = <length>         part titles and their rules start this far
%%                                   left of the contents grid (12mm)
%%     partskip   = <length>         more space above a part title (3mm)
%%     indentafterbox = true | false  indent the paragraph after a box (false)
%%     toclabel, tocsectionlabel, tocchapterlabel, tocfooter,
%%     tocsplit, tocsubsplit, tocpagewidth, tocpad, tocchapterpad, tocrule,
%%     tocrulegap, toctoppad, tocbottompad, tocplainpad, toctopspace,
%%     tocfootgap                    the grid table of contents (section 9)
%% ----------------------------------------------------------------------
\ExplSyntaxOn
\bool_new:N \g__gb_breakable_bool
\bool_new:N \g__gb_parttoc_bool
\bool_new:N \g__gb_marginbar_bool
\keys_define:nn { greenbook }
  {
    fonts .choices:nn       = { original, garamond, libertinus, pagella, lm }
                              { \tl_set_eq:NN \l__gb_preset_tl \l_keys_choice_tl },
    fonts .initial:n        = original,
    fonts .usage:n          = load,
    math .choices:nn        = { auto, mtpro2, newtx, unicode, cm }
                              { \tl_set_eq:NN \l__gb_math_tl \l_keys_choice_tl },
    math .initial:n         = auto,
    math .usage:n           = load,
    mainfont .tl_set:N      = \l__gb_main_tl,       mainfont .usage:n    = load,
    sansfont .tl_set:N      = \l__gb_sans_tl,       sansfont .usage:n    = load,
    monofont .tl_set:N      = \l__gb_mono_tl,       monofont .usage:n    = load,
    chapterfont .tl_set:N   = \l__gb_chapter_tl,    chapterfont .usage:n = load,
    chapnumfont .tl_set:N   = \l__gb_chapnum_tl,    chapnumfont .usage:n = load,
    mathfont .tl_set:N      = \l__gb_mathfont_tl,   mathfont .usage:n    = load,
    layout .bool_set:N      = \l__gb_layout_bool,   layout .initial:n    = true,
    layout .usage:n         = load,
    cover .bool_set:N       = \l__gb_cover_bool,    cover .initial:n     = true,
    cover .usage:n          = load,
    toc .choices:nn         = { grid, classic }
                              { \tl_set_eq:NN \l__gb_toc_tl \l_keys_choice_tl },
    toc .initial:n          = grid,
    toc .usage:n            = load,
    footnotes .choices:nn   = { margin, normal }
                              { \tl_set_eq:NN \l__gb_footnotes_tl \l_keys_choice_tl },
    footnotes .initial:n    = margin,
    footnotes .usage:n      = load,
    exercises .bool_set:N   = \l__gb_exercises_bool, exercises .usage:n = load,
    macros .bool_set:N      = \l__gb_macros_bool,    macros .usage:n    = load,
    ell .bool_set:N         = \l__gb_ell_bool,       ell .usage:n       = load,
    % ---- may be changed anywhere with \greenbooksetup
    breakable .bool_gset:N  = \g__gb_breakable_bool,
    breakable .initial:n    = true,
    split .choices:nn       = { closed, open, marked }
                              { \tl_gset_eq:NN \gb@splitstyle \l_keys_choice_tl },
    split .initial:n        = marked,
    needspace .tl_gset:N    = \gb@needlines,        needspace .initial:n = 4,
    labelsep .tl_gset:N     = \gb@labelsep,         labelsep .initial:n  = 7pt,
    parttoc .bool_gset:N    = \g__gb_parttoc_bool,  parttoc .initial:n   = false,
    indentafterbox .bool_gset:N = \g__gb_indentafterbox_bool,
    indentafterbox .initial:n = false,
    toclabel .tl_gset:N     = \gb@opt@toclabel,     toclabel .initial:n  = ,
    tocsectionlabel .tl_gset:N = \gb@opt@secword,   tocsectionlabel .initial:n = Section,
    tocchapterlabel .tl_gset:N = \gb@opt@chapword,  tocchapterlabel .initial:n = Chapter,
    tocfooter .tl_gset:N    = \gb@opt@tocfooter,    tocfooter .initial:n = \gb@doctitle,
    tocsplit .tl_gset:N     = \gb@opt@split,        tocsplit .initial:n  = 0.5\gb@tocw,
    tocsubsplit .tl_gset:N  = \gb@opt@subsplit,     tocsubsplit .initial:n = 0.25\gb@tocw,
    tocpagewidth .tl_gset:N = \gb@opt@pagewidth,    tocpagewidth .initial:n = 10mm,
    tocpad .tl_gset:N       = \gb@opt@pad,          tocpad .initial:n    = 2mm,
    tocchapterpad .tl_gset:N = \gb@opt@chpad,       tocchapterpad .initial:n = 4mm,
    tocrule .tl_gset:N      = \gb@opt@rule,         tocrule .initial:n   = 0.5pt,
    tocrulegap .tl_gset:N   = \gb@opt@rulegap,      tocrulegap .initial:n = 0.8mm,
    toctoppad .tl_gset:N    = \gb@opt@toppad,       toctoppad .initial:n = 2.6mm,
    tocbottompad .tl_gset:N = \gb@opt@botpad,       tocbottompad .initial:n = 2.2mm,
    tocplainpad .tl_gset:N  = \gb@opt@plainpad,     tocplainpad .initial:n = 2.6mm,
    toctopspace .tl_gset:N  = \gb@opt@topspace,     toctopspace .initial:n = 8mm,
    tocfootgap .tl_gset:N   = \gb@opt@footgap,      tocfootgap .initial:n = 5mm,
    tocwidth .tl_gset:N     = \gb@opt@tocwidth,
    tocwidth .initial:n     = \textwidth+\marginparsep+\marginparwidth,
    tocpartcolor .tl_gset:N = \gb@opt@tocpartcolor, tocpartcolor .initial:n = gbaccent!85,
    marginbar .bool_gset:N  = \g__gb_marginbar_bool, marginbar .initial:n = true,
    marginbarwidth .tl_gset:N = \gb@opt@barwidth,   marginbarwidth .initial:n = 7mm,
    tocchaptershift .tl_gset:N = \gb@opt@chapshift, tocchaptershift .initial:n = 1.5mm,
    partshift .tl_gset:N    = \gb@opt@partshift,    partshift .initial:n = -1.2mm,
    partgap .tl_gset:N      = \gb@opt@partgap,      partgap .initial:n = 3mm,
    partskip .tl_gset:N     = \gb@opt@partskip,     partskip .initial:n = 3mm,
    partextend .tl_gset:N   = \gb@opt@partextend,  partextend .initial:n = 12mm,
    toclabelraise .tl_gset:N = \gb@opt@toclabelraise, toclabelraise .initial:n = 5mm,
    captions .choices:nn    = { margin, below }
                              { \tl_gset_eq:NN \gb@opt@captions \l_keys_choice_tl },
    captions .initial:n     = margin,
    accent .code:n          = { \tl_gset:Nn \gb@opt@accent {#1}
                                \cs_if_exist:NT \colorlet { \colorlet{gbaccent}{#1} } },
    accent .initial:n       = slategreen,
  }
%% ----------------------------------------------------------------------
%%  Fonts of the parts of the page.  Two levels:
%%    headingfont, labelfont, displayfont, numberfont
%%        the four families the parts are set in (sans headings, small
%%        letter-spaced labels, chapter titles, chapter numbers); change
%%        one and every part that uses it follows, at the same sizes
%%    <part>font and <part>size, for each part listed below
%%        the family / series / shape of that part, and its size
%% ----------------------------------------------------------------------
\keys_define:nn { greenbook }
  {
    headingfont .tl_gset:N = \gb@family@heading,
    headingfont .initial:n = \normalfont\sffamily,
    labelfont .tl_gset:N   = \gb@family@label,
    labelfont .initial:n   = {\normalfont\ttfamily
                             \gbfontelse{DINdong}[LetterSpace=8]{\addfontfeature{LetterSpace=10}}},
    displayfont .tl_gset:N = \gb@family@display,
    displayfont .initial:n = \normalfont\chapterfont,
    numberfont .tl_gset:N  = \gb@family@number,
    numberfont .initial:n  = \normalfont\chapternumfont,
  }
\cs_new_protected:Npn \__gb_role:nnnn #1#2#3#4
  { % #1 = key stem, #2 = internal name, #3 = family, #4 = size
    \keys_define:nn { greenbook }
      {
        #1font .tl_gset:c = { gb@f@#2 },
        #1font .initial:n = {#3},
        #1size .tl_gset:c = { gb@s@#2 },
        #1size .initial:n = {#4},
      }
    \cs_gset_nopar:cpn { gb@font@#2 } { \use:c { gb@f@#2 } \use:c { gb@s@#2 } }
  }
\__gb_role:nnnn {chaptertitle} {chaptitle} {\gb@family@display} {\fontsize{36pt}{44pt}\selectfont}
\__gb_role:nnnn {chapternumber} {chapnum} {\gb@family@number} {\fontsize{144pt}{150pt}\selectfont}
\__gb_role:nnnn {section} {section} {\gbfontelse{Jost~Light}{\gb@family@heading}} {\Large}
\__gb_role:nnnn {subsection} {subsection} {\gbfontelse{Jost~Light}{\gb@family@heading}} {\large}
\__gb_role:nnnn {secnumber} {secnum} {\gbfontelse{DINdong}{\use:c{gb@f@section}}} {}
\__gb_role:nnnn {partname} {partname} {\normalfont} {\LARGE}
\__gb_role:nnnn {parttitle} {parttitle} {\normalfont\itshape} {\Huge}
\__gb_role:nnnn {header} {header} {\normalfont\itshape} {}
\__gb_role:nnnn {headerpage} {headerpage} {\normalfont\bfseries} {}
\__gb_role:nnnn {thmlabel} {thmlabel} {\gbfontelse{Jost~Medium}{\gb@family@heading\bfseries}} {}
\__gb_role:nnnn {thmnote} {thmnote} {\gbfontelse{Jost~Medium}{\gb@family@heading\bfseries}} {}
\__gb_role:nnnn {tab} {tab} {\gbfontelse{Jost~Medium}{\gb@family@heading\bfseries}} {}
\__gb_role:nnnn {examplenote} {examplenote} {\normalfont\bfseries} {}
\__gb_role:nnnn {remarkhead} {remarkhead} {\gbfontelse{Jost~Medium}{\gb@family@heading\bfseries}} {}
\__gb_role:nnnn {captionlabel} {captionlabel} {\gbfontelse{Jost~Medium}{\gb@family@heading}} {\footnotesize}
\__gb_role:nnnn {caption} {caption} {\normalfont} {\footnotesize}
\__gb_role:nnnn {note} {note} {\normalfont} {\small}
\__gb_role:nnnn {toclabel} {toclabel} {\gb@family@label} {\fontsize{7pt}{8pt}\selectfont}
\__gb_role:nnnn {tocnumber} {tocnumber} {\use:c{gb@f@toclabel}} {\fontsize{6pt}{8pt}\selectfont}
\__gb_role:nnnn {tocpart} {tocpart} {\gbfontelse{PP~Mori~Semibold}[Scale=0.95]{\gb@family@heading\bfseries}} {\fontsize{20pt}{22pt}\selectfont}
\__gb_role:nnnn {toctitle} {toctitle} {\normalfont\rmfamily} {\fontsize{9pt}{11pt}\selectfont}
\__gb_role:nnnn {tocpage} {tocpage} {\normalfont\rmfamily} {\fontsize{9pt}{11pt}\selectfont}
\__gb_role:nnnn {marginbar} {marginbar} {\gb@family@label} {\fontsize{7pt}{8pt}\selectfont}
\__gb_role:nnnn {cover} {cover} {\gb@family@display} {\fontsize{48pt}{52pt}\selectfont}
\ProcessKeyOptions [ greenbook ]
\NewDocumentCommand \greenbooksetup { m } { \keys_set:nn { greenbook } {#1} }
% \gbfont{<family>}[<features>]: a font switch to any installed font, for
% the font keys, e.g. \greenbooksetup{headingfont={\gbfont{PP Mori}}}.  The
% size comes from the size keys; [Scale=...] or [Scale=MatchLowercase] in
% <features> adjusts a font whose letters are larger or smaller than usual.
% A font that is not installed is reported once and the current font is
% kept (fontspec alone would stop the run when the font is first used).
\cs_new_protected:Npn \__gb_fontspec:nnn #1#2#3
  { \fontspec{#1}[#2#3] }
\NewDocumentCommand \gbfont { m O{} }
  {
    \cs_if_exist:cF { g__gb_font_ #1 _bool }
      {
        \bool_new:c { g__gb_font_ #1 _bool }
        \tl_gclear_new:c { g__gb_font_ #1 _bold_tl }
        \IfFontExistsTF {#1}
          {
            \bool_gset_true:c { g__gb_font_ #1 _bool }
            % a family without a "Bold" face (PP Mori, Inter Display, ...):
            % \bfseries takes its Semibold, SemiBold or Medium face
            \IfFontExistsTF { #1~Bold } { }
              {
                \clist_map_inline:nn { Semibold, SemiBold, Medium, Black }
                  {
                    \tl_if_empty:cT { g__gb_font_ #1 _bold_tl }
                      {
                        \IfFontExistsTF { #1~##1 }
                          { \tl_gset:cn { g__gb_font_ #1 _bold_tl } { BoldFont = {#1~##1}, } }
                          { }
                      }
                  }
              }
          }
          {
            \PackageWarning{greenbook}
              { Font~`#1'~is~not~installed~(or~not~under~this~name);\MessageBreak
                \string\gbfont\space keeps~the~current~font.\MessageBreak
                Check~the~name~with:~luaotfload-tool~--find="#1" }
          }
      }
    \bool_if:cT { g__gb_font_ #1 _bool }
      { \exp_args:Nnx \__gb_fontspec:nnn {#1} { \tl_use:c { g__gb_font_ #1 _bold_tl } } {#2} }
  }
% \gbfontelse{<family>}[<features>]{<fallback>}: \gbfont when the font is
% installed, otherwise <fallback> (and no warning).  The defaults of the
% font keys use it, so greenbook looks the same without the fonts.
\NewDocumentCommand \gbfontelse { m O{} m }
  { \IfFontExistsTF {#1} { \gbfont {#1} [#2] } {#3} }
\cs_new:Npn \gb@ifbreakable { \bool_if:NTF \g__gb_breakable_bool }
\cs_new:Npn \gb@ifparttoc  { \bool_if:NTF \g__gb_parttoc_bool }
\cs_new:Npn \gb@ifmarginbar { \bool_if:NTF \g__gb_marginbar_bool }
\ExplSyntaxOff

%% ----------------------------------------------------------------------
%%  2. Math and text fonts
%%
%%  Each font is the first of a list that is installed: the font given by
%%  its key, then the fonts of the preset, then fonts that come with every
%%  TeX Live.  The log says which font was taken ("greenbook: main font").
%%  The math setup is chosen the same way, before fontspec is loaded:
%%     mtpro2   MathTime Pro 2 lite (the original look; not in TeX Live)
%%     newtx    newtxmath
%%     unicode  unicode-math with an OpenType math font
%%     cm       Latin Modern / Computer Modern math
%% ----------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \g_gb_mathmode_tl        % the math setup that was chosen
\tl_new:N \g_gb_mathfont_tl        % its OpenType font (unicode only)
\bool_new:N \l__gb_found_bool

% math choices per preset: items are  {mtpro2}  {newtx}  {cm}  or
% {unicode}{<font name>}{<file the font is in>}
\cs_generate_variant:Nn \str_case:nnF { V }
\cs_generate_variant:Nn \str_case:nn { V }
\cs_generate_variant:Nn \prop_item:Nn { NV }
\prop_const_from_keyval:Nn \c__gb_mathchain_prop
  {
    original   = {{{mtpro2}{}{}}{{unicode}{Garamond-Math}{Garamond-Math.otf}}
                 {{newtx}{}{}}{{unicode}{Latin~Modern~Math}{latinmodern-math.otf}}},
    garamond   = {{{unicode}{Garamond-Math}{Garamond-Math.otf}}{{newtx}{}{}}
                 {{unicode}{Latin~Modern~Math}{latinmodern-math.otf}}},
    libertinus = {{{unicode}{Libertinus~Math}{LibertinusMath-Regular.otf}}
                 {{unicode}{Latin~Modern~Math}{latinmodern-math.otf}}},
    pagella    = {{{unicode}{TeX~Gyre~Pagella~Math}{texgyrepagella-math.otf}}
                 {{unicode}{Latin~Modern~Math}{latinmodern-math.otf}}},
    lm         = {{{unicode}{Latin~Modern~Math}{latinmodern-math.otf}}{{cm}{}{}}},
  }

% is an OpenType font file installed?  (kpathsea under LuaTeX; XeTeX only
% sees the files that TeX itself can find)
\sys_if_engine_luatex:TF
  {
    \prg_new_protected_conditional:Npnn \__gb_fontfile_if_exist:n #1 { T }
      {
        \tl_set:Ne \l__gb_tmp_tl
          { \lua_now:e { tex.sprint(kpse.find_file("\lua_escape:e{#1}","opentype~fonts")~or~"") } }
        \tl_if_empty:NTF \l__gb_tmp_tl { \prg_return_false: } { \prg_return_true: }
      }
  }
  {
    \prg_new_protected_conditional:Npnn \__gb_fontfile_if_exist:n #1 { T }
      { \file_if_exist:nTF {#1} { \prg_return_true: } { \prg_return_false: } }
  }
\cs_new_protected:Npn \__gb_math_try:nnn #1#2#3
  {
    \bool_if:NF \l__gb_found_bool
      {
        \str_case:nn {#1}
          {
            {mtpro2}  { \file_if_exist:nT { mtpro2.sty }
                          { \bool_set_true:N \l__gb_found_bool } }
            {newtx}   { \file_if_exist:nT { newtxmath.sty }
                          { \bool_set_true:N \l__gb_found_bool } }
            {cm}      { \bool_set_true:N \l__gb_found_bool }
            {unicode} { \__gb_fontfile_if_exist:nT {#3}
                          { \bool_set_true:N \l__gb_found_bool } }
          }
        \bool_if:NT \l__gb_found_bool
          {
            \tl_gset:Nn \g_gb_mathmode_tl {#1}
            \tl_gset:Nn \g_gb_mathfont_tl {#2}
          }
      }
  }
\cs_new_protected:Npn \__gb_math_choose:
  {
    \bool_set_false:N \l__gb_found_bool
    \tl_set:Nx \l__gb_chain_tl { \prop_item:NV \c__gb_mathchain_prop \l__gb_preset_tl }
    \str_case:VnF \l__gb_math_tl
      {
        {auto}    { \tl_if_empty:NF \l__gb_mathfont_tl
                      { \tl_gset:Nn \g_gb_mathmode_tl {unicode}
                        \tl_gset_eq:NN \g_gb_mathfont_tl \l__gb_mathfont_tl
                        \bool_set_true:N \l__gb_found_bool }
                    \tl_map_inline:Nn \l__gb_chain_tl { \__gb_math_try:nnn ##1 } }
        {unicode} { \tl_if_empty:NTF \l__gb_mathfont_tl
                      { \tl_map_inline:Nn \l__gb_chain_tl
                          { \__gb_math_unicode_only:nnn ##1 } }
                      { \tl_gset:Nn \g_gb_mathmode_tl {unicode}
                        \tl_gset_eq:NN \g_gb_mathfont_tl \l__gb_mathfont_tl
                        \bool_set_true:N \l__gb_found_bool } }
      }
      { \exp_args:NV \__gb_math_try:nnn \l__gb_math_tl {} {} }
    \bool_if:NF \l__gb_found_bool
      {
        \PackageWarningNoLine{greenbook}
          {math~=~\l__gb_math_tl\space is~not~installed;~using~Latin~Modern}
        \tl_gset:Nn \g_gb_mathmode_tl {unicode}
        \tl_gset:Nn \g_gb_mathfont_tl {Latin~Modern~Math}
      }
    \PackageInfo{greenbook}{math:~\g_gb_mathmode_tl\space\g_gb_mathfont_tl}
  }
\cs_new_protected:Npn \__gb_math_unicode_only:nnn #1#2#3
  { \str_if_eq:nnT {#1} {unicode} { \__gb_math_try:nnn {#1}{#2}{#3} } }
\__gb_math_choose:

