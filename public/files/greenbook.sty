%% ----------------------------------------------------------------------
%%  4. Sections and chapters
%%
%%  Every chapter head (numbered, \chapter*, front and back matter) has the
%%  same parts:
%%
%%    ===================================================  band at the top
%%                                                          of the paper
%%    Title of the chapter, set as wide as        ____
%%    the text and the margin allow                 /     number in the
%%    ___________________________________________ /___    margin, standing
%%                                                         on the rule
%%  An unnumbered head has no number; its title may then use the full width.
%%  Everything is placed in boxes of the width of the text, so nothing is
%%  reported as overfull.
%% ----------------------------------------------------------------------
\setcounter{secnumdepth}{2}

% the text and the margin column together (where heads and rules end)
\newcommand*\gb@fullwidth{\dimexpr\linewidth+\marginparsep+\marginparwidth\relax}

% section numbers hang in the left margin
\setsechook{\hangsecnum}
\renewcommand{\hangsecnum}{%
  \def\@seccntformat##1{%
    \makebox[0pt][r]{\gb@font@secnum\color{gray}\csname the##1\endcsname\hspace{.6em}}}}

% a section title stands above a hairline
\colorlet{gbheading}{slategreen!80!black}
% (the colour is set inside a group, so that it ends with the title)
\newcommand*\ruledsec[1]{%
  {\gb@font@section\color{gbheading}#1\par}%
  \nobreak\vskip 5pt
  \hrule width\linewidth height .1pt}
\setsecheadstyle{\ruledsec}
\setbeforesecskip{-6ex \@plus -1ex \@minus -.4ex}
\setaftersecskip{2.4ex \@plus .2ex}
\newcommand*\gb@subsechead[1]{{\gb@font@subsection\color{gbheading}#1\par}}
\setsubsecheadstyle{\gb@subsechead}
\setbeforesubsecskip{-4.5ex \@plus -1ex \@minus -.3ex}
\setaftersubsecskip{2.2ex \@plus .2ex}

% ---- chapter heads
\newlength\gb@bandheight   \setlength\gb@bandheight{9pt}
\newlength\gb@chapnumgap   \setlength\gb@chapnumgap{1em}
\newlength\gb@chaprulegap  \setlength\gb@chaprulegap{6pt}
\newlength{\chnumsep}% (greenbook 1.x; no longer used)
\let\gb@chapnum\@empty

% the band: a zero-height box whose rule is raised to the top of the paper
\newcommand*\gb@chapband{%
  \par\nointerlineskip
  \hbox to\linewidth{%
    \hskip-\dimexpr1in+\hoffset+\oddsidemargin+1cm\relax
    \smash{\raise\dimexpr1in+\voffset+\topmargin+\headheight+\headsep
                     +\topskip-\gb@bandheight\relax
      \hbox{\color{gbaccent}%
        \vrule width\dimexpr\stockwidth+2cm\relax height\gb@bandheight depth\z@}}%
    \hss}%
  \nointerlineskip}

% title, number and rule.  #1 = title
\newcommand*\gb@chaphead[1]{%
  \setbox\z@\hbox{{\chapnumfont\gb@chapnum}}% (inner group: the colour ends in the box)
  \dimen@=\dimexpr\gb@fullwidth-\wd\z@\relax
  \ifdim\wd\z@>\z@ \advance\dimen@-\gb@chapnumgap \fi
  \dimen@ii=\dp\z@
  \noindent
  \hbox to\linewidth{%
    \rlap{\parbox[b]{\dimen@}{\chaptitlefont\RaggedRight
      \hyphenpenalty\@M \exhyphenpenalty\@M #1\par}}%
    \hskip\dimexpr\gb@fullwidth-\wd\z@\relax \box\z@
    \hss}\par
  \nointerlineskip
  \vskip\ifdim\dimen@ii>\gb@chaprulegap\dimen@ii\else\gb@chaprulegap\fi
  \hbox to\linewidth{{\color{gbaccent}\vrule width\gb@fullwidth height 2pt}\hss}}

\makechapterstyle{greenbook}{%
  \renewcommand*{\chapnumfont}{\gb@font@chapnum\color{gbaccent}}%
  \renewcommand*{\chaptitlefont}{\gb@font@chaptitle\color{black}}%
  \setlength{\beforechapskip}{0pt}%
  \setlength{\afterchapskip}{30pt}%
  \renewcommand*{\chapterheadstart}{\gb@chapband}%
  \renewcommand*{\printchaptername}{}%
  \renewcommand*{\chapternamenum}{}%
  \renewcommand*{\printchapternum}{\def\gb@chapnum{\thechapter}}%
  \renewcommand*{\afterchapternum}{}%
  \renewcommand*{\printchapternonum}{\let\gb@chapnum\@empty}%
  \renewcommand*{\printchaptertitle}[1]{\gb@chaphead{##1}}%
  \renewcommand*{\afterchaptertitle}{\par\nobreak\vskip\afterchapskip}%
}
\makechapterstyle{custom}{\chapterstyle{greenbook}}% the name in greenbook 1.x
\chapterstyle{greenbook}

