%%  3. Page layout  (layout=false leaves memoir's layout alone)
%%
%%  The design is one-sided: every page has the narrow margin on the left
%%  and the wide margin, which holds notes, footnotes and theorem labels,
%%  on the right.  twoside is therefore switched off.
%% ----------------------------------------------------------------------
\RequirePackage{geometry}
