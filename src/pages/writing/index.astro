---
/**
 * Writings: the newest piece large, then everything as one numbered list,
 * filterable by kind. Posts are Markdown/MDX files in src/content/writing.
 */
import { Image } from 'astro:assets'
import Base from '@/layouts/Base.astro'
import { emphasize, getPosts, wordCount } from '@/lib/utils'
import { WRITING_KINDS } from '@/content.config'
import lilyPale from '@/assets/home/lily-pale.png'

const posts = await getPosts()
const latest = posts[0]
const kinds = (Object.keys(WRITING_KINDS) as (keyof typeof WRITING_KINDS)[]).filter((k) => posts.some((p) => p.data.kind === k))
const date = (d: Date, long = false) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: long ? 'long' : 'short', year: 'numeric' }).toUpperCase()
const pad = (n: number) => String(n).padStart(2, '0')
const one = (k: string) => WRITING_KINDS[k as keyof typeof WRITING_KINDS].label.replace(/s$/, '').toLowerCase()
---

<Base title="Writings" description="Essays, notes and a journal.">
  <header class="wh">
    <h1 class="wh__t">Writings</h1>
    <nav class="wh__nav" aria-label="filter by kind">
      <button type="button" class="is-on" data-kind="">(all)</button>
      {kinds.map((k) => <button type="button" data-kind={k}>({WRITING_KINDS[k].label.toLowerCase()})</button>)}
      <a href="/rss.xml">(rss ↗)</a>
    </nav>
    <p class="wh__lede">
      Essays, notes and a journal. Essays are finished and argued to the end; notes are thinking out loud; the
      journal is days as they happened.
    </p>
  </header>

  {
    latest && (
      <a class="feat" href={`/writing/${latest.id}`}>
        {
          latest.data.image ? (
            <Image src={latest.data.image} alt="" widths={[700, 1100, 1500]} sizes="(min-width: 900px) 52vw, 92vw" class="feat__img" loading="eager" />
          ) : (
            // no picture of its own: the pale lily on the deep lavender of the Writings panel
            <span class="feat__img feat__lily">
              <Image src={lilyPale} alt="" widths={[600, 1000, 1334]} sizes="(min-width: 900px) 46vw, 82vw" loading="eager" />
            </span>
          )
        }
        <div class="feat__txt">
          <p class="k">
            LATEST · {one(latest.data.kind).toUpperCase()}{latest.data.author && ` · BY ${latest.data.author.toUpperCase()}`} · {date(latest.data.date, true)}
          </p>
          <h2 set:html={emphasize(latest.data.title)} />
          {latest.data.description && <p class="feat__d">{latest.data.description}</p>}
          <p class="k">
            {wordCount(latest.body).toLocaleString('en-GB')} WORDS · {Math.max(1, Math.round(wordCount(latest.body) / 230))} MIN
          </p>
        </div>
      </a>
    )
  }

  <section class="ws" aria-label="everything">
    <header class="ws__top"><span>I · EVERYTHING</span><span class="ws__count">{pad(posts.length)}</span></header>
    <ol class="wl" role="list">
      {
        posts.map((p, i) => (
          <li data-kind={p.data.kind}>
            <a class="we" href={`/writing/${p.id}`}>
              <span class="we__n">{pad(posts.length - i)}</span>
              <span class="we__t" set:html={emphasize(p.data.title)} />
              {p.data.description && <span class="we__d">{p.data.description}</span>}
              <span class="we__m">
                <span class="chip">{one(p.data.kind)}</span>
                {p.data.author && `BY ${p.data.author.toUpperCase()} · `}{date(p.data.date)} · {wordCount(p.body).toLocaleString('en-GB')} WORDS
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  const setup = () => {
    const nav = document.querySelector<HTMLElement>('.wh__nav')
    if (!nav || nav.dataset.ready) return
    nav.dataset.ready = '1'
    const rows = [...document.querySelectorAll<HTMLElement>('.wl li')]
    const count = document.querySelector('.ws__count')!
    nav.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-kind]')
      if (!b) return
      const k = b.dataset.kind
      nav.querySelectorAll('button').forEach((x) => x.classList.toggle('is-on', x === b))
      let n = 0
      rows.forEach((r) => {
        r.hidden = !!k && r.dataset.kind !== k
        if (!r.hidden) n++
      })
      count.textContent = String(n).padStart(2, '0')
    })
  }
  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .wh {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 3rem;
    align-items: end;
    padding: 7rem 4vw 0;
    color: var(--ultramarine);
  }
  .wh__t {
    margin: 0;
    font: 400 clamp(4rem, 11vw, 10rem) / 0.9 var(--font-din);
  }
  .wh__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font: 400 0.72rem/1.4 var(--font-din); letter-spacing: 0.16em; text-transform: uppercase; font-style: normal;
  }
  .wh__nav button,
  .wh__nav a {
    all: unset;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  .wh__nav a {
    opacity: 1;
  }
  .wh__nav button:hover,
  .wh__nav .is-on {
    opacity: 1;
  }
  .wh__nav .is-on,
  .wh__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .wh__lede {
    grid-column: 1 / -1;
    max-width: 36rem;
    font: 1.2rem/1.5 var(--font-body);
    color: #11135a;
  }

  .k {
    font: 0.7rem var(--font-din);
    letter-spacing: 0.18em;
  }
  .feat {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4vw;
    align-items: end;
    padding: 4rem 4vw 0;
    color: var(--ultramarine);
    text-decoration: none;
  }
  .feat__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    box-shadow: 0 30px 60px -36px rgb(17 19 90 / 0.8);
    transition: filter 0.6s;
  }
  .feat:hover .feat__img {
    filter: saturate(1.15);
  }
  .feat__lily {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--lavender-deep);
  }
  .feat__lily :global(img) {
    width: 86%;
    height: auto;
    translate: 3% 4%;
    transition: scale 0.9s var(--ease-out);
  }
  .feat:hover .feat__lily :global(img) {
    scale: 1.03;
  }
  .feat h2 {
    margin: 1rem 0;
    font: 400 clamp(3rem, 6vw, 6rem) / 0.95 var(--font-display);
    letter-spacing: -0.02em;
    transition: translate 0.5s var(--ease-out);
  }
  .feat:hover h2 {
    translate: 0.5rem 0;
  }
  .feat h2 :global(em),
  .we__t :global(em) {
    font-style: italic;
  }
  .feat__d {
    margin-bottom: 1.4rem;
    font: italic 1.35rem/1.35 var(--font-body);
    color: #11135a;
  }

  .ws {
    padding: 5rem 4vw 6rem;
    color: var(--ultramarine);
  }
  .ws__top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1.5px solid var(--ultramarine);
    font: 0.75rem var(--font-din);
    letter-spacing: 0.18em;
  }
  .wl li[hidden] {
    display: none;
  }
  .we {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    grid-template-areas: 'n t m' 'n d m';
    gap: 0.3rem 2rem;
    align-items: baseline;
    padding: 1.8rem 0;
    border-bottom: 1px solid rgb(2 8 135 / 0.3);
    text-decoration: none;
  }
  .we__n {
    grid-area: n;
    font: 0.75rem var(--font-din);
    letter-spacing: 0.16em;
  }
  .we__t {
    grid-area: t;
    font: 400 clamp(2.2rem, 4vw, 3.6rem) / 1 var(--font-display);
    letter-spacing: -0.01em;
    transition: translate 0.5s var(--ease-out);
  }
  .we:hover .we__t {
    translate: 0.6rem 0;
  }
  .we__d {
    grid-area: d;
    font: italic 1.15rem var(--font-body);
    color: #11135a;
  }
  .we__m {
    grid-area: m;
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font: 0.66rem var(--font-din);
    letter-spacing: 0.16em;
  }
  .chip {
    padding: 0.3rem 0.6rem;
    border: 1px solid rgb(2 8 135 / 0.45);
    text-transform: uppercase;
  }
  @media (max-width: 860px) {
    .wh,
    .feat {
      grid-template-columns: 1fr;
    }
    .we {
      grid-template-columns: 2.6rem 1fr;
      grid-template-areas: 'n t' 'n d' 'n m';
    }
  }
</style>
