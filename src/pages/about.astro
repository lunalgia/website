---
/**
 * About: a few paragraphs from src/data/about.md, set as a single quiet column,
 * then the credits from src/data/credits.ts. The CV is a link in the header and
 * in the text (which gets the usual PDF preview card on hover).
 */
import Base from '@/layouts/Base.astro'
import Flip from '@/components/Flip.astro'
import { frontmatter as about, Content as About } from '@/data/about.md'
import { credits } from '@/data/credits'

// entries still waiting for a source stay out of the page
const groups = credits.map((g) => ({ ...g, entries: g.entries.filter((e) => !e.todo) })).filter((g) => g.entries.length)
---

<Base title="About" description="A little more about me, my CV, and credits for what the site is made from.">
  <header class="abh">
    <h1 class="abh__t" aria-label="About"><Flip word="About" to="Lilian" /></h1>
    <nav class="abh__nav" aria-label="links">
      <a href="#credits">(credits)</a>
      <a href="/files/cv.pdf" target="_blank" rel="noopener">(cv ↗)</a>
    </nav>
    {about.lede && <p class="abh__lede">{about.lede}</p>}
  </header>

  <section class="ab" aria-label="about">
    <div class="ab__text">
      <About />
    </div>
  </section>

  <section class="cr" id="credits" aria-labelledby="credits-h">
    <header class="cr__top">
      <h2 id="credits-h">CREDITS</h2>
      <span>WITH THANKS</span>
    </header>
    {
      groups.map((g) => (
        <section class="cr__group">
          <h3 class="cr__h">{g.heading}</h3>
          <ul class="cr__entries" role="list">
            {g.entries.map((e) => (
              <li class="cr__entry">
                <span class="cr__what">
                  {e.href ? (
                    <a href={e.href} target="_blank" rel="noopener">
                      {e.what}
                    </a>
                  ) : (
                    e.what
                  )}
                </span>
                <span class="cr__body">
                  {e.by && <span class="cr__by">{e.by}</span>}
                  {e.note && <span class="cr__note">{e.note}</span>}
                </span>
                {e.license && <span class="cr__lic">{e.license}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

<script>
  // A redaction with data-reveal comes off on hover, focus or a tap and goes back on when
  // you leave. The two texts are one set of letters: each scribble turns into its own
  // letter in place, sweeping left to right; then the reveal's new spaces open up and any
  // letter that changes case turns over. Set up on every arrival: the site swaps pages
  // without reloading.
  const esc = (c: string) => (c === ' ' ? '\u00a0' : c.replace(/[&<>"]/g, (x) => `&#${x.charCodeAt(0)};`))
  const build = (from: string, to: string) => {
    let html = ''
    let i = 0
    let k = 0
    for (const c of to) {
      const f = from[i]
      if (f !== undefined && f.toLowerCase() === c.toLowerCase()) {
        const swap = f !== c
        html += `<span class="rd__l${swap ? ' rd__l--swap' : ''}" style="--i:${k}"><span class="rd__ink" aria-hidden="true">${esc(f)}</span><span class="rd__a">${esc(f)}</span>${swap ? `<span class="rd__b">${esc(c)}</span>` : ''}</span>`
        i++
        k++
      } else if (c === ' ') html += '<span class="rd__gap"></span>'
      else return null
    }
    return i === from.length ? { html, n: k } : null
  }
  document.addEventListener('astro:page-load', () => {
    for (const el of document.querySelectorAll<HTMLElement>('.ab__text .redacted[data-reveal]')) {
      const from = el.textContent ?? ''
      const to = el.dataset.reveal!
      const built = build(from, to)
      // only a reveal made of the same letters (new spaces, other cases) can be animated
      if (!built) continue
      const rd = document.createElement('span')
      rd.className = 'rd'
      rd.tabIndex = 0
      rd.setAttribute('role', 'button')
      rd.setAttribute('aria-label', 'redacted; reveal it')
      rd.style.setProperty('--n', String(built.n))
      rd.innerHTML = built.html
      el.replaceWith(rd)
      // each scribble is squeezed to its letter's width, so nothing moves as they swap;
      // a letter that changes case eases between the two widths
      document.fonts.ready.then(() => {
        for (const l of rd.querySelectorAll<HTMLElement>('.rd__l')) {
          const ink = l.querySelector<HTMLElement>('.rd__ink')!
          const a = l.querySelector<HTMLElement>('.rd__a')!
          const b = l.querySelector<HTMLElement>('.rd__b')
          l.style.setProperty('--fit', String(a.offsetWidth / Math.max(1, ink.offsetWidth)))
          if (b) {
            l.style.setProperty('--wa', `${a.offsetWidth}px`)
            l.style.setProperty('--wb', `${b.offsetWidth}px`)
          }
        }
      })
      const sweep = (built.n - 1) * 32 + 380
      let t = 0
      const open = (on: boolean) => {
        clearTimeout(t)
        if (on) {
          rd.classList.add('is-open')
          rd.setAttribute('aria-label', to)
          t = window.setTimeout(() => rd.classList.add('is-turned'), rd.classList.contains('is-turned') ? 0 : sweep)
        } else {
          const turned = rd.classList.contains('is-turned')
          rd.classList.remove('is-turned')
          rd.setAttribute('aria-label', 'redacted; reveal it')
          t = window.setTimeout(() => rd.classList.remove('is-open'), turned ? 420 : 0)
        }
      }
      // a mouse reveals while it is over; a finger toggles
      rd.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && open(true))
      rd.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && open(false))
      rd.addEventListener('focus', () => open(true))
      rd.addEventListener('blur', () => open(false))
      rd.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') return
        open(!rd.classList.contains('is-open'))
      })
    }
  })
</script>

<style>
  .abh {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 3rem;
    align-items: end;
    padding: 7rem 4vw 0;
    color: var(--ultramarine);
  }
  .abh__t {
    margin: 0;
    font: 400 clamp(5rem, 12vw, 11rem) / 0.9 var(--font-din);
  }
  .abh__nav {
    display: flex;
    gap: 1.6rem;
    font: 400 0.72rem/1.4 var(--font-din);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .abh__nav a {
    text-decoration: none;
  }
  .abh__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .abh__lede {
    grid-column: 1 / -1;
    max-width: 34rem;
    font: 1.2rem/1.5 var(--font-body);
    color: #11135a;
  }

  .ab {
    padding: 3.5rem 4vw 7rem;
    border-top: 0;
  }
  /* the whole width, in two columns once there is room for two good measures */
  .ab__text {
    columns: 2 26rem;
    column-gap: 4vw;
    column-rule: 1px solid var(--rule);
    padding-top: 3rem;
    border-top: 1.5px solid var(--ultramarine);
    font: 1.3rem/1.6 var(--font-body);
    color: var(--ink);
    hyphens: auto;
  }
  .ab__text :global(p) {
    margin: 0 0 1em;
    text-wrap: pretty;
    break-inside: avoid-column;
  }
  .ab__text :global(p:first-child::first-letter) {
    float: left;
    padding: 0.04em 0.08em 0 0;
    font: 4.6em/0.82 var(--font-display);
    color: var(--ultramarine);
  }
  /* words set as if blacked out */
  @font-face {
    font-family: 'Redacted Script';
    src: url('/fonts/RedactedScript-Light.ttf') format('truetype');
    font-display: block;
  }
  .ab__text :global(.redacted) {
    font: 1.5em/1 'Redacted Script', var(--font-body);
    white-space: nowrap;
  }
  /* a redaction that comes off: each scribble lifts away as its own letter rises into
     place, left to right; then new spaces open and a letter that changes case turns over */
  .ab__text :global(.rd) {
    white-space: nowrap;
    perspective: 600px;
    cursor: pointer;
    outline-offset: 3px;
  }
  .ab__text :global(.rd__l) {
    position: relative;
    display: inline-block;
  }
  .ab__text :global(.rd__ink) {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    transform-origin: left center;
    scale: var(--fit, 1) 1;
    font: 1.5em/1 'Redacted Script', var(--font-body);
    pointer-events: none;
  }
  .ab__text :global(.rd__a),
  .ab__text :global(.rd__b) {
    display: inline-block;
    backface-visibility: hidden;
    transform-origin: 50% 50% -0.35em;
  }
  .ab__text :global(.rd__a) {
    opacity: 0;
    translate: 0 0.3em;
  }
  /* the sweep: on the way in left to right, on the way out right to left */
  .ab__text :global(.rd__ink),
  .ab__text :global(.rd__a) {
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.38s var(--ease-out),
      transform 0.4s var(--ease-out);
    transition-delay: calc((var(--n) - 1 - var(--i)) * 22ms);
  }
  .ab__text :global(.rd.is-open .rd__ink) {
    opacity: 0;
    translate: 0 calc(-50% - 0.3em);
    transition-delay: calc(var(--i) * 32ms);
  }
  .ab__text :global(.rd.is-open .rd__a) {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i) * 32ms);
  }
  /* a letter that changes case: both forms in one place, the box easing between widths */
  .ab__text :global(.rd__l--swap) {
    display: inline-grid;
    width: var(--wa, auto);
    transition: width 0.4s var(--ease-out);
  }
  .ab__text :global(.rd__l--swap > :not(.rd__ink)) {
    grid-area: 1 / 1;
    justify-self: start;
  }
  .ab__text :global(.rd__b) {
    transform: rotateX(-90deg);
    opacity: 0;
    transition:
      transform 0.4s var(--ease-out),
      opacity 0.4s var(--ease-out);
  }
  .ab__text :global(.rd.is-turned .rd__l--swap) {
    width: var(--wb, auto);
  }
  .ab__text :global(.rd.is-turned .rd__l--swap .rd__a) {
    transform: rotateX(90deg);
    opacity: 0;
    transition-delay: 0s;
  }
  .ab__text :global(.rd.is-turned .rd__b) {
    transform: none;
    opacity: 1;
  }
  /* the spaces the reveal adds, opening from nothing */
  .ab__text :global(.rd__gap) {
    display: inline-block;
    width: 0;
    transition: width 0.4s var(--ease-out);
  }
  .ab__text :global(.rd.is-turned .rd__gap) {
    width: 0.26em;
  }
  @media (prefers-reduced-motion: reduce) {
    .ab__text :global(.rd *) {
      transition: none !important;
    }
  }
  /* parentheticals a step quieter than the sentence, as in .prose (src/styles/prose.css) */
  .ab__text :global([data-parenthetical]) {
    color: color-mix(in oklab, var(--ink) 60%, var(--bg));
  }
  .ab__text :global(a) {
    color: var(--ultramarine);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  /* credits: a ledger under the letter, in the same columns as the CV on /work */
  .cr {
    padding: 0 4vw 7rem;
    color: var(--ultramarine);
  }
  .cr__top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1.5px solid var(--ultramarine);
    font: 0.75rem var(--font-din);
    letter-spacing: 0.18em;
  }
  .cr__top h2 {
    margin: 0;
    font: inherit;
  }
  .cr__group {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem 2rem;
    padding: 1.6rem 0 1.8rem;
    border-bottom: 1px solid rgb(2 8 135 / 0.3);
  }
  .cr__h {
    margin: 0.5rem 0 0;
    font: 0.72rem var(--font-din);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cr__entries {
    display: grid;
    gap: 1.1rem;
  }
  .cr__entry {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr auto;
    gap: 0.3rem 2rem;
    align-items: baseline;
  }
  .cr__what {
    font: italic 400 clamp(1.3rem, 1.8vw, 1.65rem) / 1.15 var(--font-display);
  }
  .cr__what a {
    text-decoration: none;
  }
  .cr__what a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .cr__body {
    display: grid;
    gap: 0.15rem;
    max-width: 40rem;
  }
  .cr__by {
    font: 0.66rem/1.5 var(--font-din);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cr__note {
    font: 1.05rem/1.45 var(--font-body);
    color: var(--ink);
  }
  .cr__lic {
    font: 0.62rem var(--font-din);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: right;
    white-space: nowrap;
    opacity: 0.75;
  }

  @media (max-width: 760px) {
    .cr__group,
    .cr__entry {
      grid-template-columns: 1fr;
    }
    .cr__lic {
      text-align: left;
    }
    .abh {
      grid-template-columns: 1fr;
    }
  }
</style>
