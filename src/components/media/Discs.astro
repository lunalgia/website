---
/**
 * A few films as discs, after Ravi Klaassens' A24 library: a row of them on
 * a rising line, the one you are on in the middle, turned to you and lifted.
 * The discs are drawn by three.js (src/scripts/discs.ts), loaded once the page
 * goes quiet or the row comes near; without WebGL, or with reduced motion, they
 * lie flat in a row. Under the disc, where A24 quotes critics: your score as stars, and a
 * line of your own (`pull:` in the film's frontmatter). The scene says where
 * the disc ends (--below), so the words always start under it.
 */
import Entry from './Entry.astro'
import Flip from '@/components/Flip.astro'
import { pad, type CatalogueItem } from '@/lib/catalogue'
interface Props {
  items: CatalogueItem[]
  /** the collection number of each item, by id */
  numbers: Map<string, number>
}
const { items, numbers } = Astro.props
const no = (f: CatalogueItem) => `NO. ${pad(numbers.get(f.id) ?? 0, 3)}`
/** a line set letter by letter, so it can turn over as the crate's titles do */
const letters = (s: string) => {
  let k = 0
  return s.split(' ').map((w) => [...w].map((c) => ({ c, i: k++ })))
}
const discs = items.map((f) => ({
  id: f.id,
  title: f.short ?? f.title,
  by: f.by,
  year: f.year ?? '',
  no: no(f),
  src: f.disc ?? f.img ?? '',
  /** disc art is made to fill the print; a poster has its title and credits to keep clear of */
  art: !!f.disc,
  color: f.color,
  ink: f.ink,
  genres: f.genres.join(', '),
}))
---

<div class="dk" style={`--n:${items.length}`}>
  {/* before anything paints: if three.js is going to draw the discs, the flat row must never show */}
  <script is:inline>
    if (window.WebGL2RenderingContext && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('is-coming')
  </script>
  <header class="ax-top">
    <span>SELECTED</span>
    <span class="dk__nav">
      <button type="button" data-step="-1" aria-label="previous film">
        <svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M33 7H1M7 1 1 7l6 6" /></svg>
      </button>
      <span><b class="dk__n">01</b> / {pad(items.length)}</span>
      <button type="button" data-step="1" aria-label="next film">
        <svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 7h32M27 1l6 6-6 6" /></svg>
      </button>
    </span>
  </header>
  <div class="dk__stage" tabindex="0" aria-label="selected films; arrow keys browse, Space turns the disc over, Enter opens it">
    <ol class="dk__flat">
      {
        items.map((f, i) => (
          <li class="dk__d" data-i={i} style={`--c:${f.color}`}>
            <button type="button" tabindex="-1" aria-label={f.title}>
              {f.thumb ? <img src={f.thumb} alt="" loading="lazy" /> : <span class="dk__type">{f.title}</span>}
            </button>
          </li>
        ))
      }
    </ol>
    {/* one box whose slots hold every film's value in the same place, so each slot is as tall
         as its longest entry and nothing moves when the film changes: only the words turn over */}
    <div class="dk__side">
      <p class="dk__name dk__slot">
        {
          items.map((f, i) => (
            <span class="dk__part dk__flip" style="--o:0" data-i={i} data-state={i ? 'off' : 'on'} inert={i > 0} aria-label={f.short ?? f.title}>
              {letters(f.short ?? f.title).map((w) => (
                <span class="dk__w" aria-hidden="true">
                  {w.map(({ c, i }) => (
                    <span class="dk__l" style={`--i:${i}`}>{c}</span>
                  ))}
                </span>
              ))}
            </span>
          ))
        }
      </p>
      <dl class="dk__facts">
        <div>
          <dt>DIRECTED BY</dt>
          <dd class="dk__slot">
            {
              items.map((f, i) => (
                <span class="dk__part dk__ln" style="--k:1" data-i={i} data-state={i ? 'off' : 'on'} inert={i > 0}>
                  {f.by}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>YEAR</dt>
          <dd class="dk__slot">
            {
              items.map((f, i) => (
                <span class="dk__part dk__ln" style="--k:2" data-i={i} data-state={i ? 'off' : 'on'} inert={i > 0}>
                  {f.year ?? '—'}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>GENRES</dt>
          <dd class="dk__slot dk__genres">
            {
              items.map((f, i) => (
                <span class="dk__part dk__ln" style="--k:3" data-i={i} data-state={i ? 'off' : 'on'} inert={i > 0}>
                  {f.genres.length ? f.genres.map((g) => <span>{g}</span>) : '—'}
                </span>
              ))
            }
          </dd>
        </div>
      </dl>
    </div>
    <p class="dk__hint">← → to browse · Enter for details · Space to turn over</p>
    <aside class="dk__open" id="dk-details" aria-label="details" inert data-lenis-prevent>
      <button type="button" class="dk__close"><Flip word="Close" to="Close" /> <span aria-hidden="true">×</span></button>
      {items.map((f, i) => <Entry item={f} i={i} bare hidden={i > 0} kicker={[no(f), f.size && `${f.size} min`].filter(Boolean).join(' · ')} />)}
    </aside>
    <div class="dk__under">
      {
        items.map((f, i) => (
          <div class="dk__say" data-i={i} data-state={i ? 'off' : 'on'} inert={i > 0}>
            {f.rating != null && (
              <span class="dk__stars dk__ln" style={`--f:${f.rating}%;--k:4`} role="img" aria-label={`${f.rating} out of 100`}>
                ★★★★★
              </span>
            )}
            <p class="dk__src dk__ln" style="--k:5">
              {f.favourite ? 'All-time favourite' : 'My score'}
              {f.rating != null && ` · ${f.rating}/100`}
            </p>
            {f.pull && (
              <p class="dk__big dk__flip" style="--o:6" aria-label={`“${f.pull}”`}>
                {letters(`“${f.pull}”`).map((w) => (
                  <span class="dk__w" aria-hidden="true">
                    {w.map(({ c, i }) => (
                      <span class="dk__l" style={`--i:${i}`}>{c}</span>
                    ))}
                  </span>
                ))}
              </p>
            )}
            <div class="dk__acts dk__ln" style="--k:7">
              <button type="button" class="dk__more" aria-expanded="false" aria-controls="dk-details">
                <span class="dk__plus" aria-hidden="true"></span>
                <Flip word="Details" to="Details" />
              </button>
              {f.href && (
                <a class="dk__go" href={f.href}>
                  <Flip word="Read the review" to="Read the review" /> <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <script type="application/json" class="dk__data" set:html={JSON.stringify(discs)} />
</div>

<script>
  import { whenIdle } from '@/scripts/after-intro'

  const canGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2')
    } catch {
      return false
    }
  }

  const setup = (root: HTMLElement) => {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const stage = root.querySelector<HTMLElement>('.dk__stage')!
    const flat = [...root.querySelectorAll<HTMLElement>('.dk__d')]
    const sides = [...root.querySelectorAll<HTMLElement>('.dk__side [data-i]')]
    const says = [...root.querySelectorAll<HTMLElement>('.dk__say')]
    const open = root.querySelector<HTMLElement>('.dk__open')!
    const entries = [...open.querySelectorAll<HTMLElement>('.en')]
    const n = root.querySelector('.dk__n')!
    const last = flat.length - 1
    /** where the row is: a film's index at rest, in between while you drag or scroll it */
    let pos = 0
    /** the film in front */
    let a = 0
    let scene: { to(pos: number, keyed?: boolean): void; flip(): void; slide(px: number): void; away(): void; dispose(): void } | null = null
    /** the text moves as one sweep: out from the foot of the page to the top, then back in from the top to the foot */
    const swap = (list: HTMLElement[]) =>
      list.forEach((el) => {
        const was = el.dataset.state
        if (Number(el.dataset.i) === a) {
          el.dataset.state = 'on'
          el.inert = false
        } else if (was === 'on') {
          el.dataset.state = 'was'
          el.inert = true
          setTimeout(() => el.dataset.state === 'was' && (el.dataset.state = 'off'), 800)
        }
      })
    /** the details slide in beside the disc, and the row slides over to make room; on a narrow screen they cover the row */
    const shut = open.querySelector<HTMLButtonElement>('.dk__close')!
    const isOpen = () => open.classList.contains('is-open')
    const showOpen = (on: boolean) => {
      open.classList.toggle('is-open', on)
      root.classList.toggle('is-reading', on)
      open.inert = !on
      says.forEach((s) => s.querySelector('.dk__more')!.setAttribute('aria-expanded', String(on)))
      const px = on && stage.clientWidth > 760 ? open.offsetWidth / 2 : 0
      if (scene) scene.slide(px)
      else stage.style.setProperty('--shift', `${px}px`)
      if (on) shut.focus({ preventScroll: true })
    }
    /** the counter follows the row at once; the words wait until it has stopped on a film */
    let wordsTimer = 0
    const show = (i: number, now = false) => {
      if (i === a && !now) return
      a = i
      n.textContent = String(a + 1).padStart(2, '0')
      flat.forEach((d, j) => {
        d.style.setProperty('--d', String(j - a))
        d.toggleAttribute('data-on', j === a)
      })
      entries.forEach((e, j) => (e.hidden = j !== a))
      clearTimeout(wordsTimer)
      wordsTimer = window.setTimeout(
        () => {
          swap(sides)
          swap(says)
        },
        now ? 0 : 70,
      )
    }
    /** move the row: to a film (whole) or partway (while dragging or scrolling) */
    const move = (p: number) => {
      pos = Math.max(-0.35, Math.min(last + 0.35, p))
      show(Math.max(0, Math.min(last, Math.round(pos))))
      scene?.to(pos)
    }
    /** let go between two films: on to the nearer one, in the same movement */
    let settleTimer = 0
    const settle = (after = 0) => {
      clearTimeout(settleTimer)
      settleTimer = window.setTimeout(() => move(Math.max(0, Math.min(last, Math.round(pos)))), after)
    }
    const step = (i: number, keyed = false) => {
      clearTimeout(settleTimer)
      pos = Math.max(0, Math.min(last, i))
      show(pos)
      scene?.to(pos, keyed)
    }
    show(0, true)
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(a + Number(b.dataset.step))))
    flat.forEach((d, j) => d.querySelector('button')!.addEventListener('click', () => (j === a ? showOpen(!isOpen()) : step(j))))
    says.forEach((s) => s.querySelector('.dk__more')!.addEventListener('click', () => showOpen(!isOpen())))
    shut.addEventListener('click', () => {
      showOpen(false)
      stage.focus({ preventScroll: true })
    })
    // what happens in the details stays there: it is not a drag or a click on a disc
    for (const type of ['pointerdown', 'pointerup', 'pointermove', 'wheel']) open.addEventListener(type, (e) => e.stopPropagation(), { passive: true })
    open.addEventListener('pointerenter', () => scene?.away())
    const onResize = () => isOpen() && showOpen(true)
    addEventListener('resize', onResize)
    document.addEventListener('astro:before-swap', () => removeEventListener('resize', onResize), { once: true })
    // ← and → move the row while it fills the middle of the screen, as the posters on the work
    // page do, or while it has focus; Enter and Space only with focus, since they mean other things
    const onKey = (e: KeyboardEvent) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || (e.target as Element).closest?.('input, textarea, select, [contenteditable]')) return
      const mine = document.activeElement === stage
      const r = stage.getBoundingClientRect()
      const here = stage.contains(document.activeElement) || (r.top < innerHeight * 0.5 && r.bottom > innerHeight * 0.5)
      if (here && e.key === 'ArrowRight') step(a + 1, true)
      else if (here && e.key === 'ArrowLeft') step(a - 1, true)
      else if (mine && e.key === 'Enter') showOpen(!isOpen())
      else if (mine && e.key === ' ') scene?.flip()
      else if (isOpen() && e.key === 'Escape') {
        showOpen(false)
        stage.focus({ preventScroll: true })
      } else return
      e.preventDefault()
    }
    addEventListener('keydown', onKey)
    document.addEventListener('astro:before-swap', () => removeEventListener('keydown', onKey), { once: true })
    // sideways scrolling (a trackpad swipe, or shift and the wheel) moves the row as you go;
    // scrolling down always moves the page, so the row never traps you
    stage.addEventListener(
      'wheel',
      (e) => {
        const dx = e.shiftKey ? e.deltaY || e.deltaX : e.deltaX
        if (!dx || (!e.shiftKey && Math.abs(e.deltaX) < Math.abs(e.deltaY))) return
        if ((dx > 0 && pos >= last) || (dx < 0 && pos <= 0)) return
        e.preventDefault()
        // keep the smooth scroller from moving the page as well
        e.stopPropagation()
        // a notch of a mouse wheel is about a film; a trackpad's small deltas add up smoothly
        move(pos + Math.max(-1, Math.min(1, dx / 90)))
        settle(130)
      },
      { passive: false },
    )
    // dragging: the row follows the pointer, and a flick carries on
    const filmPx = () => Math.max(160, stage.clientWidth * 0.3)
    let drag: { x: number; y: number; p: number; v: number; t: number; on: boolean } | null = null
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return
      drag = { x: e.clientX, y: e.clientY, p: pos, v: 0, t: performance.now(), on: false }
    })
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return
      const dx = e.clientX - drag.x
      // sideways is a drag; up and down is the page
      if (!drag.on) {
        if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(e.clientY - drag.y)) return
        drag.on = true
        stage.setPointerCapture(e.pointerId)
        stage.classList.add('is-dragging')
      }
      const now = performance.now()
      const next = drag.p - dx / filmPx()
      drag.v = (next - pos) / Math.max(1, now - drag.t)
      drag.t = now
      clearTimeout(settleTimer)
      move(next)
    })
    const drop = () => {
      if (!drag) return
      const was = drag
      drag = null
      stage.classList.remove('is-dragging')
      if (!was.on) return
      // a flick carries on in its direction, by as many films as it was fast
      const fling = Math.max(-3, Math.min(3, was.v * 260))
      step(Math.round(pos + fling))
    }
    stage.addEventListener('pointerup', drop)
    stage.addEventListener('pointercancel', drop)
    // a drag must not also count as a click on a disc
    stage.addEventListener('click', (e) => stage.classList.contains('is-dragging') && e.stopPropagation(), true)

    if (still || !canGL()) return root.classList.remove('is-coming')
    // three.js comes down once the page has gone quiet, or at once if the row is already near,
    // so that it is usually ready before you reach it. The discs turn in when they come into view
    let gone = false
    let begun = false
    const begin = async () => {
      if (begun || gone) return
      begun = true
      io.disconnect()
      try {
        const { mount } = await import('@/scripts/discs')
        if (gone) return
        const made = await mount(
          stage,
          JSON.parse(root.querySelector('.dk__data')!.textContent!),
          {
            pick: (j) => (j === a ? showOpen(!isOpen()) : step(j)),
          },
          Math.round(pos),
        )
        if (gone) return made.dispose()
        scene = made
        root.classList.add('is-3d')
        scene.to(pos)
      } finally {
        // whatever happened, stop holding the page back: if three.js never came, the flat row shows
        root.classList.remove('is-coming')
      }
    }
    const io = new IntersectionObserver(([e]) => e.isIntersecting && begin(), { rootMargin: '600px 0px' })
    io.observe(root)
    whenIdle(begin, 2500)
    document.addEventListener(
      'astro:before-swap',
      () => {
        gone = true
        io.disconnect()
        clearTimeout(settleTimer)
        clearTimeout(wordsTimer)
        scene?.dispose()
      },
      { once: true },
    )
  }
  // the site swaps pages without reloading, so set up on every arrival, not once
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('.dk').forEach(setup))
</script>

<style>
  .dk__nav {
    display: inline-flex;
    gap: 1.2rem;
    align-items: center;
  }
  .dk__nav button {
    all: unset;
    display: inline-flex;
    cursor: pointer;
  }
  .dk {
    /* where the site header and the section bar end, so the section fits the screen under them */
    --pin-top: 5.6rem;
    /* the height of the "Selected" bar, which the stage rises behind */
    --bar: 2.8rem;
  }
  /* the arrows sit by the name, clear of the discs, which pass over the rule */
  .dk > header:global(.ax-top) {
    padding-top: 0.8rem;
    justify-content: flex-start;
    gap: 2.4rem;
  }
  .dk__nav {
    position: relative;
    z-index: 3;
  }
  .dk__stage {
    position: relative;
    height: clamp(30rem, calc(100svh - var(--pin-top)), 62rem);
    margin-top: calc(-1 * var(--bar));
    /* out to both edges of the screen */
    margin-inline: -4vw;
    overflow: hidden;
    outline: none;
    touch-action: pan-y;
  }
  .dk__stage :global(.dk__pen) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .dk__stage.is-dragging {
    cursor: grabbing;
  }
  .dk__stage:focus-visible {
    outline: 1.5px solid var(--ultramarine);
    outline-offset: -1.5px;
  }
  .dk__stage > :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* the discs lying flat: the one you are on in the middle, the rest along a line */
  .dk__flat {
    --s: min(58%, 26rem);
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
  }
  .dk__d {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--s);
    aspect-ratio: 1;
    translate: calc(-50% + var(--d) * 88%) -50%;
    scale: calc(1 - min(1, max(var(--d), -1 * var(--d))) * 0.3);
    opacity: calc(1 - min(3, max(var(--d), -1 * var(--d))) * 0.28);
    transition:
      translate 0.6s var(--ease-out),
      scale 0.6s var(--ease-out),
      opacity 0.4s;
  }
  .dk__d[data-on] {
    z-index: 1;
  }
  .dk__d button {
    all: unset;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    background: var(--c);
    /* the clear hub and its hole */
    mask: radial-gradient(circle, transparent 9.9%, #000 10.2%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }
  .dk__d img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dk__type {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 20%;
    font: italic 1.6rem/1 var(--font-display);
    text-align: center;
  }
  .dk__flat {
    translate: calc(-1 * var(--shift, 0px)) 0;
    transition: translate 0.65s var(--ease-out);
  }
  /* once three.js has drawn the discs, the flat ones only stay for screen readers */
  .dk.is-3d .dk__flat {
    opacity: 0;
    pointer-events: none;
  }
  /* while three.js is on its way the stage stays empty: no flat row, and no words, which
     do not yet know where the disc ends */
  .dk.is-coming .dk__flat,
  .dk.is-coming .dk__under {
    visibility: hidden;
    opacity: 0;
  }
  .dk__side {
    position: absolute;
    top: calc(var(--bar) + 1.2rem);
    left: 4vw;
    z-index: 2;
    width: min(15rem, 30%);
    margin: 0;
    pointer-events: none;
  }
  /* every film's value for a slot sits in the same cell; the slot is as tall as the longest */
  .dk__slot {
    display: grid;
  }
  .dk__slot > .dk__part {
    grid-area: 1 / 1;
  }
  .dk__part[data-state='off'] {
    visibility: hidden;
  }
  /* all the text is one sweep, in order: --k and --o count down the page, from the name to the
     button. It leaves from the foot upward, 32 ms a line, and comes back from the top downward,
     70 ms a line, once the discs have arrived */
  .dk__ln {
    transition:
      translate 0.6s var(--ease-out),
      opacity 0.45s var(--ease-out);
  }
  :is([data-state='on'] .dk__ln, .dk__ln[data-state='on']) {
    transition-delay: calc(560ms + var(--k) * 70ms);
  }
  :is([data-state='was'] .dk__ln, .dk__ln[data-state='was']) {
    translate: 0 -0.45rem;
    opacity: 0;
    transition-duration: 0.22s;
    transition-delay: calc((7 - var(--k)) * 32ms);
  }
  :is([data-state='off'] .dk__ln, .dk__ln[data-state='off']) {
    translate: 0 0.7rem;
    opacity: 0;
    transition: none;
  }
  /* the name and the quote turn over letter by letter, as the crate's titles do: the old
     one tips away over the top, the new one comes up from below as the disc arrives */
  .dk__flip {
    perspective: 600px;
  }
  .dk__w {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.24em;
  }
  .dk__w:last-child {
    margin-right: 0;
  }
  .dk__l {
    display: inline-block;
    backface-visibility: hidden;
    transform-origin: 50% 50% -0.3em;
    transform: rotateX(-90deg);
    opacity: 0;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.5s var(--ease-out);
    /* long lines turn over no slower than a 24-letter one */
    transition-delay: calc(560ms + var(--o) * 70ms + min(var(--i), 24) * 20ms);
  }
  [data-state='on'] .dk__l {
    transform: none;
    opacity: 1;
  }
  [data-state='was'] .dk__l {
    transform: rotateX(90deg);
    transition-duration: 0.3s;
    transition-delay: calc((7 - var(--o)) * 32ms + min(var(--i), 24) * 10ms);
  }
  [data-state='off'] .dk__l {
    transition: none;
  }
  .dk__name {
    /* names rest on the rule, however many lines the longest one takes */
    align-items: end;
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ultramarine);
    font: 400 clamp(1.2rem, 1.7vw, 1.6rem) / 1.05 var(--font-din);
    text-transform: uppercase;
  }
  .dk__side dd {
    margin: 0;
  }
  .dk__side dl div {
