---
/**
 * The records, one at a time, as one giant record printed in the site's ink and
 * cut off by the edge of the page: the art for its label, a band of grooves for
 * each track, the details beside it. It turns slowly. Going to the next rolls
 * this one down off the page and the next one in from above; click the record,
 * or use the arrows, the keys or a sideways swipe. Only the first is in the page;
 * the rest are pressed from .cr__data as you come to them, so their art stays
 * unloaded until you are near.
 *
 * The grooves are a pattern of fine rings, smoothed so that they stay clean circles,
 * laid twice a few pixels apart, so that the two sets beat against each other and
 * open a fan of light across the disc, as a real record's do. That is drawn once per
 * size, so it looks the same on every screen. Round them, what a pressing has: a raised rim,
 * a clear gap between tracks, the smooth run-out with the matrix number scratched
 * into it, and a ring of lettering round the art. Every line is a true circle round
 * the spindle, so nothing wobbles as it turns.
 *
 * The tonearm is printed too, its pivot off the page above. It belongs to the
 * stage rather than the record: it swings clear before a record leaves, comes
 * back once the next has arrived, and creeps inward over the album's real length.
 */
import Entry from './Entry.astro'
import { matrixLine, rims, runOut, trackGaps } from '@/lib/grooves'
import { pad, type CatalogueItem } from '@/lib/catalogue'
interface Props { items: CatalogueItem[] }
const { items } = Astro.props
const records = items.map((r, i) => ({
  title: r.title,
  img: r.img ?? '',
  color: r.color,
  cat: `LUN ${pad(i + 1, 3)}`,
  tracks: parseInt(r.meta.tracks ?? '', 10) || 8,
  minutes: parseInt(r.meta.length ?? '', 10) || 40,
}))
const first = records[0]
/** a title short enough to go round the label's foot */
const round = (s: string) => (s.length > 38 ? `${s.slice(0, 37)}…` : s).toUpperCase()
/** the arm's line, from the pivot straight down to a bend and the head; the needle is at its length, 807 */
const ARM = 'M0 0L0 640Q0 690 -16 730L-22 750'
---

<section class="cr" id="records" aria-label="records">
  <header class="ax-top">
    <span>II · RECORDS</span>
    <span class="cr__nav">
      <button type="button" data-step="-1" aria-label="previous record">
        <svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M33 7H1M7 1 1 7l6 6" /></svg>
      </button>
      <span><b class="cr__n">01</b> / {pad(items.length)}</span>
      <button type="button" data-step="1" aria-label="next record">
        <svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 7h32M27 1l6 6-6 6" /></svg>
      </button>
    </span>
  </header>
  <div class="cr__body">
    <div class="cr__stage" data-keys tabindex="0" aria-label="the records; arrow keys or a click on the record go to the next one">
      {/* the lines the lettering runs along, shared by every record */}
      <svg class="rc__lines" width="0" height="0" aria-hidden="true">
        <defs>
          <path id="rc-head" d="M-176 0A176 176 0 0 1 176 0" />
          <path id="rc-foot" d="M-184 0A184 184 0 0 0 184 0" />
          <path id="rc-wax" d={matrixLine} />
        </defs>
      </svg>
      {
        first && (
          <div class="rc" data-at="on" aria-hidden="true">
            <div class="rc__grooves" />
            <div class="rc__sheen" />
            <svg class="rc__press" viewBox="-500 -500 1000 1000" fill="none">
              <path class="rc__gaps" d={trackGaps(first.title, first.tracks)} />
              <path class="rc__line" d={rims} />
            </svg>
            <div class="rc__roll">
              <div class="rc__turn">
                <div class="rc__art" style={`background-color:${first.color}`}>
                  {first.img && <img src={first.img} alt="" />}
                </div>
                <svg viewBox="-500 -500 1000 1000" fill="none">
                  <path class="rc__line" d={runOut} />
                  <circle class="rc__line" r="156" />
                  <text class="rc__etch">
                    <textPath href="#rc-wax" class="rc__matrix">{first.cat}–A1</textPath>
                  </text>
                  <text class="rc__type" text-anchor="middle">
                    <textPath href="#rc-head" startOffset="50%">SIDE A · 33 RPM · LUNALGIA RECORDS</textPath>
                  </text>
                  <text class="rc__type" text-anchor="middle">
                    <textPath href="#rc-foot" startOffset="50%" class="rc__name">{round(first.title)}</textPath>
                  </text>
                  <circle class="rc__hole" r="7" />
                </svg>
              </div>
            </div>
          </div>
        )
      }
      <div class="rc__arm" aria-hidden="true">
        <svg viewBox="-500 -500 1000 1000" fill="none">
          <g transform="translate(120 -700)">
            <g class="rc__swing">
              <path class="rc__arm-shade" d={ARM} />
              <path class="rc__arm-edge" d={ARM} />
              <path class="rc__arm-tube" d={ARM} />
              <g transform="translate(-22 750) rotate(16)">
                <rect class="rc__head" x="-10" y="0" width="20" height="58" rx="2" />
                <path class="rc__arm-edge rc__lift" d="M10 12L26 7" />
              </g>
            </g>
          </g>
        </svg>
      </div>
    </div>
    <div class="cr__entries">
      {items.map((r, i) => <Entry item={r} i={i} bare flip cat={`LUN ${pad(i + 1, 3)}`} kicker={`${pad(i + 1)} / ${pad(items.length)}`} />)}
    </div>
    <p class="cr__hint">Click the record, use ← →, or swipe sideways</p>
  </div>
  <script type="application/json" class="cr__data" set:html={JSON.stringify(records)} />
</section>

<script>
  import { INNER, OUTER, trackGaps } from '@/lib/grooves'
  import { whenIdle } from '@/scripts/after-intro'
  import { holdsKeys } from '@/scripts/stage-keys'

  interface Pressing {
    title: string
    img: string
    color: string
    cat: string
    tracks: number
    minutes: number
  }

  /** the arm's pivot and length, as drawn, in the record's units (a radius of 500) */
  const PIVOT = [120, -700]
  const REACH = 807
  /** how far round it swings to clear the page, and where its needle starts and ends on a record */
  const CLEAR = 88
  const SIDE_START = 474
  const SIDE_END = 272
  /** the swing, in degrees, that puts the needle this far from the spindle */
  const swingFor = (r: number) => {
    for (let t = 0; t < 90; t += 0.05) {
      const a = (t * Math.PI) / 180
      if (Math.hypot(PIVOT[0] - REACH * Math.sin(a), PIVOT[1] + REACH * Math.cos(a)) >= r) return t
    }
    return CLEAR
  }

  /** the rings, in the screen's own pixels: a little under four apart and one wide; closer or wider and the bands wash out */
  const PITCH = 3.9
  const LINE = 1
  /**
   * The grooves, one pixel at a time, for a record this many of the screen's pixels
   * across. Each pixel is inked by how much of a ring crosses it, so that the rings
   * stay round instead of breaking into steps against the pixel grid.
   */
  const pressGrooves = (size: number) => {
    const c = document.createElement('canvas')
    c.width = c.height = size
    const g = c.getContext('2d')!
    const px = g.createImageData(size, size)
    const mid = size / 2
    const from = (mid * INNER) / 500
    const to = (mid * OUTER) / 500
    const ink = [2, 8, 135]
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const r = Math.hypot(x - mid + 0.5, y - mid + 0.5)
        if (r < from || r > to) continue
        const off = r % PITCH
        const cover = Math.min(1, LINE / 2 + 0.5 - Math.min(off, PITCH - off))
        if (cover <= 0) continue
        const at = (y * size + x) * 4
        px.data[at] = ink[0]
        px.data[at + 1] = ink[1]
        px.data[at + 2] = ink[2]
        px.data[at + 3] = Math.round(cover * 255)
      }
    }
    g.putImageData(px, 0, 0)
    return new Promise<Blob | null>((ok) => c.toBlob(ok))
  }

  const setup = (root: HTMLElement) => {
    const records: Pressing[] = JSON.parse(root.querySelector('.cr__data')!.textContent!)
    const entries = [...root.querySelectorAll<HTMLElement>('.en')]
    const stage = root.querySelector<HTMLElement>('.cr__stage')!
    const n = root.querySelector('.cr__n')!
    let current = stage.querySelector<HTMLElement>('.rc')!
    if (!current) return
    /** a clean copy to press the others from, keeping the component's scoped styles */
    const blank = current.cloneNode(true) as HTMLElement
    const press = (i: number) => {
      const r = records[i]
      const el = blank.cloneNode(true) as HTMLElement
      el.querySelector('.rc__gaps')!.setAttribute('d', trackGaps(r.title, r.tracks))
      el.querySelector<HTMLElement>('.rc__art')!.style.backgroundColor = r.color
      el.querySelector('.rc__matrix')!.textContent = `${r.cat}–A1`
      el.querySelector('.rc__name')!.textContent = (r.title.length > 38 ? `${r.title.slice(0, 37)}…` : r.title).toUpperCase()
      const img = el.querySelector('img')
      if (img && r.img) img.src = r.img
      else img?.remove()
      return el
    }
    /** this one rolls off the way you are going, and the next rolls in behind it */
    const roll = (dir: number, i: number) => {
      const old = current
      old.dataset.at = dir > 0 ? 'below' : 'above'
      const gone = () => old.remove()
      old.addEventListener('transitionend', (e) => e.target === old && e.propertyName === 'translate' && gone())
      setTimeout(gone, 1200)
      current = press(i)
      current.dataset.at = dir > 0 ? 'above' : 'below'
      stage.append(current)
      // let it be drawn where it starts, so that it moves
      current.offsetWidth
      current.dataset.at = 'on'
    }
    /** the art either side of you, so the next one arrives with its label on */
    const nearby = new Set<number>()
    const preload = (i: number) => {
      for (const j of [i - 1, i + 1, i + 2]) {
        if (!records[j]?.img || nearby.has(j)) continue
        nearby.add(j)
        new Image().src = records[j].img
      }
    }
    /** the arm: lifted, swung to an angle over so many seconds */
    const arm = root.querySelector<HTMLElement>('.rc__arm')!
    const swing = root.querySelector<SVGGElement>('.rc__swing')!
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const swingTo = (deg: number, seconds: number, ease: string) => {
      swing.style.transition = seconds ? `rotate ${seconds}s ${ease}` : 'none'
      swing.style.rotate = `${deg}deg`
    }
    let armTimers: number[] = []
    const armLater = (ms: number, f: () => void) => armTimers.push(window.setTimeout(f, ms))
    /** the swing that just takes the head off the top of the stage, so it travels no further than it must */
    const clearAngle = () => {
      const box = arm.getBoundingClientRect()
      const top = ((stage.getBoundingClientRect().top - (box.top + box.height / 2)) / box.height) * 1000
      const cos = (top - 90 - PIVOT[1]) / REACH
      return Math.min(CLEAR, (Math.acos(Math.max(0, Math.min(1, cos))) * 180) / Math.PI)
    }
    /** down onto the record in one movement, lowering as it comes, then riding inward for the length of the album */
    const play = () => {
      armTimers.forEach(clearTimeout)
      armTimers = []
      swingTo(swingFor(SIDE_START), 0.5, 'cubic-bezier(0.3, 0.7, 0.2, 1)')
      arm.classList.remove('is-lifted')
      armLater(520, () => {
        // on the record for certain, even if a throttled tab never ran the swing, then the slow ride
        swingTo(swingFor(SIDE_START), 0, '')
        swing.getBoundingClientRect()
        swingTo(swingFor(SIDE_END), records[a].minutes * 60, 'linear')
      })
    }
    /** up and away at once, to come back as the next record lands */
    const clear = () => {
      armTimers.forEach(clearTimeout)
      armTimers = []
      arm.classList.add('is-lifted')
      swing.style.transition = 'rotate 0s'
      // from wherever it has got to on its slow way in
      swing.style.rotate = getComputedStyle(swing).rotate
      swing.getBoundingClientRect()
      swingTo(clearAngle(), 0.26, 'cubic-bezier(0.4, 0, 0.9, 0.5)')
      armLater(420, play)
    }
    let a = 0
    const set = (i: number) => {
      const next = Math.max(0, Math.min(records.length - 1, i))
      const dir = Math.sign(next - a)
      a = next
      n.textContent = String(a + 1).padStart(2, '0')
      if (dir) {
        roll(dir, a)
        if (still) swingTo(swingFor(SIDE_START), 0, '')
        else clear()
      }
      preload(a)
      // the details flip over as on the shelves: the old title tips away over the top,
      // the new one comes up from below, and the lines under it slide in after
      entries.forEach((e, j) => {
        if (j === a) {
          e.classList.remove('was-on', 'no-t')
          e.classList.add('is-on')
          e.inert = false
        } else if (e.classList.contains('is-on')) {
          e.classList.replace('is-on', 'was-on')
          e.inert = true
          setTimeout(() => {
            if (e.classList.contains('is-on')) return
            e.classList.add('no-t')
            e.classList.remove('was-on')
            e.offsetWidth
            e.classList.remove('no-t')
          }, 900)
        } else e.inert = true
      })
    }
    set(0)
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => set(a + Number(b.dataset.step))))
    // ← and → go through them while the record has most of the screen, centred or not, or while
    // it has focus; ↑ and ↓ only with focus, since they scroll the page
    const onKey = (e: KeyboardEvent) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || (e.target as Element).closest?.('input, textarea, select, [contenteditable]')) return
      const mine = document.activeElement === stage
      const here = holdsKeys(stage)
      if (here && e.key === 'ArrowRight') set(a + 1)
      else if (here && e.key === 'ArrowLeft') set(a - 1)
      else if (mine && e.key === 'ArrowDown') set(a + 1)
      else if (mine && e.key === 'ArrowUp') set(a - 1)
      else return
      e.preventDefault()
    }
    addEventListener('keydown', onKey)
    document.addEventListener('astro:before-swap', () => removeEventListener('keydown', onKey), { once: true })
    // sideways scrolling (a trackpad swipe, or shift and the wheel) goes through them;
    // scrolling down always moves the page, so the record never traps you
    let acc = 0
    let last = 0
    stage.addEventListener(
      'wheel',
      (e) => {
        const dx = e.shiftKey ? e.deltaY || e.deltaX : e.deltaX
        if (!dx || (!e.shiftKey && Math.abs(e.deltaX) < Math.abs(e.deltaY))) return
        if ((dx > 0 && a === records.length - 1) || (dx < 0 && a === 0)) return
        e.preventDefault()
        // keep the smooth scroller from moving the page as well
        e.stopPropagation()
        acc += dx
        const now = performance.now()
        if (Math.abs(acc) > 40 && now - last > 110) {
          set(a + Math.sign(acc))
          acc = 0
          last = now
        }
      },
      { passive: false },
    )
    // a swipe across goes to the next or the last; a tap on the record goes to the next
    let down: { x: number; y: number } | null = null
    stage.addEventListener('pointerdown', (e) => {
      if (e.button === 0) down = { x: e.clientX, y: e.clientY }
    })
    stage.addEventListener('pointerup', (e) => {
      if (!down) return
      const dx = e.clientX - down.x
      const dy = e.clientY - down.y
      down = null
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) set(a - Math.sign(dx))
      else if (Math.hypot(dx, dy) < 8 && (e.target as Element).closest('.rc')) set(a + 1)
    })
    stage.addEventListener('pointercancel', () => (down = null))

    // the grooves are drawn for the record's size, after the page has settled, and again if that changes;
    // every record shares them, and until then a plain pattern stands in
    let pressedAt = 0
    let pressed = ''
    let gone = false
    const armBox = root.querySelector<HTMLElement>('.rc__arm')!
    /** the record's size and place, whole pixels of the screen, or the pattern would be resampled and warp */
    const snap = () => {
      const dpr = devicePixelRatio
      for (const k of ['--rc-size', '--rc-top', '--rc-left']) stage.style.removeProperty(k)
      // the arm is measured as the record is, and never slides away
      const b = armBox.getBoundingClientRect()
      const s = stage.getBoundingClientRect()
      const size = Math.round(b.width * dpr)
      stage.style.setProperty('--rc-size', `${size / dpr}px`)
      stage.style.setProperty('--rc-top', `${Math.round(b.top * dpr) / dpr - s.top}px`)
      stage.style.setProperty('--rc-left', `${Math.round(b.left * dpr) / dpr - s.left}px`)
      return size
    }
    const repress = async () => {
      if (gone) return
      const size = snap()
      if (!size || size === pressedAt) return
      pressedAt = size
      const blob = await pressGrooves(size)
      if (gone || !blob || size !== pressedAt) return
      if (pressed) URL.revokeObjectURL(pressed)
      pressed = URL.createObjectURL(blob)
      stage.style.setProperty('--grooves', `url(${pressed})`)
    }
    let sizeTimer = 0
    const ro = new ResizeObserver(() => {
      clearTimeout(sizeTimer)
      sizeTimer = window.setTimeout(repress, 200)
    })
    whenIdle(() => {
      if (gone) return
      repress()
      ro.observe(stage)
    }, 800)

    // the arm comes down the first time the record is in view; with reduced motion it just rests there
    let armSeen = false
    const armIo = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting || armSeen) return
        armSeen = true
        armIo.disconnect()
        if (armTimers.length) return
        // waiting just off the page, with no long way to come
        arm.classList.add('is-lifted')
        swingTo(clearAngle(), 0, '')
        swing.getBoundingClientRect()
        play()
      },
      { threshold: 0.35 },
    )
    if (still) {
      swingTo(swingFor(SIDE_START), 0, '')
      arm.classList.remove('is-lifted')
    } else armIo.observe(stage)

    // the light follows the pointer, as if you were tilting the disc under a lamp; where there is
    // no pointer, scrolling tilts it instead. It eases along behind, and stops when it has caught up
    const light = { x: 9, y: -4 }
    const lightTo = { ...light }
    let lightFrame = 0
    const shine = () => {
      lightFrame = 0
      light.x += (lightTo.x - light.x) * 0.12
      light.y += (lightTo.y - light.y) * 0.12
      // whole pixels of the screen here too, for the same reason
      const dpr = devicePixelRatio
      stage.style.setProperty('--light-x', `${Math.round(light.x * dpr) / dpr}px`)
      stage.style.setProperty('--light-y', `${Math.round(light.y * dpr) / dpr}px`)
      // the fan runs square to the way the rings are parted
      stage.style.setProperty('--light-a', `${((Math.atan2(light.x, -light.y) * 180) / Math.PI + 90).toFixed(1)}deg`)
      if (Math.abs(lightTo.x - light.x) + Math.abs(lightTo.y - light.y) > 0.02) lightFrame = requestAnimationFrame(shine)
    }
    const aimLight = (dx: number, dy: number) => {
      // never quite together, or the fan would open out to nothing
      const far = Math.max(1e-3, Math.hypot(dx, dy))
      // parted by the screen's pixels, like the rings, so the fan is the same on any screen
      const part = (5 + 7 * Math.min(1, far)) / devicePixelRatio
      lightTo.x = (dx / far) * part
      lightTo.y = (dy / far) * part
      if (!lightFrame) lightFrame = requestAnimationFrame(shine)
    }
    const onLightMove = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return
      const b = current.getBoundingClientRect()
      if (!b.width) return
      aimLight((e.clientX - (b.left + b.width / 2)) / (b.width / 2), (e.clientY - (b.top + b.height / 2)) / (b.height / 2))
    }
    const onLightScroll = () => {
      const b = stage.getBoundingClientRect()
      if (b.bottom < 0 || b.top > innerHeight) return
      const t = (b.top + b.height / 2) / innerHeight - 0.5
      aimLight(Math.cos(t * 5), Math.sin(t * 5))
    }
    const moving = !matchMedia('(prefers-reduced-motion: reduce)').matches
    const hovering = matchMedia('(hover: hover)').matches
    aimLight(0.9, -0.4)
    if (moving && hovering) root.addEventListener('pointermove', onLightMove)
    if (moving && !hovering) addEventListener('scroll', onLightScroll, { passive: true })
    document.addEventListener(
      'astro:before-swap',
      () => {
        gone = true
        ro.disconnect()
        clearTimeout(sizeTimer)
        cancelAnimationFrame(lightFrame)
        removeEventListener('scroll', onLightScroll)
        armIo.disconnect()
        armTimers.forEach(clearTimeout)
        if (pressed) URL.revokeObjectURL(pressed)
      },
      { once: true },
    )
  }
  // the site swaps pages without reloading, so set up on every arrival, not once
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('.cr').forEach(setup))
</script>

<style>
  .cr__nav {
    display: inline-flex;
    gap: 1.2rem;
    align-items: center;
  }
  .cr__nav button {
    all: unset;
    display: inline-flex;
    cursor: pointer;
  }
  .cr {
    /* the column the details keep, clear of the record */
    --side: min(30vw, 27rem);
    /* how far in the record stands, so its label clears the edge of the screen and the rail */
    --clear: 3rem;
  }
  .cr__body {
    position: relative;
    /* the screen, under the site header, the section bar and this section's own */
    min-height: clamp(34rem, calc(100svh - 8.5rem), 58rem);
  }
  /* out to both edges of the screen, and cut off at the rule above */
  .cr__stage {
    position: absolute;
    inset: 0 -4vw;
    container-type: size;
    overflow: hidden;
    outline: none;
    touch-action: pan-y;
  }
  .cr__stage:focus-visible {
    outline: 1.5px solid var(--ultramarine);
    outline-offset: -1.5px;
  }
  /* as large as the height allows, without its rim reaching the details */
  .rc {
    --r: var(--rc-size, min(150cqh, calc((100cqw - 4vw - var(--side) - 2rem - var(--clear)) / 0.66)));
    position: absolute;
    top: var(--rc-top, calc(50cqh - var(--r) / 2));
    left: var(--rc-left, auto);
    right: calc(var(--r) * -0.34 + var(--clear));
    width: var(--r);
    height: var(--r);
    border-radius: 50%;
    cursor: pointer;
    transition: translate 0.85s var(--ease-out);
  }
  .rc svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .rc__lines {
    position: absolute;
  }
  /* shown pixel for pixel, or the rings would blur; the plain rings stand in until it is drawn */
  .rc__grooves {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    mask: radial-gradient(closest-side, transparent 52.4%, #000 52.4% 96.8%, transparent 96.8%);
  }
  /* the same rings twice, a few pixels apart: where they fall together the page shows through and
     where they fall between it does not, which draws a fan of bright bands across the disc, as
     light does on the face of a CD. Moving the second set moves the light */
  .rc__grooves::before,
  .rc__grooves::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grooves, repeating-radial-gradient(circle, var(--ultramarine) 0 1px, transparent 1px 3.9px));
    background-size: 100% 100%;
    image-rendering: pixelated;
  }
