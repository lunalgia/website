---
/**
 * A close-up shelf after play.mint.gg/complete-shelf, in plain CSS 3D.
 * One item faces you; the rest stand spine-out. Arrow keys / buttons / a spine
 * click move along; clicking the facing item (or "open the review") inspects it
 * and slides in the review panel.
 *
 * kind:  'book'   tall hardcovers
 *        'record' square sleeves; the vinyl slides out of the facing one
 *        'film'   DVD-style cases; a ticket stub sticks out of the facing one
 */
export interface ShelfItem {
  title: string
  /** shorter title for spines and the big label */
  short?: string
  by: string
  year?: number
  rating?: number
  favourite?: boolean
  liked?: boolean
  /** genres, then your own tags */
  tags?: string[]
  /** a few facts for the panel: [label, value] */
  facts?: [string, string][]
  /** where to find it, Apple Music and the like: [label, url] */
  links?: [string, string][]
  /** e.g. "September 2026" */
  when?: string
  /** cover image URL; a typeset cover is drawn when missing */
  img?: string
  /** spine colour and spine ink */
  color: string
  ink: string
  /** spine thickness in px */
  depth: number
  /** the first few paragraphs, as small HTML (links and italics only) */
  excerpt: string[]
  /** the excerpt is the whole review: only link onward when the panel cuts it short */
  whole?: boolean
  href?: string
  words?: number
  warning?: string
}
interface Props {
  id: string
  kind: 'book' | 'record' | 'film'
  heading: string
  items: ShelfItem[]
}
const { id, kind, heading, items } = Astro.props
import Score from './Score.astro'
/** "Phil Lord and Christopher Miller" → "Lord & Miller"; "Lana and Lilly Wachowski" → "Wachowski" */
const surname = (s: string) =>
  s
    .split(/\s+(?:and|&)\s+/)
    .filter((p) => p.trim().includes(' '))
    .map((p) => p.trim().split(/\s+/).at(-1))
    .join(' & ') || s.trim().split(/\s+/).at(-1)
const verb = { book: 'FINISHED', record: 'ON REPEAT SINCE', film: 'WATCHED' }[kind]
---

<section class={`cs cs--${kind}`} id={id} data-active="0" tabindex="-1" aria-label={heading}>
  <header class="cs__top">
    <span>{heading}</span>
    <span class="cs__nav">
      <button type="button" data-step="-1" aria-label="previous"><svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M33 7H1M7 1 1 7l6 6" /></svg></button>
      <span class="cs__count"><b>01</b> / {String(items.length).padStart(2, '0')}</span>
      <button type="button" data-step="1" aria-label="next"><svg viewBox="0 0 34 14" width="34" height="14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 7h32M27 1l6 6-6 6" /></svg></button>
    </span>
  </header>

  <noscript>
    <ol class="cs__plain">
      {items.map((b) => (
        <li>
          <a href={b.href ?? '#'}>{b.title}</a> <span>{b.by}</span>
        </li>
      ))}
    </ol>
  </noscript>

  <div class="cs__stage">
    <div class="cs__shelf">
      {
        items.map((b, i) => (
          <button
            class="bk"
            style={`--c:${b.color};--f:${b.ink};--d:${b.depth}px`}
            data-i={i}
            aria-label={`${b.title}, ${b.by}`}
          >
            <span class="bk__box">
              {kind !== 'book' && (
                <span class="bk__sleeve" aria-hidden="true">
                  {kind === 'record' ? (
                    <span class="bk__disc">
                      <span style={b.img ? `background-image:url(${b.img})` : `background-color:${b.color}`} />
                    </span>
                  ) : (
                    <span class="bk__ticket">
                      <span>ADMIT ONE</span>
                      <b>{String(i + 1).padStart(3, '0')}</b>
                    </span>
                  )}
                </span>
              )}
              <span class="bk__spine">
                {kind === 'film' && <span class="bk__no">{String(i + 1).padStart(3, '0')}</span>}
                <span class="bk__st">{b.short ?? b.title}</span>
                <span class="bk__sa">{kind === 'record' ? b.by : surname(b.by)}</span>
              </span>
              {b.img ? (
                <span class="bk__cover" style={`background-image:url(${b.img})`} />
              ) : (
                <span class="bk__cover bk__cover--type">
                  <span class="bk__ca">{b.by}</span>
                  <span class="bk__ct">{b.title}</span>
                  <span class="bk__ca">{b.year}</span>
                </span>
              )}
              <span class="bk__back" />
              <span class="bk__pages" />
            </span>
          </button>
        ))
      }
    </div>
    <div class="cs__plank"></div>
  </div>

  <div class="cs__label">
    {
      items.map((b, i) => (
        <div class="lab" data-i={i}>
          <p class="lab__n">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="lab__t" aria-label={b.short ?? b.title}>
            {(() => {
              let k = 0
              return (b.short ?? b.title).split(' ').map((w) => (
                <span class="lab__w" aria-hidden="true">
                  {[...w].map((c) => <span class="lab__l" style={`--i:${k++}`}>{c}</span>)}
                </span>
              ))
            })()}
          </h2>
          <p class="lab__a">
            {b.by}
            {b.year && `, ${b.year}`}
          </p>
          {b.rating != null && <p class="lab__s">{b.rating}<small>/100</small></p>}
          <button class="lab__go" type="button">
            {b.excerpt.length ? 'open the review ↗' : 'details ↗'}
          </button>
        </div>
      ))
    }
  </div>

  <aside class="cs__panel" aria-live="polite" data-lenis-prevent>
    <button class="cs__back" type="button">← back to the shelf</button>
    {
      items.map((b, i) => (
        <article class="pn" data-i={i} data-whole={b.whole ? '' : undefined}>
          <p class="pn__k">
            {kind.toUpperCase()}
            {b.when && ` · ${verb} ${b.when.toUpperCase()}`}
          </p>
          <h3 class="pn__t">{b.title}</h3>
          <p class="pn__a">
            {b.by}
            {b.year && `, ${b.year}`}
          </p>
          <Score class="pn__score" rating={b.rating} favourite={b.favourite} liked={b.liked} />
          {b.facts && b.facts.length > 0 && (
            <dl class="pn__facts">
              {b.facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}
          {b.tags && b.tags.length > 0 && (
            <p class="pn__tags">
              {b.tags.map((t) => (
                <span>{t}</span>
              ))}
            </p>
          )}
          {b.links && b.links.length > 0 && (
            <p class="pn__links">
              {b.links.map(([label, url]) => (
                <a href={url} target="_blank" rel="noopener">{label} ↗</a>
              ))}
            </p>
          )}
          {b.warning && <p class="pn__warn">content note: {b.warning}</p>}
          {b.excerpt.length ? (
            <>
              <div class="pn__body">
                {b.excerpt.map((p) => (
                  <p class="pn__p" set:html={p} />
                ))}
              </div>
              <a class="pn__more" href={b.href ?? '#'}>
                <span class="pn__more-cut">continue reading{b.words ? `, ${b.words.toLocaleString('en-GB')} words` : ''} →</span>
                <span class="pn__more-whole">open as a page →</span>
              </a>
            </>
          ) : (
            <p class="pn__none">No review yet.</p>
          )}
        </article>
      ))
    }
  </aside>
</section>

<script>
  /** items this close to the facing one keep their 3D sides; the rest show only their spines */
  const NEAR = 2
  const setup = (root: HTMLElement) => {
    if (root.dataset.ready) return
    root.dataset.ready = '1'
    const all = [...root.querySelectorAll<HTMLElement>('.bk')]
    const shelf = root.querySelector<HTMLElement>('.cs__shelf')!
    const panel = root.querySelector<HTMLElement>('.cs__panel')!
    /** where each item's spine starts along the shelf (spine widths only) */
    const starts = all.reduce<number[]>((a, b, j) => (a.push(j ? a[j - 1] + parseFloat(all[j - 1].style.getPropertyValue('--d')) : 0), a), [])
    let shelfX = 0
    let switching: ReturnType<typeof setTimeout> | undefined
    const set = (i: number) => {
      i = Math.max(0, Math.min(all.length - 1, i))
      // moving along with the review open: let the shelf slide with the item
      // at rest first, then pull the new one out once things have settled
      if (root.classList.contains('is-inspecting') && String(i) !== root.dataset.active) {
        root.classList.add('is-switching')
        clearTimeout(switching)
        switching = setTimeout(() => root.classList.remove('is-switching'), 700)
        requestAnimationFrame(() => clip())
      }
      // the item swinging back keeps its depth until it has settled
      const prev = all[+root.dataset.active!]
      if (prev && Math.abs(+root.dataset.active! - i) > NEAR) {
        prev.classList.add('is-leaving')
        setTimeout(() => prev.classList.remove('is-leaving'), 1000)
      }
      root.dataset.active = String(i)
      all.forEach((b, j) => {
        b.classList.toggle('is-active', j === i)
        b.classList.toggle('is-near', Math.abs(j - i) <= NEAR)
      })
      root.querySelectorAll<HTMLElement>('.pn').forEach((l) => l.classList.toggle('is-on', +l.dataset.i! === i))
      // the label's letters flip over: the old title tips away over the top, the
      // new one comes up from below; one that has left drops back underneath, unseen
      root.querySelectorAll<HTMLElement>('.lab').forEach((l) => {
        const on = +l.dataset.i! === i
        if (on) {
          l.classList.remove('was-on', 'no-t')
          l.classList.add('is-on')
        } else if (l.classList.contains('is-on')) {
          l.classList.replace('is-on', 'was-on')
          setTimeout(() => {
            if (l.classList.contains('is-on')) return
            l.classList.add('no-t')
            l.classList.remove('was-on')
            l.offsetWidth
            l.classList.remove('no-t')
          }, 900)
        }
      })
      root.querySelector('.cs__count b')!.textContent = String(i + 1).padStart(2, '0')
      // spine widths only: the facing item's own width is still animating
      shelfX = starts[i]
      shelf.style.transform = `translateX(${-shelfX}px)`
    }
    let settling = 0
    const inspect = (on: boolean) => {
      root.classList.toggle('is-inspecting', on)
      if (!on) return
      panel.scrollTop = 0
      // bring the whole shelf on screen; the panel is fixed to the viewport
      settling = performance.now() + 1200
      const lenis = (window as any).__lenis
      lenis ? lenis.scrollTo(root, { duration: 0.9 }) : root.scrollIntoView({ behavior: 'smooth' })
      requestAnimationFrame(clip)
    }
    /** fade the excerpt only when it is cut short; a whole review that fits needs no "continue reading" */
    const clip = () =>
      root.querySelectorAll<HTMLElement>('.pn.is-on').forEach((pn) => {
        const b = pn.querySelector<HTMLElement>('.pn__body')
        if (!b) return
        const cut = b.scrollHeight > b.clientHeight + 2
        b.classList.toggle('is-clipped', cut)
        pn.classList.toggle('is-cut', cut)
      })
    // scrolling away from an open shelf closes it
    const onScroll = () => {
      if (!root.classList.contains('is-inspecting') || performance.now() < settling) return
      if (Math.abs(root.getBoundingClientRect().top) > innerHeight * 0.3) root.classList.remove('is-inspecting')
    }
    // so does a click anywhere outside the review, except on this shelf's own items and arrows,
    // which move along with the review open
    const onOutside = (e: MouseEvent) => {
      if (!root.classList.contains('is-inspecting')) return
      const t = e.target as Element
      if (panel.contains(t) || (root.contains(t) && t.closest('.bk, [data-step], .lab__go'))) return
      inspect(false)
    }
    addEventListener('resize', clip)
    addEventListener('scroll', onScroll, { passive: true })
    document.addEventListener('click', onOutside)
    document.addEventListener(
      'astro:before-swap',
      () => {
        removeEventListener('resize', clip)
        removeEventListener('scroll', onScroll)
        document.removeEventListener('click', onOutside)
      },
      { once: true },
    )
    root.addEventListener('click', (e) => {
      if (performance.now() - dragged < 400) return
      const t = e.target as HTMLElement
      const bk = t.closest<HTMLElement>('.bk')
      if (bk) bk.classList.contains('is-active') ? inspect(true) : set(+bk.dataset.i!)
      const step = t.closest<HTMLElement>('[data-step]')
      if (step) set(+root.dataset.active! + +step.dataset.step!)
      if (t.closest('.lab__go')) inspect(true)
      if (t.closest('.cs__back')) inspect(false)
    })
    root.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !root.classList.contains('is-inspecting')) return
      const r = root.getBoundingClientRect()
      root.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 36}deg`)
      root.style.setProperty('--rx', `${-((e.clientY - r.top) / r.height - 0.5) * 14}deg`)
    })
    // touch: one swipe moves one item, like the arrows. While the finger is down the shelf gives
    // a little under it (with resistance, never more than a spine or so) so the swipe feels held;
    // following the finger one to one skipped a dozen thin record spines per swipe.
    // Vertical moves are left to the page.
    const PULL = 44
    let sx = 0
    let sy = 0
    let t0 = 0
    let dragged = 0
    let axis: 'x' | 'y' | null = null
    root.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length !== 1 || root.classList.contains('is-inspecting')) return (axis = 'y')
        sx = e.touches[0].clientX
        sy = e.touches[0].clientY
        t0 = performance.now()
        axis = null
      },
      { passive: true },
    )
    root.addEventListener(
      'touchmove',
      (e) => {
        if (axis === 'y') return
        const t = e.touches[0]
        const dx = t.clientX - sx
        if (!axis) {
          if (Math.hypot(dx, t.clientY - sy) < 8) return
          axis = Math.abs(dx) > Math.abs(t.clientY - sy) ? 'x' : 'y'
          if (axis === 'y') return
          root.classList.add('is-dragging')
        }
        shelf.style.transform = `translateX(${-shelfX + PULL * Math.tanh(dx / 140)}px)`
      },
      { passive: true },
    )
    const endDrag = (e: TouchEvent) => {
      if (axis !== 'x') return
      axis = null
      root.classList.remove('is-dragging')
      const dx = e.changedTouches[0].clientX - sx
      dragged = performance.now()
      const at = +root.dataset.active!
      // a deliberate swipe, or a short quick flick, moves one; anything less springs back
      const flick = dragged - t0 < 250 && Math.abs(dx) > 12
      const dir = Math.abs(dx) > 30 || flick ? Math.sign(dx) : 0
      set(at - dir)
    }
    root.addEventListener('touchend', endDrag)
    root.addEventListener('touchcancel', endDrag)
    ;(root as any).__set = set
    ;(root as any).__inspect = inspect
    set(0)
  }

  // the arrow keys drive whichever shelf is most on screen
  const current = () =>
    [...document.querySelectorAll<HTMLElement>('.cs')]
      .map((el) => {
        const r = el.getBoundingClientRect()
        return [el, Math.min(r.bottom, innerHeight) - Math.max(r.top, 0)] as const
      })
      .sort((a, b) => b[1] - a[1])[0]?.[0]
  addEventListener('keydown', (e) => {
    const root = current() as any
    if (!root) return
    if (e.key === 'ArrowRight') root.__set(+root.dataset.active + 1)
    else if (e.key === 'ArrowLeft') root.__set(+root.dataset.active - 1)
    else if (e.key === 'Escape') root.__inspect(false)
  })

  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('.cs').forEach(setup))
</script>

<style is:global>
  .cs {
    --H: min(66vh, 660px);
    --W: calc(var(--H) * 0.66);
    --gap: 40px;
    --extra: 0px;
    --ease-cs: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    color: var(--ultramarine);
    outline: none;
  }
  .cs--record {
    --H: min(54vh, 540px);
    --W: var(--H);
    --extra: calc(var(--H) * 0.22);
  }
  .cs--book {
    --H: min(60vh, 600px);
  }
  .cs--film {
    --H: min(60vh, 600px);
    --W: calc(var(--H) * 0.71);
  }

  .cs__top {
    position: absolute; z-index: 5; left: 4vw; right: 4vw; top: 4.2rem;
    display: flex; justify-content: space-between;
    font: 0.75rem var(--font-din); letter-spacing: 0.18em;
  }
  .cs__count b { font-weight: 400; }
  /* without JS the shelf cannot be browsed: its arrows go, and a plain list of
     links to every review stands in for it */
  :global(html:not(.js)) .cs__nav { display: none; }
  .cs__plain { list-style: none; margin: 0 var(--gutter) 2rem; padding: 0; columns: 16rem; column-gap: 2rem; }
  .cs__plain li { break-inside: avoid; padding-block: 0.3rem; border-bottom: 1px solid var(--rule); }
  .cs__plain a { font: italic 1.25rem var(--font-display); color: var(--ultramarine); }
  .cs__plain span { font: italic 0.95rem var(--font-body); color: var(--ink-soft); }
  .cs__top { align-items: center; }
  /* previous · count · next, as one object */
  .cs__nav { display: inline-flex; align-items: center; gap: 1.3rem; }
  .cs__nav button { all: unset; cursor: pointer; display: inline-flex; padding: 0.4rem 0; transition: translate 0.3s var(--ease-out), opacity 0.3s; }
  @media (hover: hover) {
    .cs__nav button:first-child:hover { translate: -4px 0; }
    .cs__nav button:last-child:hover { translate: 4px 0; }
  }
  .cs__nav button:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }


  .cs__stage {
    position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--H) + 200px);
    /* a level, straight-on eye at the facing item (as on mint's shelf): the
       packed spines hide each other's sides, and the tops stay out of view */
    --sx: 30vw;
    perspective: 2600px; perspective-origin: calc(var(--sx) + var(--W) / 2 + 20px) 42%;
    transition: perspective-origin 1s var(--ease-cs);
  }
  /* the shadow along the back of the shelf: ::before, so it paints behind the items rather than as
     a blurred band across their bottom edges */
  .cs__stage::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: 104px; height: 40px;
    background: linear-gradient(rgb(17 19 90 / 0.28), transparent); filter: blur(6px); pointer-events: none;
  }
  .cs__plank {
    position: absolute; left: -5vw; right: -5vw; bottom: 46px; height: 64px;
    background: linear-gradient(#5a5a9a, #4a4a8c 30%, #3d3d7e);
    border-top: 1.5px solid var(--ultramarine);
    box-shadow: 0 -2px 0 rgb(255 255 255 / 0.12) inset, 0 30px 40px -20px rgb(17 19 90 / 0.5);
  }
  .cs__shelf {
    position: absolute; left: var(--sx); bottom: 104px;
    display: flex; align-items: flex-end; gap: 0;
    transform-style: preserve-3d;
    transition: transform 1s var(--ease-cs), left 1s var(--ease-cs);
  }

  /* ---------- an item: a box, spine d wide, H tall, W deep ---------- */
  .bk {
    all: unset; cursor: pointer; position: relative; flex: none;
    width: var(--d); height: var(--H);
    transform-style: preserve-3d;
    transition: width 1s var(--ease-cs), transform 0.5s var(--ease-cs), opacity 0.6s;
  }
  /* only spines next to the facing item show their sides, so the rest skip their other faces (edge-on
     anyway) and the browser composites one plane per spine instead of five. They stay in 3D: flattening
     them, the obvious way to do this, made Firefox drop spines that left the 3D window, which showed
     as gaps along the shelf. */
  .bk:not(.is-near, .is-leaving) .bk__box > span:not(.bk__spine) { visibility: hidden; }
  .bk.is-active { width: calc(var(--W) + var(--gap) + var(--extra)); }
  @media (hover: hover) {
    .bk:not(.is-active):hover { transform: translateY(-16px); }
  }
  .bk { -webkit-tap-highlight-color: transparent; }
  /* sideways moves belong to the shelf, vertical ones to the page */
  .cs__stage { touch-action: pan-y; }
  .cs.is-dragging .cs__shelf { transition: none; }
  .bk__box {
    position: absolute; left: 0; bottom: 0; width: var(--d); height: 100%;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--W) / -2));
    transition: transform 1s var(--ease-cs), left 1s var(--ease-cs);
  }
  .bk__box > span { position: absolute; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .bk__spine {
    left: 0; top: 0; width: var(--d); height: 100%; box-sizing: border-box;
    background: var(--c); color: var(--f);
    transform: translateZ(calc(var(--W) / 2));
    display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 12px;
    padding: 24px 0 20px;
    /* the dark right edge doubles as the gap between spines (a real gap rounds to
       0-3px under 3D transforms); the outer ring closes the seam with the cover */
    box-shadow: inset 4px 0 0 rgb(255 255 255 / 0.1), inset -2px 0 0 rgb(0 0 0 / 0.45), 0 0 0 0.6px var(--c);
  }
  /* the title is sized to its spine (--sr of its width, at most --st) and sits centred in the space
     above the name; a long one shortens with an ellipsis rather than run into the name */
  .bk__st {
    --st: 1.75rem; --sr: 0.55;
    writing-mode: vertical-rl; rotate: 180deg; font: italic min(var(--st), calc(var(--d) * var(--sr)))/1 var(--font-display);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 0; flex: 0 1 auto; margin: auto 0; /* physical: on vertical text "block" runs across the spine */
  }
  .bk__sa, .bk__no { flex: none; }
  .bk__sa { writing-mode: vertical-rl; rotate: 180deg; font: 0.62rem var(--font-din); letter-spacing: 0.16em; text-transform: uppercase; }
  .bk__cover {
    top: 0; height: 100%; width: var(--W); left: calc((var(--d) - var(--W)) / 2);
    background: var(--c) center / cover no-repeat;
    transform: rotateY(-90deg) translateZ(calc(var(--d) / 2));
    box-shadow: inset 8px 0 12px -4px rgb(0 0 0 / 0.35), 0 0 0 0.6px var(--c);
  }
  /* the back cover: without it you see the inside of the front cover between spines */
  .bk__back {
    top: 0; height: 100%; width: var(--W); left: calc((var(--d) - var(--W)) / 2);
    background: linear-gradient(90deg, rgb(0 0 0 / 0.18), rgb(0 0 0 / 0.32)), var(--c);
    transform: rotateY(90deg) translateZ(calc(var(--d) / 2));
  }
  .cs--film .bk__back { background: #1a1a1f; }
  .bk__cover::after {
    content: ''; position: absolute; inset: 0; background: rgb(12 12 40 / 0.7);
