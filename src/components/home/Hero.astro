---
/**
 * Board 1: the four roads and the name.
 *
 * Every number here comes from design/website/board1.svg (a 1920×1080 board),
 * so the wide drawing is the artwork itself. Tall screens (phones) keep the
 * frame, the tag and the name, and the four roads move into a menu that opens
 * from the button on the frame.
 *
 * Intro: the four roads draw in together from the edges of the page; then the
 * name is written the way a hand would write it (./pen.ts): one movement from
 * the L's hook to the last a's tail, going back up and down its strokes, with
 * the i dotted at the end; the labels settle last.
 */
import { NAV } from '@/consts'
import Flip from '@/components/Flip.astro'
import name from './lunalgia.json' // glyph outlines, positioned as in board1
import { PEN, penPath } from './pen'

type Road = {
  href: string
  label: string
  d: string
  /** translate applied to the path in the board file */
  t: [number, number]
  /** which end of the path sits on the edge of the page */
  edge: 'start' | 'end'
  /** label origin + rotation, exactly as placed in the board */
  lx: number
  ly: number
  rot: number
  /** where the label starts along the road (board units; measured from the
      board's label origin), and whether it reads against the path's direction */
  at: number
  rev?: boolean
}

const roads: Road[] = [
  {
    href: '/bookmarks',
    label: 'bookmarks',
    d: 'M-1.694,70.528C138.873,236.195 230.926,276.209 607.518,313.867C782.527,331.368 853.321,467.957 857.76,470.916',
    t: [-24.145437, -3.113047],
    edge: 'start',
    lx: 366.1,
    ly: 273.6,
    rot: 6.14,
    at: 458,
  },
  {
    href: '/media',
    label: 'media',
    d: 'M1152.874,517.513C1306.225,498.344 1395.928,251.659 1406.568,222.4C1504.193,-46.07 1633.374,-73.59 1660.262,-96.875',
    t: [70.211251, 2.402224],
    edge: 'end',
    lx: 1379.6,
    ly: 393.0,
    rot: -61.18,
    at: 210,
  },
  {
    href: '/academics',
    label: 'academics',
    d: 'M1116.632,596.9C1278.731,948.118 1565.266,863.35 1967.456,943.788C2028.351,955.967 2073.084,996.81 2079.634,1000.74',
    t: [85.529476, 3.129263],
    edge: 'end',
    lx: 1423.2,
    ly: 819.6,
    rot: 15.69,
    at: 323,
  },
  {
    // continues 263px down into the Writings board, as in the artwork
    href: '/work',
    label: 'work',
    d: 'M776.647,605.53C612.651,621.929 449.699,855.587 386.614,981.756C342.878,1069.228 246.9,1359.63 -32.758,1371.789',
    t: [-64.553931, -28.325576],
    edge: 'end',
    lx: 379.9,
    ly: 828.9,
    rot: -52.41,
    at: 742,
    rev: true,
  },
]

/** apply a path's translate from the board file to its coordinates */
const mapPath = (d: string, [tx, ty]: [number, number]) =>
  d.replace(/(-?[\d.]+),(-?[\d.]+)/g, (_, a, b) => `${(+a + tx).toFixed(2)},${(+b + ty).toFixed(2)}`)

// ---------- the tall (phone) drawing ----------
// Phones get the frame, the tag and the name only (bigger, centred); the roads
// become a menu behind the button on the frame (see .hmenu below).
const TALL = { w: 760, h: 1600 }
const NAME = { cx: 967, cy: 543, w: 478 } // the name's box in board1
const TALL_NAME_SCALE = (TALL.w * 0.8) / NAME.w

/** the same cubic path run backwards, so a label can read the other way along it */
const reversePath = (d: string) => {
  const pts = [...d.matchAll(/(-?[\d.]+),(-?[\d.]+)/g)].map((m) => `${m[1]},${m[2]}`).reverse()
  let out = `M${pts[0]}`
  for (let i = 1; i < pts.length; i += 3) out += `C${pts[i]} ${pts[i + 1]} ${pts[i + 2]}`
  return out
}

const wideRoads = roads.map((r) => {
  const path = mapPath(r.d, r.t)
  return { ...r, path, text: r.rev ? reversePath(path) : path }
})

const drawings = [
  {
    id: 'wide',
    // cut just under the frame, so the next board starts as far below it as the frame is from the top
    viewBox: '0 0 1920 1040',
    roads: wideRoads,
    nameAt: '',
    frame: { x: 44.546, y: 51.983, w: 1830.143, h: 983.8 },
    tag: { x: 960, y: 51.983 + 7.8, pw: 158.8 },
  },
  {
    id: 'tall',
    viewBox: `0 0 ${TALL.w} ${TALL.h}`,
    roads: [] as typeof wideRoads,
    nameAt: `translate(${TALL.w / 2} ${TALL.h / 2}) scale(${TALL_NAME_SCALE}) translate(${-NAME.cx} ${-NAME.cy})`,
    frame: { x: 24, y: 44, w: TALL.w - 48, h: TALL.h - 88 },
    tag: { x: TALL.w / 2, y: 44 + 7.8, pw: 158.8 },
  },
]
---

<section class="hero" aria-label="lunalgia">
  <h1 class="visually-hidden">Lunalgia, the website of Lilian</h1>
  {
    drawings.map((g) => (
      <svg
        class={`hero__art hero__art--${g.id}`}
        viewBox={g.viewBox}
        preserveAspectRatio={g.id === 'wide' ? 'xMidYMin meet' : 'xMidYMid meet'}
        role="navigation"
        aria-label="sections"
      >

        <path
          class="hero__frame"
          d={`M${g.frame.x + g.frame.w / 2} ${g.frame.y}H${g.frame.x + g.frame.w}V${g.frame.y + g.frame.h}H${g.frame.x}V${g.frame.y}Z`}
        />
        <rect class="hero__tagpatch" x={g.tag.x - g.tag.pw / 2} y={g.frame.y - 20} width={g.tag.pw} height="40" />
        <text class="hero__tag" x={g.tag.x} y={g.tag.y} text-anchor="middle">
          lit. moon pain
        </text>
        {/* its counterpart on the bottom edge: the way to the about page */}
        <a class="hero__about" href="/about">
          <rect class="hero__tagpatch" x={g.tag.x - g.tag.pw / 2} y={g.frame.y + g.frame.h - 20} width={g.tag.pw} height="40" data-bottom />
          <text class="hero__tag" x={g.tag.x} y={g.frame.y + g.frame.h + 7.8} text-anchor="middle" data-bottom>
            about me
          </text>
        </a>

        {g.roads.map((r) => (
          <a class="road" href={r.href} data-edge={r.edge}>
            <path class="road__hit" d={r.path} />
            <path class="road__line" d={r.path} />
            {/* the label rides the road, a little above it, bending with it */}
            <path id={`road-${r.label}`} class="road__guide" d={r.text} />
            <text class="road__label" dy="-13">
              <textPath href={`#road-${r.label}`} startOffset={r.at}>{r.label}</textPath>
            </text>
          </a>
        ))}

        <a class="hero__name" href="#hello" aria-label="Lunalgia: about me">
          <g transform={g.nameAt || undefined} data-tall-name={g.id === 'tall' ? `${TALL_NAME_SCALE} ${NAME.cx} ${NAME.cy}` : undefined}>
            {/* the pen: each letter shows only where its strokes have been drawn (masks set by the script) */}
            <defs>
              {name.letters.map((_, i) => (
                <mask id={`pen-${g.id}-${i}`} maskUnits="userSpaceOnUse" x="0" y="0" width="2000" height="1200">
                  {PEN.map((p, order) =>
                    p.letter === i ? <path class="hero__pen" d={penPath(p.pts)} stroke-width={p.w} data-order={order} data-lift={p.lift ? '' : undefined} data-retrace={p.retrace ? '' : undefined} /> : null,
                  )}
                </mask>
              ))}
            </defs>
            <g class="hero__ink">
              {name.letters.map((l, i) => (
                <path class="hero__letter" d={l.d} data-mask={`url(#pen-${g.id}-${i})`} />
              ))}
            </g>
          </g>
        </a>
      </svg>
    ))
  }
  <button class="hmenu__btn" type="button" aria-expanded="false" aria-controls="hmenu">
    <span class="hmenu__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="visually-hidden">menu</span>
  </button>
</section>

<nav id="hmenu" class="hmenu" aria-label="sections" hidden>
  <div class="hmenu__frame" aria-hidden="true"></div>
  <p class="hmenu__tag">lit. moon pain</p>
  <button class="hmenu__close" type="button" aria-label="close the menu">
    <span aria-hidden="true"><i></i><i></i></span>
  </button>
  <ol class="hmenu__list" role="list">
    {
      NAV.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href}>
            <span class="hmenu__n">{String(i + 1).padStart(2, '0')}</span>
            <em><Flip word={l.label} to={l.label} /></em>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  import { gsap } from 'gsap'
  import { markIntroDone, markIntroRunning } from '@/scripts/after-intro'

  /** show only [a, b] of a path (in length units) using a single dash */
  const range = (p: SVGPathElement, len: number, a: number, b: number) => {
    p.style.strokeDasharray = `0 ${Math.max(a, 0)} ${Math.max(b - a, 0)} ${len * 2}`
  }

  /** size the paper patch under "lit. moon pain" to the text as actually rendered */
  const fitTags = () =>
    document.fonts.ready.then(() =>
      document.querySelectorAll<SVGSVGElement>('.hero__art').forEach((svg) => {
        if (getComputedStyle(svg).display === 'none') return
        // each label sits on its own patch, the rect just before it
        svg.querySelectorAll<SVGTextElement>('.hero__tag').forEach((text) => {
          const patch = text.previousElementSibling
          if (!(patch instanceof SVGRectElement)) return
          const b = text.getBBox()
          const pad = b.height * 0.45
          patch.setAttribute('x', String(b.x - pad))
          patch.setAttribute('width', String(b.width + pad * 2))
        })
      }),
    )

  /**
   * The tall drawing is only a frame and the name, so instead of cropping a fixed
   * board to the screen it takes the screen's own shape: the board stays 760
   * wide and becomes as tall as the screen needs, with the frame redrawn to fit.
   */
  const fitTall = (hero: HTMLElement) => {
    const svg = hero.querySelector<SVGSVGElement>('.hero__art--tall')
    if (!svg || getComputedStyle(svg).display === 'none') return
    const { width, height } = svg.getBoundingClientRect()
    if (!width || !height) return
    const W = 760
    const H = Math.round((W * height) / width)
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`)
    const m = 24
    const top = 44
    svg.querySelector('.hero__frame')?.setAttribute('d', `M${W / 2} ${top}H${W - m}V${H - top}H${m}V${top}Z`)
    svg.querySelector('rect[data-bottom]')?.setAttribute('y', String(H - top - 20))
    svg.querySelector('text[data-bottom]')?.setAttribute('y', String(H - top + 7.8))
    const name = svg.querySelector<SVGGElement>('[data-tall-name]')
    if (name) {
      const [scale, cx, cy] = name.dataset.tallName!.split(' ')
      name.setAttribute('transform', `translate(${W / 2} ${H / 2}) scale(${scale}) translate(${-cx} ${-cy})`)
    }
  }

  /**
   * Seat the menu button on the visible frame's top line, at its right end, like
   * the frame's labels; the open menu draws its own frame in the same place.
   */
  const placeMenuButton = (hero: HTMLElement) => {
    const svg = [...hero.querySelectorAll<SVGSVGElement>('.hero__art')].find((el) => getComputedStyle(el).display !== 'none')
    const frame = svg?.querySelector('.hero__frame')
    if (!frame) return
    const f = frame.getBoundingClientRect()
    const h = hero.getBoundingClientRect()
    const root = document.documentElement.style
    root.setProperty('--hf-top', `${f.top - h.top}px`)
    root.setProperty('--hf-side', `${h.right - f.right}px`)
  }

  /** the phone menu: the roads, as a list, behind the button on the frame */
  const menu = (hero: HTMLElement) => {
    const btn = hero.querySelector<HTMLButtonElement>('.hmenu__btn')
    const nav = document.getElementById('hmenu')
    if (!btn || !nav) return
    const closeBtn = nav.querySelector<HTMLButtonElement>('.hmenu__close')!
    let hideTimer = 0
    const lenis = () => (window as any).__lenis as { stop(): void; start(): void } | undefined
    const set = (open: boolean) => {
      clearTimeout(hideTimer)
      btn.setAttribute('aria-expanded', String(open))
      document.documentElement.classList.toggle('hmenu-open', open)
      if (open) {
        nav.hidden = false
        void nav.offsetWidth
        nav.classList.add('is-open')
        lenis()?.stop()
        closeBtn.focus({ preventScroll: true })
      } else {
        nav.classList.remove('is-open')
        lenis()?.start()
        hideTimer = window.setTimeout(() => (nav.hidden = true), 450)
      }
    }
    btn.addEventListener('click', () => set(true))
    closeBtn.addEventListener('click', () => {
      set(false)
      btn.focus({ preventScroll: true })
    })
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)))
    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && !nav.hidden && set(false)
    document.addEventListener('keydown', onKey)
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKey)
        document.documentElement.classList.remove('hmenu-open')
        lenis()?.start()
      },
      { once: true },
    )
    placeMenuButton(hero)
    const ro = new ResizeObserver(() => {
      fitTall(hero)
      placeMenuButton(hero)
    })
    ro.observe(hero)
    document.addEventListener('astro:before-swap', () => ro.disconnect(), { once: true })
  }

  const play = () => {
    fitTags()
    const hero = document.querySelector<HTMLElement>('.hero')
    if (!hero || hero.dataset.ready) return
    hero.dataset.ready = '1'
    fitTall(hero)
    menu(hero)

    let seen = false
    try {
      seen = sessionStorage.getItem('lunalgia:drawn') === '1'
      sessionStorage.setItem('lunalgia:drawn', '1')
    } catch {}
    const instant = seen || matchMedia('(prefers-reduced-motion: reduce)').matches

    const svg = [...hero.querySelectorAll<SVGSVGElement>('.hero__art')].find(
      (el) => getComputedStyle(el).display !== 'none',
    )
    if (!svg) return markIntroDone()
    if (instant) {
      svg.classList.add('is-ready')
      return markIntroDone()
    }
    markIntroRunning()

    const letters = [...svg.querySelectorAll<SVGPathElement>('.hero__letter')]
    const labels = svg.querySelectorAll('.road__label')
    const frame = svg.querySelector<SVGPathElement>('.hero__frame')!
    const frameLen = frame.getTotalLength()
    const tag = [...svg.querySelectorAll('.hero__tag, .hero__tagpatch'), hero.querySelector('.hmenu__btn')]

    // where the bottom of the screen is, in board units
    const pt = new DOMPoint(0, innerHeight).matrixTransform(svg.getScreenCTM()!.inverse())
    const screenBottom = pt.y + 4

    // ---- starting state ----
    const roads = [...svg.querySelectorAll<SVGAElement>('.road')].map((road) => {
      const line = road.querySelector<SVGPathElement>('.road__line')!
      const len = line.getTotalLength()
      // a road may run on below the screen (work does, into Writings): it is drawn
      // from the point where it leaves the screen, and the hidden rest is filled in
      // at the end, so nothing is ever missing on screen
      let cut = len
      if (road.dataset.edge === 'end' && line.getPointAtLength(len).y > screenBottom) {
        let lo = 0
        let hi = len
        for (let i = 0; i < 24; i++) {
          const mid = (lo + hi) / 2
          if (line.getPointAtLength(mid).y < screenBottom) lo = mid
          else hi = mid
        }
        cut = hi
      }
      line.classList.add('is-drawing')
      return { road, line, len, cut, fromEnd: road.dataset.edge === 'end' }
    })
    roads.forEach(({ line, len }) => range(line, len, 0, 0))
    // the pen's strokes in writing order, each hidden until the pen gets to it
    const pen = [...svg.querySelectorAll<SVGPathElement>('.hero__pen')]
      .sort((a, b) => +a.dataset.order! - +b.dataset.order!)
      .map((el) => ({ el, len: el.getTotalLength(), lift: el.dataset.lift !== undefined, retrace: el.dataset.retrace !== undefined }))
    pen.forEach(({ el, len, lift }) => {
      if (lift) el.style.strokeWidth = '0'
      else {
        el.style.strokeDasharray = `${len} ${len + 1}`
        el.style.strokeDashoffset = String(len)
      }
    })
    letters.forEach((l) => l.setAttribute('mask', l.dataset.mask!))
    gsap.set(labels, { opacity: 0, y: 6 })
    frame.style.strokeDasharray = `0 ${frameLen}`
    frame.style.opacity = '0' // a zero-length dash still leaves a speck at the corner
    gsap.set(tag, { opacity: 0 })
    svg.classList.add('is-ready')

    const tl = gsap.timeline({ delay: 0.25 })

    // 1. the frame grows both ways from the "lit. moon pain" tag, quietly
    const f = { t: 0 }
    tl.to(
      f,
      {
        t: 1,
        duration: 2.6,
        ease: 'power2.inOut',
        onUpdate: () => {
          const h = (frameLen / 2) * f.t
          frame.style.opacity = h > 0.5 ? '1' : '0'
          frame.style.strokeDasharray = `${h} ${frameLen - 2 * h} ${h} 0`
        },
        onComplete: () => frame.removeAttribute('style'),
      },
      0,
    )

    // 2. four roads, together, from the edges of the screen in to the name
    const p = { t: 0 }
    tl.to(
      p,
      {
        t: 1,
        duration: 2.2,
        ease: 'power2.inOut',
        onUpdate: () =>
          roads.forEach(({ line, len, cut, fromEnd }) =>
            fromEnd ? range(line, len, cut * (1 - p.t), cut) : range(line, len, 0, len * p.t),
          ),
        onComplete: () =>
          roads.forEach(({ line }) => {
            line.style.strokeDasharray = ''
            line.classList.remove('is-drawing')
          }),
      },
      0.1,
    )

    // 3. the name, written: one sweep of the pen, easing in as it sets down and
    // out as it lifts, and quicker where it only goes back over its own ink; then
    // it comes back to dot the i (with no roads first, on phones, it starts sooner)
    const START = roads.length ? 1.5 : 0.6
    const WRITE = 2.1
    const RETRACE = 0.3 // a retraced stretch takes this share of the time of fresh ink
    const draw = (strokes: typeof pen, at: number, duration: number, ease: string) => {
      const cost = strokes.map((s) => s.len * (s.retrace ? RETRACE : 1))
      const total = cost.reduce((a, b) => a + b, 0)
      const w = { t: 0 }
      tl.to(
        w,
        {
          t: total,
          duration,
          ease,
          onUpdate: () => {
            let from = 0
            strokes.forEach((s, i) => {
              const done = Math.min(Math.max((w.t - from) / cost[i], 0), 1)
              s.el.style.strokeDashoffset = String(s.len * (1 - done))
              from += cost[i]
            })
          },
        },
        at,
      )
    }
    draw(pen.filter((s) => !s.lift), START, WRITE, 'sine.inOut')
    // the dot: after a beat, the pen touches down and the ink spreads from that point
    pen
      .filter((s) => s.lift)
      .forEach((s) => tl.to(s.el, { strokeWidth: +s.el.getAttribute('stroke-width')!, duration: 0.5, ease: 'power2.out' }, START + WRITE + 0.18))
    const done = START + WRITE + 0.35

    // 4. labels and the tag settle
    tl.to(labels, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out', stagger: 0.1 }, done - 1.2)
    tl.to(tag, { opacity: 1, duration: 1.2, ease: 'power2.out' }, done - 1)
    // the word stands on its own again, so not a pixel can stay under the masks
    tl.call(() => {
      letters.forEach((l) => l.removeAttribute('mask'))
      pen.forEach(({ el }) => el.removeAttribute('style'))
    })

    // any input hurries the drawing to its end (a jump straight to the end reads as a stutter)
    const finish = () => {
      off()
      gsap.to(tl, { timeScale: 7, duration: 0.35, ease: 'power1.in' })
    }
    const events = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const
    const off = () => events.forEach((e) => removeEventListener(e, finish))
    events.forEach((e) => addEventListener(e, finish, { passive: true, once: true }))
    tl.eventCallback('onComplete', () => {
      off()
      markIntroDone()
    })
  }

  document.addEventListener('astro:page-load', play)
</script>

<style>
  .hero {
    position: relative;
    z-index: 2;
    height: 100svh;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__art--wide {
    display: none;
  }
  @media (min-aspect-ratio: 4/3) {
    .hero {
      height: auto;
      aspect-ratio: 1920 / 1040;
    }
    .hero__art--wide {
      display: block;
    }
    .hero__art--tall {
      display: none;
    }
  }
  @media (max-aspect-ratio: 4/3) {
    .hero {
      overflow: hidden;
    }
  }
  /* nothing shows until the script has set the first frame */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .hero__art:not(.is-ready) {
      visibility: hidden;
    }
  }

  .hero__frame {
    fill: none;
    stroke: var(--ultramarine);
    stroke-width: 1.93px;
  }
  .hero__art--tall .hero__frame {
    stroke-width: 2.6px;
  }
  .hero__tagpatch {
    fill: var(--lavender);
  }
  .hero__tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 26px;
    fill: var(--ultramarine);
  }
  .hero__about {
    outline: none;
  }
  .hero__about:is(:hover, :focus-visible) .hero__tag {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .road {
    outline: none;
  }
  .road__hit {
    fill: none;
    stroke: transparent;
    stroke-width: 40px;
    vector-effect: non-scaling-stroke;
  }
  .road__line {
    fill: none;
    stroke: var(--ultramarine);
    stroke-width: 1.15px;
    stroke-linecap: round;
    transition: stroke-width 0.5s var(--ease-out);
  }
  .hero__art--tall .road__line {
    stroke-width: 2.2px;
  }
  .road__guide {
    fill: none;
    stroke: none;
  }
  .road__label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 60px;
    fill: var(--ultramarine);
    transition: letter-spacing 0.6s var(--ease-out);
  }
  .road:is(:hover, :focus-visible) .road__line {
    stroke-width: 2.6px;
  }
  .road:is(:hover, :focus-visible) .road__label {
    letter-spacing: 0.06em;
  }

  .hero__name {
    outline: none;
  }
  .hero__ink {
    fill: var(--ultramarine);
  }
  /* the nib: white in a mask shows the letter beneath it */
  .hero__pen {
