---
import Flip from '@/components/Flip.astro'
/**
 * Board 2: Writings. A "garden" in the henry.codes sense: the three kinds of
 * writing, each with a faint description; hovering a kind opens its latest
 * pieces. Positions are in board units (1920 wide).
 */
import { Image } from 'astro:assets'
import { WRITING_KINDS } from '@/content.config'
import { emphasize, getPosts } from '@/lib/utils'
import lily from '@/assets/home/lily.png'
import lilyPale from '@/assets/home/lily-pale.png'

const posts = await getPosts()
const kinds = (Object.keys(WRITING_KINDS) as (keyof typeof WRITING_KINDS)[]).map((k, i) => ({
  key: k,
  n: String(i + 1).padStart(2, '0'),
  ...WRITING_KINDS[k],
  items: posts.filter((p) => p.data.kind === k).slice(0, 3),
}))
const open = kinds.findIndex((k) => k.items.length > 0)
const date = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')} · ${String(d.getMonth() + 1).padStart(2, '0')} · ${String(d.getFullYear()).slice(2)}`
// DINdong "Writings", with the letter positions from the board
const letters = [
  ['W', 106.24],
  ['r', 254.25],
  ['i', 305.23],
  ['t', 342.49],
  ['i', 392.91],
  ['n', 429.54],
  ['g', 508.36],
  ['s', 590.13],
] as const
---

<section class="writings board" aria-labelledby="writings-title">
  <div class="panel writings__panel">
    <i class="writings__rule" aria-hidden="true"></i>
    <i class="writings__rule writings__rule--end" aria-hidden="true"></i>
    <div class="writings__clip">
      <div class="writings__lily" aria-hidden="true">
        <div class="writings__wm">
          <Image src={lilyPale} alt="" width={1334} class="writings__wm-img" />
          <canvas></canvas>
        </div>
        <Image src={lily} alt="" width={1334} class="writings__ink" />
      </div>
      <div class="writings__ring" aria-hidden="true"></div>
    </div>
  </div>

  <h2 id="writings-title" class="writings__title" aria-label="Writings">
    <svg viewBox="0 0 760 260" aria-hidden="true">
      {letters.map(([ch, x]) => (
        <text x={x} y="224.39">
          {ch}
        </text>
      ))}
    </svg>
  </h2>

  <div class="garden">
    <p class="meta garden__meta">the garden · sorted by how finished it is</p>
    <ul class="garden__rows" role="list">
      {
        kinds.map((k, i) => (
          <li class:list={['garden__row', { 'is-open': i === (open < 0 ? 0 : open) }]} data-kind={k.key}>
            <a class="garden__head" href={`/writing#${k.key}`}>
              <span class="garden__n">({k.n})</span>
              <span class="garden__kind">{k.label}</span>
              <span class="garden__blurb">{k.blurb}</span>
            </a>
            <div class="garden__drawer">
              <ol class="garden__entries" role="list">
                {k.items.map((p) => (
                  <li>
                    <a href={`/writing/${p.id}`}>
                      <span class="garden__entry" set:html={emphasize(p.data.title)} />
                      <span class="garden__date">{date(p.data.date)}</span>
                    </a>
                  </li>
                ))}
                {k.items.length < 2 && (
                  <li class="garden__ghost">
                    <span class="garden__entry">the next one goes here</span>
                    <span class="garden__date">— · — · —</span>
                  </li>
                )}
              </ol>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <a class="writings__all" href="/writing"><Flip word="every piece, by date" to="every piece, by date" /><span aria-hidden="true"></span></a>
  <p class="meta writings__count">{kinds.length} kinds · {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} so far</p>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { afterIntro, whenIdle } from '@/scripts/after-intro'
  gsap.registerPlugin(ScrollTrigger)

  /**
   * The lily develops out of an ordered dither, like a print in a tray.
   *
   * Each pixel gets a threshold (4×4 Bayer, a little noise, a top-to-bottom
   * bias) and appears once the reveal passes it. The thresholds are worked out
   * in a WebGL shader, so a frame of the reveal is one draw call on the GPU:
   * no pixels are touched or re-uploaded from the main thread while the page
   * scrolls. Without WebGL the picture simply fades in.
   */
  const W = 900
  const VERT = `attribute vec2 p; varying vec2 uv;
    void main() { uv = vec2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5); gl_Position = vec4(p, 0.0, 1.0); }`
  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    varying vec2 uv;
    uniform sampler2D img;
    uniform vec2 size;
    uniform float t;
    // 2×2 Bayer, nested once for 4×4 (values 0..15/16)
    float b2(vec2 a) { a = floor(a); return fract(a.x * 0.5 + a.y * a.y * 0.75); }
    float bayer(vec2 a) { return b2(a * 0.5) * 0.25 + b2(a); }
    float noise(vec2 c) { return fract(sin(dot(c, vec2(12.9898, 78.233))) * 43758.5453); }
    void main() {
      vec2 px = floor(uv * size);
      // the dither cell is 2×2 canvas pixels
      float th = bayer(floor(px * 0.5)) * 0.55 + noise(px) * 0.25 + uv.y * 0.2;
      // premultiplied here, whatever the browser did with the bitmap's alpha
      vec4 c = texture2D(img, uv);
      gl_FragColor = vec4(c.rgb * c.a, c.a) * step(th, t);
    }`

  type Plan = { draw: (t: number) => void; dispose: () => void } | null

  const prepare = async (box: HTMLElement): Promise<Plan> => {
    const img = box.querySelector<HTMLImageElement>('img')!
    const canvas = box.querySelector<HTMLCanvasElement>('canvas')!
    // wait for the hero to finish drawing
    await afterIntro()
    if (!img.complete) await new Promise((r) => img.addEventListener('load', r, { once: true }))
    const h = Math.round((img.naturalHeight / img.naturalWidth) * W)
    // decode and resize off the main thread: createImageBitmap on the file's bytes (already in the
    // HTTP cache) runs on a worker thread, whereas uploading the <img> converts it right here
    const bitmap = await fetch(img.currentSrc || img.src)
      .then((r) => r.blob())
      .then((blob) =>
        createImageBitmap(blob, { resizeWidth: W, resizeHeight: h, resizeQuality: 'high', premultiplyAlpha: 'none' }),
      )
      .catch(() => null)
    if (!bitmap) return null
    // a real pause, not one forced into the middle of a scroll
    await new Promise<void>((r) => whenIdle(r, 3000))
    canvas.width = W
    canvas.height = h
    // premultiplied all the way through: the default, and the one every browser composites the same
    const gl = canvas.getContext('webgl', { antialias: false, depth: false })
    if (!gl) return bitmap.close(), null
    const shader = (type: number, src: string) => {
      const sh = gl.createShader(type)!
      gl.shaderSource(sh, src)
      gl.compileShader(sh)
      return sh
    }
    const prog = gl.createProgram()!
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, VERT))
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, FRAG))
    gl.linkProgram(prog)
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return bitmap.close(), null
    gl.useProgram(prog)
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
    const loc = gl.getAttribLocation(prog, 'p')
    gl.enableVertexAttribArray(loc)
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)
    gl.bindTexture(gl.TEXTURE_2D, gl.createTexture())
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, bitmap)
    bitmap.close()
    gl.uniform2f(gl.getUniformLocation(prog, 'size'), W, h)
    const t = gl.getUniformLocation(prog, 't')
    gl.viewport(0, 0, W, h)
    gl.clearColor(0, 0, 0, 0)
    const draw = (v: number) => {
      gl.clear(gl.COLOR_BUFFER_BIT)
      gl.uniform1f(t, v)
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
    }
    const dispose = () => {
      gl.getExtension('WEBGL_lose_context')?.loseContext()
      canvas.width = canvas.height = 0
    }
    // the check in an idle moment of its own, apart from the upload
    await new Promise<void>((r) => whenIdle(r, 3000))
    if (gl.isContextLost()) return null
    // check the result before trusting it: fully revealed, the image's transparent corner must
    // stay transparent and its middle must not; anything else means a fade instead
    // (one read of the whole frame: each read waits for the GPU)
    draw(2)
    const px = new Uint8Array(W * h * 4)
    gl.readPixels(0, 0, W, h, gl.RGBA, gl.UNSIGNED_BYTE, px)
    const alpha = (x: number, y: number) => px[(Math.round((h - 1) * y) * W + Math.round((W - 1) * x)) * 4 + 3]
    const corner = alpha(0, 1)
    const ink = Math.max(...[[0.5, 0.5], [0.4, 0.45], [0.6, 0.55], [0.5, 0.35]].map(([x, y]) => alpha(x, y)))
    if (corner !== 0 || ink === 0) return dispose(), null
    draw(-1)
    return { draw, dispose }
  }

  const develop = async (box: HTMLElement, plan: Promise<Plan>) => {
    const img = box.querySelector<HTMLImageElement>('img')!
    const canvas = box.querySelector<HTMLCanvasElement>('canvas')!
    const p = await plan
    if (!p) return gsap.to(img, { opacity: 1, duration: 1.8, ease: 'power1.inOut' })
    img.style.opacity = '0'
    canvas.style.opacity = '1'
    const state = { t: 0 }
    gsap.to(state, {
      t: 1,
      duration: 1.8,
      ease: 'power1.inOut',
      onUpdate: () => p.draw(state.t),
      onComplete: () => {
        img.style.opacity = '1'
        canvas.style.opacity = '0'
        p.dispose()
      },
    })
  }

  /**
   * The lens: under the cursor the watermark gives way to the inked lily,
   * inside a hard-edged circle with a hairline ring. The lens lives in screen
   * coordinates and is redrawn every frame while open, so it stays under a
   * still cursor while the page (and the lily's slower parallax) scrolls past.
   */
  const lens = (root: HTMLElement) => {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return
    const clip = root.querySelector<HTMLElement>('.writings__clip')!
    const ink = root.querySelector<HTMLElement>('.writings__ink')!
    const ring = root.querySelector<HTMLElement>('.writings__ring')!
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
    const state = { x: 0, y: 0, r: 0 }
    let pointer: { x: number; y: number } | null = null
    let open = false
    const radius = () => (clip.getBoundingClientRect().width / 1920) * 170

    const paint = () => {
      const ib = ink.getBoundingClientRect()
      const cb = clip.getBoundingClientRect()
      ink.style.clipPath = `circle(${state.r}px at ${state.x - ib.left}px ${state.y - ib.top}px)`
      ring.style.transform = `translate(${state.x - cb.left}px, ${state.y - cb.top}px)`
      ring.style.width = ring.style.height = `${state.r * 2}px`
      ring.style.opacity = state.r > 1 ? '1' : '0'
    }
    const setOpen = (over: boolean) => {
      if (over === open) return
      open = over
      gsap.to(state, {
        r: over ? radius() : 0,
        duration: calm ? 0 : over ? 0.55 : 0.35,
        ease: over ? 'power3.out' : 'power2.in',
        overwrite: 'auto',
      })
    }
    const isOver = (x: number, y: number) => {
      const ib = ink.getBoundingClientRect()
      const cb = clip.getBoundingClientRect()
      return x > ib.left && x < ib.right && y > ib.top && y < ib.bottom && y > cb.top && y < cb.bottom
    }

    root.addEventListener('pointermove', (e) => {
      pointer = { x: e.clientX, y: e.clientY }
      if (!open) {
        state.x = pointer.x
        state.y = pointer.y
      }
      setOpen(isOver(pointer.x, pointer.y))
      if (calm) {
        state.x = pointer.x
        state.y = pointer.y
      } else gsap.to(state, { x: pointer.x, y: pointer.y, duration: 0.35, ease: 'power3.out', overwrite: 'auto' })
    })
    root.addEventListener('pointerleave', () => {
      pointer = null
      setOpen(false)
    })
    // redraw each frame while the lens is showing; the lily may have scrolled out from under the cursor
    let drawnR = -1
    const tick = () => {
      if (!open && state.r <= 0 && drawnR === 0) return
      if (pointer) setOpen(isOver(pointer.x, pointer.y))
      paint()
      drawnR = state.r
    }
    gsap.ticker.add(tick)
    document.addEventListener('astro:before-swap', () => gsap.ticker.remove(tick), { once: true })
    paint()
  }

  /**
   * ScrollTrigger housekeeping for the home page, its only user: follow Lenis
   * frame by frame, re-measure once fonts and images are in, clean up on leaving.
   */
  const syncScrollTrigger = () => {
    const hook = () => (window as any).__lenis?.on('scroll', ScrollTrigger.update)
    ;(window as any).__lenis ? hook() : document.addEventListener('lunalgia:lenis', hook, { once: true })
    gsap.ticker.lagSmoothing(0)
    document.fonts?.ready.then(() => ScrollTrigger.refresh())
    if (document.readyState !== 'complete') addEventListener('load', () => ScrollTrigger.refresh(), { once: true })
    document.addEventListener(
      'astro:before-swap',
      () => {
        ;(window as any).__lenis?.off?.('scroll', ScrollTrigger.update)
        ScrollTrigger.getAll().forEach((t) => t.kill())
      },
      { once: true },
    )
  }

  const init = () => {
    const root = document.querySelector<HTMLElement>('.writings')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    syncScrollTrigger()

    // hovering a kind opens it; leaving the garden keeps the last one open
    const rows = [...root.querySelectorAll<HTMLElement>('.garden__row')]
    rows.forEach((row) =>
      row.addEventListener('mouseenter', () => rows.forEach((r) => r.classList.toggle('is-open', r === row))),
    )
    root.querySelector('.garden__rows')?.addEventListener('focusin', (e) => {
      const row = (e.target as Element).closest<HTMLElement>('.garden__row')
      if (row) rows.forEach((r) => r.classList.toggle('is-open', r === row))
    })

    lens(root)

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const title = root.querySelectorAll('.writings__title text')
    const lily = root.querySelector<HTMLElement>('.writings__lily')!
    const wm = root.querySelector<HTMLElement>('.writings__wm')!
    const rules = root.querySelectorAll('.writings__rule')
    gsap.set(rules, { scaleX: 0 })
    gsap.set(title, { opacity: 0, y: 40 })
    gsap.set(wm.querySelector('img'), { opacity: 0 })
    const plan = prepare(wm)
    gsap.set('.garden__meta, .garden__row, .writings__all, .writings__count', { opacity: 0, y: 18 })

    ScrollTrigger.create({
      trigger: root,
      start: 'top 70%',
      once: true,
      onEnter: () => {
        const tl = gsap.timeline()
        tl.to(rules, { scaleX: 1, duration: 1.4, ease: 'power3.inOut' }, 0)
        tl.to(title, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out', stagger: 0.05 }, 0.25)
        tl.call(() => develop(wm, plan), [], 0.5)
        tl.to(
          '.garden__meta, .garden__row, .writings__all, .writings__count',
          { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 },
          0.6,
        )
      },
    })

    // the lily drifts a touch slower than the page
    gsap.fromTo(
      lily,
      { yPercent: 6 },
      { yPercent: -6, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } },
    )
  }

  document.addEventListener('astro:page-load', init)
</script>

<style>
  .writings {
    z-index: 1;
    color: var(--mist);
  }

  /* the panel's top and bottom rules draw across from the left (a transform,
     so the browser only recomposites them instead of restyling the panel) */
  .writings__panel {
    border-block-color: transparent;
  }
  .writings__rule {
    position: absolute;
    top: -1.89px;
    left: 0;
    width: 100%;
    height: 1.89px;
    background: var(--ultramarine);
    transform-origin: 0 50%;
  }
  .writings__rule--end {
    top: auto;
    bottom: -1.89px;
  }

  .writings__title {
    margin: 0;
    font-weight: 400;
  }
  .writings__title svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .writings__title text {
    font-family: var(--font-din);
    font-size: 144px;
    fill: var(--lavender);
  }

  .writings__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .writings__lily {
    position: absolute;
    left: 45%;
    top: 22%;
    width: 120%;
    /* its own layer: the parallax moves it every scrolled frame, and without
       one the browser repaints both large lily images each time */
    will-change: transform;
  }
  .writings__wm {
    position: relative;
    opacity: 0.16;
  }
  .writings__lily :global(img),
  .writings__wm canvas {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }
  .writings__wm canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .writings__lily :global(.writings__ink) {
    position: absolute;
    inset: 0;
    clip-path: circle(0 at 50% 50%);
  }
  .writings__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    translate: -50% -50%;
    border: 1px solid rgb(210 211 221 / 0.7);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .garden__meta {
    color: var(--lavender);
  }
  .garden__rows {
    border-bottom: 1px solid rgb(160 149 201 / 0.35);
  }
  .garden__row {
    border-top: 1px solid rgb(160 149 201 / 0.35);
  }
  .garden__head {
    display: grid;
    grid-template-columns: 4.2em 1fr;
    align-items: baseline;
    padding-block: 1.1rem 1.2rem;
    text-decoration: none;
    color: inherit;
  }
  .garden__n {
    font-family: var(--font-mori);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--lavender);
  }
  .garden__kind {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    transition:
      color 0.5s var(--ease-out),
      opacity 0.5s var(--ease-out);
  }
  .garden__blurb {
    grid-column: 2;
    margin-top: 0.4rem;
    font-family: var(--font-mori);
    font-size: 0.95rem;
    color: rgb(210 211 221 / 0.45);
    transition: color 0.5s var(--ease-out);
  }
  .garden__row.is-open .garden__kind {
    font-style: italic;
    color: #fff;
  }
  .garden__rows:has(.is-open) .garden__row:not(.is-open) .garden__kind {
    color: rgb(210 211 221 / 0.4);
  }
  .garden__rows:has(.is-open) .garden__row:not(.is-open) .garden__blurb {
    color: rgb(210 211 221 / 0.25);
  }

  /* the drawer opens with grid-template-rows 0fr → 1fr */
  .garden__drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease-out);
  }
  .garden__row.is-open .garden__drawer {
    grid-template-rows: 1fr;
  }
  .garden__entries {
    overflow: hidden;
    padding-left: 4.2em;
    font-size: inherit;
  }
  .garden__entries li {
    padding-bottom: 0.6rem;
  }
  .garden__entries li:last-child {
    padding-bottom: 1.4rem;
  }
  .garden__entries a,
  .garden__ghost {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
    text-decoration: none;
    color: var(--mist);
  }
  .garden__entry {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .garden__entries a:hover .garden__entry {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .garden__date {
    font-family: var(--font-mori);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--lavender);
  }
  .garden__ghost {
    color: rgb(210 211 221 / 0.35);
  }

  .writings__all {
    font: 400 0.72rem/1.4 var(--font-din); letter-spacing: 0.16em; text-transform: uppercase; font-style: normal;
    color: var(--lavender);
    text-decoration: none;
  }
  .writings__all span {
    display: inline-block;
    width: 2.3rem;
    height: 1px;
    margin-left: 0.6rem;
    vertical-align: middle;
    background: currentColor;
    transition: width 0.5s var(--ease-out);
  }
  .writings__all:hover span {
    width: 3.6rem;
  }
  .writings__count {
    color: var(--lavender);
  }

  /* ---------- phones: a plain column inside the panel ---------- */
  @media (max-aspect-ratio: 4/3) {
    .writings {
      padding: 3.5rem 1.25rem 3.5rem;
    }
    .writings__panel {
      inset: 1.25rem 0;
      height: auto;
    }
    .writings > :not(.panel) {
      position: relative;
    }
    .writings__title {
      width: 72%;
      margin: 0.5rem 0 1.5rem;
    }
    .garden__meta {
      margin-bottom: 1rem;
    }
    .writings__all {
      display: inline-block;
      margin-top: 2rem;
    }
    .writings__count {
      margin-top: 0.75rem;
    }
    .garden__drawer {
      grid-template-rows: 1fr;
    }
  }

  /* ---------- wide: the board, placed in board units ---------- */
  @media (min-aspect-ratio: 4/3) {
    .writings {
      aspect-ratio: 16 / 9;
    }
    .writings > :not(.panel) {
      position: absolute;
    }
    .writings__title {
      left: 0;
      top: 0;
      width: calc(760 * var(--u));
    }
    .writings__lily {
