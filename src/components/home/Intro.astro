---
/**
 * Board 4: Lilian's two paragraphs, set as a short letter after henry.codes'
 * "letter from the editor": centred EB Garamond inside an inset frame, with a
 * DINdong label on the top edge and the same label upside down on the bottom.
 * Lines rise into place, one after another, as the panel comes into view.
 */
const label = "A FEW WORDS, BEFORE YOU WANDER";
---

<section class="letter board" aria-labelledby="letter-label">
    <div class="panel"></div>
    <!-- the hero's frame, redrawn: a rectangle starting at the top centre, under the label -->
    <svg class="letter__frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M50 0H100V100H0V0Z" pathLength="1000" vector-effect="non-scaling-stroke" />
    </svg>
    <p id="letter-label" class="letter__label">
        {label}
    </p>
    <div class="letter__body">
        <p>
            <span class="ln">
                I love literature, music, art, humanities, math and physics.
            </span>
            <span class="ln">In life I subscribe to <span data-annotate="underline" data-delay="1.2">rationalism</span>,</span>
            <span class="ln">
                but also to people and nature{" "}
                <em data-annotate="wavy" data-delay="1.6">and the wonders of the soul.</em>
            </span>
        </p>
        <p>
            <span class="ln">During the day, I try not to get swallowed</span>
            <span class="ln">
                by the mess of contradictions that are my beliefs,
            </span>
            <span class="ln">but when I do, I try to <span data-annotate="circle" data-delay="2">write</span> about them.</span>
        </p>
        <p>
            <span class="ln">
                Here you will find a few of them, alongside design,
            </span>
            <span class="ln">my work, what I study, and what I consume.</span>
        </p>
        <p>
            <span class="ln">
                <em>I hope you enjoy your stay here.</em>
            </span>
        </p>
    </div>
    <p class="letter__label letter__label--flip" aria-hidden="true">
        {label}
    </p>
</section>

<script>
    /**
     * The reveal: the inner frame opens from the centre, the labels settle, then
     * the letter's lines rise into place one after another. Only transform and
     * opacity move, so it runs on the compositor (the old version split the text
     * with SplitText and animated a clip-path, which stuttered). The lines are the
     * hand-set ones (.ln) on wide screens and the paragraphs on narrow ones.
     * Armed by JS only, so without it, or with reduced motion, all is in place.
     */
    import { afterIntro } from "@/scripts/after-intro";

    const init = () => {
        const root = document.querySelector<HTMLElement>(".letter");
        if (!root || root.dataset.ready) return;
        root.dataset.ready = "1";
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        // the outline in real pixels, so its dashes measure true: the drawing grows
        // from the top centre both ways, like the hero's frame
        const svg = root.querySelector<SVGSVGElement>(".letter__frame");
        const path = svg?.querySelector("path");
        if (svg && path) {
            path.removeAttribute("pathLength");
            const fit = () => {
                const { width: w, height: h } = svg.getBoundingClientRect();
                if (!w || !h) return;
                svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
                path.setAttribute("d", `M${w / 2} 0H${w}V${h}H0V0Z`);
                svg.style.setProperty("--L", `${2 * (w + h)}px`);
            };
            fit();
            const ro = new ResizeObserver(fit);
            ro.observe(svg);
            document.addEventListener("astro:before-swap", () => ro.disconnect(), { once: true });
        }

        const wide = matchMedia("(min-width: 900px)").matches;
        const units = [...root.querySelectorAll<HTMLElement>(wide ? ".ln" : ".letter__body p")];
        units.forEach((el, i) => el.style.setProperty("--i", String(i)));
        root.classList.add("is-armed", wide ? "by-line" : "by-para");

        const io = new IntersectionObserver(
            (entries) => {
                if (!entries.some((e) => e.isIntersecting)) return;
                io.disconnect();
                // never while the hero is still drawing
                afterIntro().then(() => root.classList.add("is-in"));
            },
            { rootMargin: "0px 0px -38% 0px" },
        );
        io.observe(root);
        document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
    };

    document.addEventListener("astro:page-load", init);
</script>

<style>
    /* the hand-drawn marks (src/scripts/annotate.ts), pale against the dark panel */
    .letter__body [data-annotate] {
        --ann: var(--mist);
    }
    .letter {
        /* the hero's drawing units: 1920 wide on wide screens, 760 on tall ones */
        --hu: calc(100vw / 760);
        --fx: calc(24 * var(--hu));
        --fy: calc(44 * var(--hu));
        --fw: calc(2.6 * var(--hu));
        color: var(--mist);
        text-align: center;
        padding: calc(var(--fy) + 4rem) calc(var(--fx) + 1.5rem);
    }
    /* the base colour spans the whole board */
    .letter .panel {
        inset: 0;
        height: auto;
    }
    /* only the outline takes the hero frame's place and weight */
    .letter__frame {
        position: absolute;
        inset: var(--fy) var(--fx);
        width: calc(100% - 2 * var(--fx));
        height: calc(100% - 2 * var(--fy));
        overflow: visible;
        pointer-events: none;
    }
    .letter__frame path {
        fill: none;
        stroke: rgb(210 211 221 / 0.55);
        stroke-width: var(--fw);
        stroke-linejoin: miter;
    }

    /* the reveal (see the script): the outline grows both ways from the label,
       as the hero's does, then the label, then the lines one after another */
    .letter.is-armed .letter__frame path {
        stroke-dasharray: 0 var(--L) 0 0;
    }
    .letter.is-armed .letter__label {
        opacity: 0;
    }
    .letter.by-line .ln,
    .letter.by-para .letter__body p {
        display: block;
    }
    .letter.is-armed.by-line .ln,
    .letter.is-armed.by-para .letter__body p {
        opacity: 0;
        transform: translateY(0.5em);
        filter: blur(3px);
    }
    .letter.is-in .letter__frame path {
        stroke-dasharray: calc(var(--L) / 2) 0 calc(var(--L) / 2) 0;
        transition: stroke-dasharray 1.6s cubic-bezier(0.65, 0, 0.35, 1);
    }
    .letter.is-in .letter__label {
        opacity: 1;
        transition: opacity 0.8s var(--ease-out) 0.15s;
    }
    .letter.is-in.by-line .ln,
    .letter.is-in.by-para .letter__body p {
        opacity: 1;
        transform: none;
        filter: none;
        transition:
            opacity 0.9s var(--ease-out),
            transform 1.1s var(--ease-out),
            filter 0.9s var(--ease-out);
        transition-delay: calc(0.6s + var(--i) * 90ms);
    }
    .letter__label {
        position: absolute;
        left: 50%;
        top: var(--fy);
        translate: -50% -50%;
        margin: 0;
        padding: 0 1rem;
        background: var(--lavender-deep);
        font-family: var(--font-din);
        font-size: 0.7rem;
        line-height: 1.6;
        letter-spacing: 0.18em;
        white-space: nowrap;
    }
    .letter__label--flip {
        top: auto;
        bottom: var(--fy);
        translate: -50% 50%;
        rotate: 180deg;
    }
    .letter__body {
        position: relative;
        font-family: var(--font-body);
        font-size: clamp(1.2rem, 4.6vw, 1.6rem);
        line-height: 1.45;
        text-wrap: balance;
    }
    .letter__body p + p {
        margin-top: 1.2em;
    }
    /* the hand-set line breaks only make sense on wide screens */
    .ln + .ln::before {
        content: " ";
    }
    @media (min-width: 900px) {
        .ln {
            display: block;
        }
        .ln + .ln::before {
            content: none;
        }
    }

    @media (min-aspect-ratio: 4/3) {
        .letter {
            aspect-ratio: 16 / 9;
            padding: 0;
        }
        /* exactly the hero's frame: x 44.546, y 51.983, 1830.143 × 983.8 of
           1920 × 1080, drawn 1.93 units thick */
        .letter__frame {
            inset: calc(51.983 * var(--u)) auto auto calc(44.546 * var(--u));
            width: calc(1830.143 * var(--u));
            height: calc(983.8 * var(--u));
        }
        .letter__frame path {
            stroke-width: calc(1.93 * var(--u));
        }
        .letter__label {
            top: calc(51.983 * var(--u));
            font-size: max(0.62rem, calc(15 * var(--u)));
        }
        .letter__label--flip {
            top: calc((51.983 + 983.8) * var(--u));
            bottom: auto;
            translate: -50% -50%;
        }
        .letter__body {
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            translate: 0 -50%;
            font-size: calc(34 * var(--u));
            line-height: 1.42;
        }
        .letter__body p + p {
            margin-top: calc(44 * var(--u));
        }
    }
</style>
