---
/**
 * A few covers, framed like A24's "In theaters": a big title held on the left,
 * covers in columns split by hairlines, each captioned with its collection
 * number. Clicking one opens its entry as a row under its line.
 */
import Entry from './Entry.astro'
import { pad, type AnnexItem } from '@/lib/annex'
interface Props {
  title: string
  items: AnnexItem[]
  /** the collection number of each item, by id */
  numbers: Map<string, number>
  /** what `size` counts: 'min' for films, 'pages' for books */
  unit: string
}
const { title, items, numbers, unit } = Astro.props
const no = (f: AnnexItem) => `NO. ${pad(numbers.get(f.id) ?? 0, 3)}`
---

<div class="fg">
  <h3 class="fg__h">{title}</h3>
  <ol class="fg__grid">
    {
      items.map((f, i) => (
        <li class="fg__it">
          <button class="fg__btn" type="button" aria-expanded="false" aria-label={`${f.title}: open`} data-i={i}>
            {f.thumb ? (
              <img class="fg__img" src={f.thumb} alt="" loading="lazy" />
            ) : (
              <span class="fg__img fg__img--type" style={`--c:${f.color};--f:${f.ink}`}>{f.title}</span>
            )}
            <span class="fg__cap">
              <span class="fg__no">{no(f)}</span>
              <span class="fg__t">{f.short ?? f.title}</span>
              <span class="fg__by">{f.by}</span>
              <span class="fg__sc">{f.year}</span>
            </span>
          </button>
        </li>
      ))
    }
    <li class="fg__open" hidden>
      {items.map((f, i) => <Entry item={f} i={i} hidden kicker={[no(f), f.size && `${f.size} ${unit}`].filter(Boolean).join(' · ')} />)}
    </li>
  </ol>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.fg')) {
    const items = [...root.querySelectorAll<HTMLElement>('.fg__it')]
    const btns = items.map((li) => li.querySelector<HTMLButtonElement>('.fg__btn')!)
    const open = root.querySelector<HTMLElement>('.fg__open')!
    const entries = [...open.querySelectorAll<HTMLElement>('.en')]
    let cur = -1
    /** the open row goes after the last poster on the clicked poster's line */
    const place = () => {
      open.hidden = true
      if (cur < 0) return
      const top = items[cur].offsetTop
      let last = cur
      while (last + 1 < items.length && items[last + 1].offsetTop === top) last++
      items[last].after(open)
      open.hidden = false
    }
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        cur = cur === i ? -1 : i
        btns.forEach((x, j) => x.setAttribute('aria-expanded', String(j === cur)))
        entries.forEach((e, j) => (e.hidden = j !== cur))
        place()
      }),
    )
    addEventListener('resize', place)
  }
</script>

<style>
  .fg {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 3.2fr);
    gap: 0;
    border-bottom: 1px solid var(--rule);
  }
  .fg__h {
    position: sticky;
    /* under the site header and the section bar */
    top: 6.5rem;
    align-self: start;
    margin: 0;
    padding: 1.6rem 1.6rem 0 0;
    font: 400 clamp(2.6rem, 4.6vw, 5.4rem) / 0.95 var(--font-din);
    color: var(--ultramarine);
  }
  .fg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  /* hairlines between the columns, as on A24 */
  .fg__it {
    padding: 1.6rem 1.4rem 2.2rem;
    border-left: 1px solid var(--rule);
  }
  .fg__btn {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
    color: var(--ultramarine);
  }
  .fg__img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }
  .fg__img--type {
    display: flex;
    align-items: flex-end;
    padding: 0.8rem;
    box-sizing: border-box;
    background: var(--c);
    color: var(--f);
    font: italic 1.4rem/1 var(--font-display);
  }
  .fg__cap {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 0.6rem;
    margin-top: 0.9rem;
  }
  .fg__no {
    grid-column: 1 / -1;
    font: 400 0.56rem/1.3 var(--font-din);
    letter-spacing: 0.18em;
    color: var(--ink-soft);
  }
  .fg__t {
    grid-column: 1 / -1;
    font: italic 400 1.4rem/1.05 var(--font-display);
    text-decoration: underline transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition: text-decoration-color 0.2s;
  }
  .fg__btn:hover .fg__t,
  .fg__btn:focus-visible .fg__t,
  .fg__btn[aria-expanded='true'] .fg__t {
    text-decoration-color: currentColor;
  }
  .fg__by,
  .fg__sc {
    font: 400 0.58rem/1.3 var(--font-din);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .fg__open {
    grid-column: 1 / -1;
    padding: 2.4rem 1.4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .fg__open[hidden] {
    display: none;
  }
  @media (max-width: 860px) {
    .fg {
      grid-template-columns: 1fr;
    }
    .fg__h {
      position: static;
      padding: 1.6rem 0;
    }
    .fg__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fg__it {
      padding: 1rem 0.8rem 1.6rem;
    }
  }
</style>
