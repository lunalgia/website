---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { SITE } from '@/consts'
import Chrome from '@/components/Chrome.astro'
import Footer from '@/components/Footer.astro'
import Rail from '@/components/Rail.astro'
// the faces every page draws in its first screen: the nav (DIN, Louise) and titles
import dinUrl from '@/assets/fonts/DINdong.woff2?url'
import louiseUrl from '@/assets/fonts/Louise-Regular.woff2?url'
import instrumentUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url'

interface Props {
  title?: string
  description?: string
  image?: string
  /** Hide the floating "home" mark (the home page has its own). */
  home?: boolean
  footer?: boolean
  /** Picture shown when another page's link to this one is hovered (see src/scripts/previews.ts). */
  preview?: ImageMetadata
}

const { title, description = SITE.description, image = '/og.jpg', home = false, footer = true, preview } = Astro.props
const here = Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home'
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.author} · ${SITE.title}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const previewSrc = preview && (await getImage({ src: preview, width: 480, format: 'webp' })).src
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="me" href={SITE.github} />
    <meta name="theme-color" content="#a297cb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og.jpg' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {title && <meta name="preview:title" content={title} />}
    {previewSrc && <meta name="preview:image" content={previewSrc} />}

    {[dinUrl, louiseUrl, instrumentUrl].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Chrome home={home} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer here={here} />}
    <Rail />
    <script>
      import '@/scripts/smooth'
      import '@/scripts/previews'
      import '@/scripts/annotate'
    </script>
  </body>
</html>
